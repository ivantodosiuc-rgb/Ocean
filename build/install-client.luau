ck=T.Teal})[item.id]\n   local stage=C.frame(card,'IconStage',UDim2.fromOffset(62,62),UDim2.fromOffset(10,10),accent:Lerp(T.White,.7));C.corner(stage,16)\n   C.viewport(stage,'Icons',item.icon,UDim2.fromScale(1,1))\n   C.label(card,item.name,UDim2.new(1,-93,0,27),UDim2.fromOffset(82,12),20,T.Ink,T.Font)\n   C.label(card,'LEVEL '..level..' / '..item.max,UDim2.new(1,-93,0,22),UDim2.fromOffset(83,40),12,T.Muted,T.Bold)\n   local track=C.frame(card,'Progress',UDim2.new(1,-96,0,7),UDim2.fromOffset(82,67),accent:Lerp(T.White,.76));C.corner(track,4)\n   local fill=C.frame(track,'Fill',UDim2.fromScale(level/item.max,1),nil,accent);C.corner(fill,4)\n   local current,nextValue\n   if item.id=='Backpack' then current=s.capacity;nextValue=Config.Capacities[math.min(level+2,#Config.Capacities)]\n   elseif item.id=='Walk' then current=s.stats.walk;nextValue=Config.WalkSpeeds[math.min(level+2,#Config.WalkSpeeds)]\n   elseif item.id=='Power' then current=string.format('%.1fx',1+level*.2);nextValue=string.format('%.1fx',1+math.min(level+1,item.max)*.2)\n   else current=string.format('%.1fx',1+level*.1);nextValue=string.format('%.1fx',1+math.min(level+1,item.max)*.1) end\n   local values=C.frame(card,'Comparison',UDim2.new(1,-26,0,37),UDim2.fromOffset(13,87),accent:Lerp(T.White,.86));C.corner(values,9)\n   local line=C.label(values,tostring(current)..'   \u2192   '..tostring(nextValue),UDim2.new(1,-16,1,0),UDim2.fromOffset(8,0),23,T.DeepTeal,T.Font);line.TextXAlignment=Enum.TextXAlignment.Center\n   local desc=C.label(card,item.description,UDim2.new(1,-26,0,23),UDim2.fromOffset(13,128),13,T.Muted,T.Body);desc.TextXAlignment=Enum.TextXAlignment.Center\n   local _,button=C.button(card,'Upgrade',if price then 'UPGRADE  \u00b7  '..C.number(price) else 'MAX LEVEL',UDim2.new(1,-26,0,44),UDim2.fromOffset(13,156),if price then accent else T.Aqua,function() if price then self.callbacks.action('Upgrade',item.id) end end);button.TextSize=16;button.Active=price~=nil;button.Selectable=price~=nil\n  end\n else\n  for i,item in Config.Loot do\n   local count=s.bag[item.id] or 0\n   if count==0 then continue end\n   local card=self:card(item.id,i)\n   C.viewport(card,'Loot',item.id,UDim2.fromOffset(66,70),UDim2.fromOffset(3,7))\n   C.label(card,item.name,UDim2.new(1,-92,0,25),UDim2.fromOffset(76,11),17,T.Ink,T.Font)\n   C.label(card,string.format('%d found  \u00b7  %d each',count,item.value),UDim2.new(1,-92,0,22),UDim2.fromOffset(76,35),12,T.Muted,T.Body)\n   C.label(card,C.number(count*item.value)..' Coins',UDim2.new(1,-92,0,24),UDim2.fromOffset(76,55),17,T.DeepTeal,T.Bold)\n   if count==0 then card.BackgroundColor3=Color3.fromRGB(247,241,222) end\n  end\n  if s.count==0 then\n   local card=self:card('EmptyBackpack',1)\n   C.viewport(card,'Icons','Backpack',UDim2.fromOffset(66,70),UDim2.fromOffset(3,7))\n   C.label(card,'Your next discovery awaits',UDim2.new(1,-90,0,27),UDim2.fromOffset(76,12),16,T.Ink,T.Font)\n   local hint=C.label(card,'Uncover the seabed to find treasure.',UDim2.new(1,-90,0,38),UDim2.fromOffset(76,39),13,T.Muted,T.Body);hint.TextWrapped=true\n  end\n  self.sellTotal.Text='TOTAL  '..C.number(s.value)\n  self.sellButton.Text='SELL ALL'\n end\n self:resize();self.scroll.CanvasPosition=scrollPosition\nend\nfunction UI:sale(amount)\n self:toastMessage('Treasure sold!  +'..C.number(amount)..' Coins','success')\n local target=self.coins.AbsolutePosition+Vector2.new(28,30)-self.root.AbsolutePosition\n local origin=self.root.AbsoluteSize*Vector2.new(.65,.75)\n for i=1,9 do task.delay(i*.045,function()\n  local icon=C.viewport(self.root,'Icons','Coin',UDim2.fromOffset(37,37),UDim2.fromOffset(origin.X,origin.Y));icon.ZIndex=30\n  local outward=origin+Vector2.new(math.cos(i*2.4)*60,math.sin(i*2.4)*45-35)\n  C.tween(icon,.16,{Position=UDim2.fromOffset(outward.X,outward.Y)},Enum.EasingStyle.Back);task.wait(.17)\n  C.tween(icon,.5,{Position=UDim2.fromOffset(target.X-18,target.Y-18),Size=UDim2.fromOffset(24,24)},Enum.EasingStyle.Quart,Enum.EasingDirection.In);task.wait(.5);icon:Destroy()\n  self.coinScale.Scale=1.055;C.tween(self.coinScale,.16,{Scale=1})\n end) end\nend\nfunction UI:prompt(prompt,inputType)\n -- Keep a prompt that appeared while a menu was open, so it can reappear on close.\n local gui=C.new('BillboardGui',{Name='SeaPrompt',Adornee=prompt.Parent,Size=UDim2.fromOffset(214,62),StudsOffsetWorldSpace=Vector3.new(0,2.1,0),AlwaysOnTop=true,MaxDistance=35,Active=true,Enabled=self.shop==nil},Players.LocalPlayer.PlayerGui)\n local p=C.panel(gui,'Prompt',UDim2.new(1,-6,1,-6),UDim2.fromOffset(3,3),T.Cream,15)\n local key=if inputType==Enum.ProximityPromptInputType.Touch then 'TAP' elseif inputType==Enum.ProximityPromptInputType.Gamepad then 'X' else 'E'\n local button=C.new('TextButton',{Name='Interact',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text='',AutoButtonColor=false},p)\n local k=C.panel(button,'Key',UDim2.fromOffset(42,40),UDim2.fromOffset(8,8),T.Teal,10);local label=C.label(k,key,UDim2.fromScale(1,1),nil,17,T.Ink,T.Font);label.TextXAlignment=Enum.TextXAlignment.Center\n C.label(button,prompt.ObjectText,UDim2.new(1,-63,0,24),UDim2.fromOffset(59,6),17,T.Ink,T.Font)\n C.label(button,prompt.ActionText,UDim2.new(1,-63,0,20),UDim2.fromOffset(59,30),12,T.Muted,T.Body)\n button.Activated:Connect(function() if gui.Enabled and prompt.Enabled and prompt.Parent then prompt:InputHoldBegin();task.delay(prompt.HoldDuration+.05,function() if prompt.Parent then prompt:InputHoldEnd() end end) end end)\n local scale=C.new('UIScale',{Scale=.8},p);C.tween(scale,.25,{Scale=1},Enum.EasingStyle.Back)\n return gui\nend\nreturn UI\n"},{"name":"UISkin","class":"ModuleScript","source":"--!strict\n-- Original Blender renders. Slice borders stay fixed on every device.\nreturn table.freeze({\n Wood='rbxassetid://95151666601628',Sand='rbxassetid://104295366750648',Button='rbxassetid://109715703027235',\n WoodSlice=Rect.new(72,72,440,440),Slice=Rect.new(64,64,448,448),\n})\n"},{"name":"WorldPolish","class":"ModuleScript","source":"--!nonstrict\n-- Cosmetic only: follows the confirmed server WaterLevel, never writes ocean progress.\nlocal RunService=game:GetService('RunService')\nlocal TweenService=game:GetService('TweenService')\nlocal Players=game:GetService('Players')\nlocal CollectionService=game:GetService('CollectionService')\nlocal Contours=require(script.Parent.ShoreContours)\nlocal WorldPolish={};WorldPolish.__index=WorldPolish\nlocal function smooth(t) t=math.clamp(t,0,1);return t*t*(3-2*t) end\nfunction WorldPolish.new()\n local self=setmetatable({connections={},wetProps={},lastLevel=math.huge,pending=nil,busy=false,disposed=false},WorldPolish)\n self.ocean=workspace:WaitForChild('Ocean');local rig=self.ocean:WaitForChild('WetShoreRig',20);self.ribbon=rig and rig:FindFirstChild('WetShore',true)\n self.params=RaycastParams.new();self.params.FilterType=Enum.RaycastFilterType.Include\n self.params.FilterDescendantsInstances={workspace.StarterIsland:WaitForChild('GoldenShore'),workspace.UnderwaterTerrain:WaitForChild('Seafloor')}\n self.params.IgnoreWater=true;self.params.RespectCanCollide=true\n self.bones={}\n if self.ribbon then\n  for _,bone in self.ribbon:GetDescendants() do if bone:IsA('Bone') and bone.Name~='Root' then\n   local edge,index=bone.Name:match('^(%a+)_(%d+)$')\n   if edge then\n    local p=bone.WorldPosition;table.insert(self.bones,{bone=bone,edge=edge,index=tonumber(index),angle=math.atan2(p.Z,p.X),rest=bone.WorldCFrame})\n   end\n  end end\n  table.sort(self.bones,function(a,b) if a.index==b.index then return a.edge<b.edge end;return a.index<b.index end)\n end\n local function register(p)\n  if not p:IsA('MeshPart') or self.wetProps[p] then return end\n  local appearance=p:FindFirstChildOfClass('SurfaceAppearance')\n  self.wetProps[p]={part=p,appearance=appearance,color=if appearance then appearance.Color else p.Color,y=p:GetAttribute('ShoreBaseY')or p.Position.Y,reflectance=p.Reflectance,wet=0,wasSubmerged=nil,dryAt=nil}\n end\n for _,p in CollectionService:GetTagged('SeaWettable') do register(p) end\n table.insert(self.connections,CollectionService:GetInstanceAddedSignal('SeaWettable'):Connect(register))\n table.insert(self.connections,CollectionService:GetInstanceRemovedSignal('SeaWettable'):Connect(function(p) self.wetProps[p]=nil end))\n local clock=0\n table.insert(self.connections,RunService.Heartbeat:Connect(function(dt) clock+=dt;if clock<1 then return end;clock=0;self:updateWetness() end))\n local function changed()\n  local level=self.ocean:GetAttribute('WaterLevel') or 0\n  if math.abs(level-self.lastLevel)<.025 then return end\n  self.pending=level\n  if not self.busy then task.spawn(function() self:drainQueue() end) end\n end\n table.insert(self.connections,self.ocean:GetAttributeChangedSignal('WaterLevel'):Connect(changed));changed()\n return self\nend\nfunction WorldPolish:height(radius,angle)\n local x,z=math.cos(angle)*radius,math.sin(angle)*radius\n local hit=workspace:Raycast(Vector3.new(x,12,z),Vector3.new(0,-190,0),self.params)\n return if hit then hit.Position.Y else -172\nend\nfunction WorldPolish:contour(entry,level)\n -- Collision decomposition can sit above the visible seabed. These radii were\n -- baked against Blender's rendered triangles, so wet sand follows the art.\n local sample=math.clamp(-level/Contours.step,0,Contours.levels-1)\n local row=math.floor(sample)+1;local nextRow=math.min(row+1,Contours.levels)\n local column=entry.index*2+(if entry.edge=='Inner' then 1 else 2)\n local a=Contours.radius(row,column);local b=Contours.radius(nextRow,column)\n local radius=a+(b-a)*(sample-math.floor(sample))\n local height=level+(if entry.edge=='Inner' then 1.1 else .10)+.075\n return Vector3.new(math.cos(entry.angle)*radius,height,math.sin(entry.angle)*radius)\nend\nfunction WorldPolish:drainQueue()\n if self.busy then return end;self.busy=true\n while self.pending and not self.disposed do\n  local level=self.pending;self.pending=nil;local immediate=self.lastLevel==math.huge\n  local started=os.clock()\n  for i,entry in self.bones do\n   if self.disposed then break end\n   local target=self:contour(entry,level)\n   local transform=CFrame.new(entry.rest:VectorToObjectSpace(target-entry.rest.Position))\n   if immediate then entry.bone.Transform=transform else TweenService:Create(entry.bone,TweenInfo.new(.65,Enum.EasingStyle.Sine),{Transform=transform}):Play() end\n   if i%16==0 then RunService.Heartbeat:Wait() end\n  end\n  self.lastLevel=level\n  if self.ribbon then self.ribbon:SetAttribute('VisualWaterLevel',level);self.ribbon:SetAttribute('ContourUpdateSeconds',os.clock()-started);self.ribbon:SetAttribute('ShoreBoneCount',#self.bones) end\n end\n self.busy=false\nend\nfunction WorldPolish:updateWetness()\n local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart');local level=self.ocean:GetAttribute('WaterLevel')or 0;local now=os.clock();local inspected=0\n for part,entry in self.wetProps do\n  if not part.Parent then self.wetProps[part]=nil;continue end\n  local submerged=level>=entry.y\n  if entry.wasSubmerged==true and not submerged then entry.dryAt=now+28 end\n  entry.wasSubmerged=submerged\n  if not root or (part.Position-root.Position).Magnitude>220 then continue end\n  local wet=if submerged then 1 elseif entry.dryAt then smooth((entry.dryAt-now)/28) else 1-smooth((entry.y-level)/1.7)\n  if math.abs(entry.wet-wet)>.02 then\n   entry.wet=wet;local c=entry.color;local target=entry.appearance or part\n   TweenService:Create(target,TweenInfo.new(.85),{Color=c:Lerp(Color3.new(c.R*.78,c.G*.86,c.B*.88),wet*.65)}):Play()\n   part.Reflectance=entry.reflectance+wet*.035\n  end\n  inspected+=1\n end\n self.ocean:SetAttribute('LocalWetProps',inspected)\nend\nfunction WorldPolish:destroy()\n self.disposed=true;for _,c in self.connections do c:Disconnect() end\nend\nreturn WorldPolish\n"}]]====]);for _,entry in sources do local targetParent=if entry.class=='LocalScript' then game:GetService('StarterPlayer').StarterPlayerScripts else parent;local name=if entry.class=='LocalScript' then 'SeaGameClient' else entry.name;local existing=targetParent:FindFirstChild(name);if existing and existing.ClassName~=entry.class then existing:Destroy();existing=nil end;local object=existing or Instance.new(entry.class);object.Name=name;object.Source=entry.source;object.Parent=targetParent end;print('GAMEPLAY_CODE_INSTALLED',group,#sources)