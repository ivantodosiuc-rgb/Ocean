assert(not game:GetService('RunService'):IsRunning(),'Install in Edit mode only');local function folder(parent,name) local f=parent:FindFirstChild(name);if not f then f=Instance.new('Folder');f.Name=name;f.Parent=parent end;return f end;local package=folder(game:GetService('ReplicatedStorage'),'SeaGame');local remotes=folder(package,'Remotes');for _,name in {'Request','State','World','FX','Suction'} do if not remotes:FindFirstChild(name) then local r=Instance.new(if name=='Request' then 'RemoteFunction' else 'RemoteEvent');r.Name=name;r.Parent=remotes end end;local group="Client";local parent;if group=='Server' then parent=folder(game:GetService('ServerScriptService'),'SeaGame') elseif group=='Tests' then parent=folder(game:GetService('ServerStorage'),'SeaGameTests') else parent=folder(package,group) end;local sources=game:GetService('HttpService'):JSONDecode([====[[{"name":"Bootstrap","class":"LocalScript","source":"local package=game:GetService('ReplicatedStorage'):WaitForChild('SeaGame')\nlocal Controller=require(package.Client.Controller)\nlocal controller=Controller.new()\ncontroller:start()\n"},{"name":"ChestPresentation","class":"ModuleScript","source":"--!nonstrict\nlocal RunService=game:GetService('RunService')\nlocal Players=game:GetService('Players')\nlocal TweenService=game:GetService('TweenService')\nlocal Debris=game:GetService('Debris')\nlocal Config=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Config)\nlocal C=require(script.Parent.Components)\nlocal ChestPresentation={};ChestPresentation.__index=ChestPresentation\nlocal DURATION=1.65\nfunction ChestPresentation.new(folder,sound)\n local self=setmetatable({folder=folder,sound=sound,records={},connections={}},ChestPresentation)\n local points=workspace.UnderwaterTerrain:FindFirstChild('PointsOfInterest')\n local function register(model)\n  if not model:IsA('Model') or not model:GetAttribute('ExpeditionChest') or self.records[model] then return end\n  local lid=model:FindFirstChild('Lid');local base=model:FindFirstChild('Base');local root=model:FindFirstChild('ChestRoot')\n  if not lid or not base or not root then return end\n  local record={model=model,lid=lid,base=base,root=root,hinge=model:GetAttribute('LidHinge'),closed=model:GetAttribute('LidClosedCFrame') or lid.CFrame,baseCF=base.CFrame,rare=(model:GetAttribute('MinimumValue') or 0)>=1000}\n  self.records[model]=record\n  local function start()\n   local at=model:GetAttribute('OpenedAt');if type(at)~='number' or at<=0 or record.at==at then return end\n   record.at=at;record.active=true;record.burst=false\n  end\n  record.connection=model:GetAttributeChangedSignal('OpenedAt'):Connect(start);start()\n end\n if points then\n  for _,model in points:GetDescendants() do register(model) end\n  table.insert(self.connections,points.DescendantAdded:Connect(function(model) if model:IsA('Model') then task.defer(register,model) end end))\n  table.insert(self.connections,points.DescendantRemoving:Connect(function(model) local record=self.records[model];if record then record.connection:Disconnect();self.records[model]=nil end end))\n end\n table.insert(self.connections,RunService.RenderStepped:Connect(function() self:step() end))\n return self\nend\nfunction ChestPresentation:burst(record)\n local pos=record.root.Position+Vector3.new(0,1.2,0)\n local pivot=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')\n if not pivot or (pivot.Position-pos).Magnitude>140 then return end\n local color=if record.rare then Color3.fromRGB(116,235,223) else Color3.fromRGB(255,204,103)\n local anchor=C.new('Part',{Name='ChestRewardLight',Size=Vector3.one*.1,Position=pos,Transparency=1,Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false},self.folder)\n local light=C.new('PointLight',{Color=color,Brightness=0,Range=if record.rare then 12 else 8,Shadows=false},anchor)\n C.tween(light,.16,{Brightness=if record.rare then 2.2 else 1.4})\n task.delay(.28,function() if light.Parent then C.tween(light,1,{Brightness=0}) end end)\n local spark=C.new('ParticleEmitter',{Name='RewardStarburst',Texture='rbxasset://textures/particles/sparkles_main.dds',Color=ColorSequence.new(color,Color3.fromRGB(255,244,218)),Rate=0,Lifetime=NumberRange.new(.75,1.4),Speed=NumberRange.new(2.5,5.5),SpreadAngle=Vector2.new(75,75),Acceleration=Vector3.new(0,-3,0),Drag=2,LightEmission=.8,Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.15,.23),NumberSequenceKeypoint.new(.6,.13),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.05),NumberSequenceKeypoint.new(.5,.2),NumberSequenceKeypoint.new(1,1)})},anchor)\n spark:Emit(if record.rare then 30 else 18)\n for i=1,(if record.rare then 5 else 3) do\n  local a=i*math.tau/5\n  local bottom=C.new('Attachment',{Position=Vector3.new(math.cos(a)*.35,0,math.sin(a)*.35)},anchor)\n  local top=C.new('Attachment',{Position=Vector3.new(math.cos(a)*1.6,4.2+math.sin(i)*.5,math.sin(a)*1.6)},anchor)\n  local beam=C.new('Beam',{Name='RewardRay',Attachment0=bottom,Attachment1=top,FaceCamera=true,Width0=.42,Width1=.04,Segments=6,LightEmission=.8,Color=ColorSequence.new(color),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.65),NumberSequenceKeypoint.new(1,1)})},anchor)\n  C.tween(beam,1.05,{Width0=0,Width1=0})\n end\n for i,pitch in {1.05,1.32,1.65,2.05} do task.delay((i-1)*.105,function() if anchor.Parent then self.sound(Config.Audio.Collect,pitch,if record.rare then .2 else .15,anchor) end end) end\n Debris:AddItem(anchor,2.3)\nend\nfunction ChestPresentation:step()\n local now=workspace:GetServerTimeNow()\n for _,record in self.records do if record.active then\n  local age=math.max(0,now-record.at);local angle=0\n  if age<.2 then\n   local pulse=math.sin(age/.2*math.pi);local shake=math.sin(age*85)*pulse\n   record.base.CFrame=record.baseCF*CFrame.new(shake*.045,0,0)*CFrame.Angles(0,0,shake*.012)\n   angle=math.rad(-3)*pulse\n  else\n   record.base.CFrame=record.baseCF\n   local t=math.clamp((age-.2)/1.1,0,1)\n   -- One continuous damped spring, with an exact resting pose.\n   local spring=if t>=1 then 1 else 1-math.exp(-7*t)*(math.cos(8.8*t)+.79545*math.sin(8.8*t))\n   angle=math.rad(-106)*spring\n  end\n  record.lid.CFrame=record.hinge*CFrame.Angles(angle,0,0)*record.hinge:Inverse()*record.closed\n  if age>=.52 and not record.burst then record.burst=true;if age<1.2 then self:burst(record) end end\n  if age>=DURATION then record.base.CFrame=record.baseCF;record.active=false end\n end end\nend\nfunction ChestPresentation:destroy()\n for _,connection in self.connections do connection:Disconnect() end\n for _,record in self.records do record.connection:Disconnect();if record.base.Parent then record.base.CFrame=record.baseCF end end\nend\nreturn ChestPresentation\n"},{"name":"ComfortUI","class":"ModuleScript","source":"--!nonstrict\nlocal RunService=game:GetService('RunService');local GuiService=game:GetService('GuiService')\nlocal Config=require(game.ReplicatedStorage.SeaGame.Shared.Config)\nlocal C=require(script.Parent.Components);local T=require(script.Parent.Theme)\nlocal ComfortUI={};ComfortUI.__index=ComfortUI\nfunction ComfortUI.new(ui)\n local self=setmetatable({ui=ui,percent=0,using=false,phase=0},ComfortUI)\n self.bar=C.panel(ui.root,'RestroomMeter',UDim2.fromOffset(240,46),UDim2.new(.5,-120,0,92),T.Cream,13)\n local badge=C.frame(self.bar,'WC',UDim2.fromOffset(32,32),UDim2.fromOffset(7,7),T.Gold);C.corner(badge,10)\n local label=C.label(badge,'WC',UDim2.fromScale(1,1),nil,13,T.Ink,T.Bold);label.TextXAlignment=Enum.TextXAlignment.Center\n self.label=C.label(self.bar,'RESTROOM',UDim2.new(1,-105,0,19),UDim2.fromOffset(47,5),10,T.Muted,T.Bold)\n self.value=C.label(self.bar,'0%',UDim2.fromOffset(48,20),UDim2.new(1,-57,0,3),14,T.Ink,T.Bold);self.value.TextXAlignment=Enum.TextXAlignment.Right\n local track=C.frame(self.bar,'Track',UDim2.new(1,-58,0,8),UDim2.fromOffset(47,29),T.Sand);C.corner(track,4)\n self.fill=C.frame(track,'Fill',UDim2.fromScale(0,1),nil,T.Gold);C.corner(self.fill,4)\n self.number=C.new('NumberValue',{Value=0},self.bar);self.number.Changed:Connect(function(value) self.value.Text=string.format('%.0f%%',value);self.fill.Size=UDim2.fromScale(value/100,1) end)\n local hint=C.new('TextButton',{Name='Help',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text='',AutoButtonColor=false},self.bar)\n hint.Activated:Connect(function() ui:toastMessage('Fills from your own 5% of the ocean. Visit WC to empty it.','info') end)\n self.offer,self.button,self.scale=C.button(ui.root,'PrismOffer','',UDim2.fromOffset(80,90),UDim2.new(1,-94,0,92),Color3.fromRGB(240,220,255),function() if not self.using then ui:open('Premium') end end)\n self.art=C.viewport(self.button,'Tools','PrismStraw',UDim2.new(1,0,1,-20),UDim2.fromOffset(0,-2));self.art.Rotation=-15\n local price=C.label(self.button,'79 R$',UDim2.new(1,0,0,22),UDim2.new(0,0,1,-24),13,T.Ink,T.Bold);price.TextXAlignment=Enum.TextXAlignment.Center\n self.rim=self.button:FindFirstChildOfClass('UIStroke');self.rim.Thickness=2.5\n self.button.MouseEnter:Connect(function() C.tween(self.art,.25,{Rotation=0},Enum.EasingStyle.Back) end)\n self.button.MouseLeave:Connect(function() C.tween(self.art,.25,{Rotation=-15}) end)\n self.button.SelectionGained:Connect(function() C.tween(self.scale,.2,{Scale=1.06});C.tween(self.art,.25,{Rotation=0}) end)\n self.button.SelectionLost:Connect(function() C.tween(self.scale,.2,{Scale=1});C.tween(self.art,.25,{Rotation=-15}) end)\n self.rainbow=require(script.Parent.StoreUI).rainbow(self.button)\n local clock=0\n self.connection=RunService.Heartbeat:Connect(function(dt)\n  clock+=dt;if clock<.06 then return end;self.phase+=clock;clock=0\n  if not ui.gui.Parent then self.connection:Disconnect();return end\n  local reduced=C.reducedMotion()\n  self.rainbow.Rotation=if reduced then 20 else (self.phase*20)%360\n  self.button.BackgroundColor3=Color3.fromHSV(if reduced then .76 else (self.phase/12)%1,.24,1)\n end)\n return self\nend\nfunction ComfortUI:update(payload)\n self.percent=math.clamp(payload.percent or 0,0,100);self.using=payload.using==true\n self.bar:SetAttribute('ServerPercent',self.percent);self.bar:SetAttribute('UsingRestroom',self.using)\n if self.tween then self.tween:Cancel() end\n self.tween=C.tween(self.number,if self.using then Config.Restroom.UseSeconds elseif self.percent==0 then .8 else .45,{Value=if self.using then 0 else self.percent},if self.using then Enum.EasingStyle.Sine else Enum.EasingStyle.Quart)\n self.label.Text=if self.using then 'TAKING A BREAK' elseif self.percent>=100 then 'VISIT THE WC' else 'RESTROOM'\n self.bar.BackgroundColor3=if self.percent>=100 then T.PaleGold else T.Cream\nend\nfunction ComfortUI:resize(v)\n local compact=v.X<650;local width=if compact then math.min(260,v.X-126) else 240\n self.bar.Size=UDim2.fromOffset(width,46);self.bar.Position=if compact then UDim2.fromOffset(12,166) else UDim2.new(.5,-120,0,92)\n local landscape=v.Y<450 and not compact\n self.offer.Size=UDim2.fromOffset(if landscape then 64 else 80,if landscape then 74 else 90)\n self.offer.Position=UDim2.new(1,if landscape then -184 else -94,0,if compact then 166 else 92)\nend\nreturn ComfortUI\n"},{"name":"Components","class":"ModuleScript","source":"--!nonstrict\nlocal TweenService=game:GetService('TweenService')\nlocal T=require(script.Parent.Theme)\nlocal Skin=require(script.Parent.UISkin)\nlocal C={}\nfunction C.reducedMotion()\n local enabled=false;pcall(function() enabled=game:GetService('GuiService').ReducedMotionEnabled end);return enabled\nend\nfunction C.new(class,properties,parent)\n local object=Instance.new(class);for k,v in properties do object[k]=v end;object.Parent=parent;return object\nend\nfunction C.corner(parent,radius) return C.new('UICorner',{CornerRadius=UDim.new(0,radius or 16)},parent) end\nfunction C.stroke(parent,color,width) return C.new('UIStroke',{Color=color or T.Ink,Thickness=width or 2,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},parent) end\nfunction C.tween(object,time,properties,style,direction)\n local tween=TweenService:Create(object,TweenInfo.new(time or .2,style or Enum.EasingStyle.Quart,direction or Enum.EasingDirection.Out),properties);tween:Play();return tween\nend\nfunction C.frame(parent,name,size,pos,color)\n return C.new('Frame',{Name=name,Size=size or UDim2.fromScale(1,1),Position=pos or UDim2.new(),BackgroundColor3=color or T.Paper,BorderSizePixel=0},parent)\nend\nfunction C.panel(parent,name,size,pos,color,radius)\n local p=C.frame(parent,name,size,pos,color);C.corner(p,radius);C.stroke(p,T.Ink,1.5)\n if color==T.Cream or color==T.Paper or color==T.Sand then C.skin(p,false) end\n return p\nend\nfunction C.skin(parent,wood)\n for _,child in parent:GetChildren() do if child:IsA('UIStroke') then child:Destroy() end end\n parent.BackgroundTransparency=1\n local sand=C.new('ImageLabel',{Name='SandInlay',BackgroundTransparency=1,Size=UDim2.new(1,if wood then -12 else 8,1,if wood then -12 else 8),Position=UDim2.fromOffset(if wood then 6 else -4,if wood then 6 else -4),Image=Skin.Sand,ImageColor3=Color3.fromRGB(255,244,221),ScaleType=Enum.ScaleType.Slice,SliceCenter=Skin.Slice,SliceScale=if wood then .65 else .35,ZIndex=0},parent)\n if wood then C.new('ImageLabel',{Name='CarvedWoodFrame',BackgroundTransparency=1,Size=UDim2.new(1,12,1,12),Position=UDim2.fromOffset(-6,-6),Image=Skin.Wood,ScaleType=Enum.ScaleType.Slice,SliceCenter=Skin.WoodSlice,SliceScale=tonumber(wood) or .45,ZIndex=1},parent) end\n return sand\nend\nfunction C.label(parent,text,size,pos,fontSize,color,font)\n return C.new('TextLabel',{Name='Label',BackgroundTransparency=1,Size=size,Position=pos or UDim2.new(),Text=text,Font=font or T.Body,TextSize=fontSize or 16,TextColor3=color or T.Ink,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center},parent)\nend\nfunction C.button(parent,name,text,size,pos,color,callback)\n local holder=C.frame(parent,name,size,pos);holder.BackgroundTransparency=1\n local shadow=C.frame(holder,'Shadow',UDim2.fromScale(1,1),UDim2.fromOffset(0,4),T.Ink);C.corner(shadow,12)\n local button=C.new('TextButton',{Name='Button',Size=UDim2.fromScale(1,1),BackgroundColor3=color or T.Teal,Text=text,TextColor3=T.Ink,Font=T.Font,TextSize=19,AutoButtonColor=false,BorderSizePixel=0,Selectable=true,ZIndex=2},holder)\n button.BackgroundTransparency=1\n C.corner(button,12);C.stroke(button,T.Ink,1.5)\n local face=C.new('ImageLabel',{Name='RaisedFace',BackgroundTransparency=1,Size=UDim2.new(1,10,1,10),Position=UDim2.fromOffset(-5,-5),Image=Skin.Button,ImageColor3=button.BackgroundColor3,ScaleType=Enum.ScaleType.Slice,SliceCenter=Skin.Slice,SliceScale=.4,ZIndex=1},holder)\n button:GetPropertyChangedSignal('Position'):Connect(function() face.Position=button.Position-UDim2.fromOffset(5,5) end)\n button:GetPropertyChangedSignal('BackgroundColor3'):Connect(function() face.ImageColor3=button.BackgroundColor3 end)\n shadow.BackgroundColor3=Color3.fromRGB(72,82,68);shadow.BackgroundTransparency=.15\n local scale=C.new('UIScale',{Scale=1},holder)\n button.MouseEnter:Connect(function() C.tween(scale,.14,{Scale=1.025}) end)\n button.MouseLeave:Connect(function() C.tween(scale,.16,{Scale=1});C.tween(button,.16,{Position=UDim2.new()}) end)\n button.SelectionGained:Connect(function() C.tween(scale,.14,{Scale=1.025}) end)\n button.SelectionLost:Connect(function() C.tween(scale,.16,{Scale=1}) end)\n button.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then C.tween(scale,.09,{Scale=.96});C.tween(button,.09,{Position=UDim2.fromOffset(0,2)}) end end)\n button.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then C.tween(scale,.22,{Scale=1},Enum.EasingStyle.Back);C.tween(button,.12,{Position=UDim2.new()}) end end)\n if callback then button.Activated:Connect(callback) end\n return holder,button,scale\nend\nfunction C.purchaseGlint(parent)\n if C.reducedMotion() then return end\n local mask=C.frame(parent,'PurchaseGlint',UDim2.fromScale(1,1));mask.BackgroundTransparency=1;mask.ClipsDescendants=true;mask.ZIndex=9;C.corner(mask,14)\n local beam=C.frame(mask,'Light',UDim2.new(.12,0,2,0),UDim2.new(-.3,0,-.5,0),T.White);beam.BackgroundTransparency=.6;beam.Rotation=20;beam.ZIndex=10\n C.tween(beam,.42,{Position=UDim2.new(1.3,0,-.5,0)},Enum.EasingStyle.Sine)\n task.delay(.45,function() mask:Destroy() end)\nend\nfunction C.viewport(parent,category,id,size,pos)\n local frame=C.new('ViewportFrame',{Name='Art_'..id,BackgroundTransparency=1,Size=size,Position=pos or UDim2.new(),Ambient=Color3.fromRGB(222,230,235),LightColor=Color3.fromRGB(255,250,234),LightDirection=Vector3.new(-1,-1,-1),ZIndex=3},parent)\n local prefab=game:GetService('ReplicatedStorage').SeaGame.Assets[category]:FindFirstChild(id)\n if prefab then\n  local world=C.new('WorldModel',{},frame);local model=prefab:Clone();model.Parent=world\n  local cf,bounds=model:GetBoundingBox();local camera=C.new('Camera',{FieldOfView=30},frame);frame.CurrentCamera=camera\n  local function fit()\n   local size=frame.AbsoluteSize;local aspect=if size.Y>0 then math.max(.1,size.X/size.Y) else 1\n   local projectedWidth=bounds.X*.97+bounds.Z*.28\n   local projectedHeight=bounds.Y*.98+bounds.Z*.19+bounds.X*.05\n   local distance=math.max(projectedHeight,projectedWidth/aspect)*2.15\n   camera.CFrame=CFrame.lookAt(cf.Position+Vector3.new(distance*.28,distance*.2,distance),cf.Position)\n  end\n  frame:GetPropertyChangedSignal('AbsoluteSize'):Connect(fit);fit()\n end\n return frame\nend\nfunction C.number(value)\n local n=tostring(math.floor(value+.5));return n:reverse():gsub('(%d%d%d)','%1,'):reverse():gsub('^,','')\nend\nfunction C.waveIcon(parent,pos)\n local icon=C.frame(parent,'WaveIcon',UDim2.fromOffset(38,38),pos,T.DeepTeal);C.corner(icon,12)\n -- An original small vector wave, drawn from rounded strokes rather than emoji.\n local function line(points,width,color)\n  for i=1,#points-1 do\n   local a,b=points[i],points[i+1];local d=b-a\n   local segment=C.frame(icon,'Foam',UDim2.fromOffset(d.Magnitude+width,width),UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2),color)\n   segment.AnchorPoint=Vector2.new(.5,.5);segment.Rotation=math.deg(math.atan2(d.Y,d.X));C.corner(segment,width/2)\n  end\n end\n line({Vector2.new(6,23),Vector2.new(11,23),Vector2.new(15,20),Vector2.new(17,13),Vector2.new(20,10),Vector2.new(24,10),Vector2.new(28,13),Vector2.new(28,17),Vector2.new(25,19),Vector2.new(22,18),Vector2.new(22,15),Vector2.new(24,14)},2.8,T.White)\n line({Vector2.new(6,29),Vector2.new(12,27),Vector2.new(18,29),Vector2.new(24,27),Vector2.new(31,29)},2.3,T.Aqua)\n return icon\nend\nfunction C.pill(parent,text,color,size,pos)\n local p=C.frame(parent,'Pill',size,pos,color);C.corner(p,8);local l=C.label(p,text,UDim2.fromScale(1,1),nil,12,T.Ink,T.Bold);l.TextXAlignment=Enum.TextXAlignment.Center;return p\nend\nreturn C\n"},{"name":"Controller","class":"ModuleScript","source":"--!nonstrict\nlocal Players=game:GetService('Players');local UserInputService=game:GetService('UserInputService');local ContextActionService=game:GetService('ContextActionService');local RunService=game:GetService('RunService');local ProximityPromptService=game:GetService('ProximityPromptService');local StarterGui=game:GetService('StarterGui')\nlocal Package=game:GetService('ReplicatedStorage').SeaGame;local Config=require(Package.Shared.Config)\nlocal UI=require(script.Parent.UI);local Effects=require(script.Parent.Effects)\nlocal RestroomEffects=require(script.Parent.RestroomEffects)\nlocal Controller={};Controller.__index=Controller\nfunction Controller.new()\n local self=setmetatable({holding=false,near=false,point=nil,pulse=0,scan=0,busy=false,prompts={},world={level=0},state=nil},Controller)\n self.player=Players.LocalPlayer;self.remotes=Package.Remotes\n self.ui=UI.new({action=function(action,payload) self:action(action,payload) end,stop=function() self:stop() end})\n self.fx=Effects.new(self.ui)\n self.restroom=RestroomEffects.new(self)\n return self\nend\nfunction Controller:stop()\n if self.holding then self.holding=false;self.remotes.Suction:FireServer(false);self.fx:stop(self.player.UserId) end\n self.ui:hintState(self.near,false)\nend\nfunction Controller:begin()\n if self.ui.shop or self.ui.comfort.using or self.ui.comfort.percent>=100 or UserInputService:GetFocusedTextBox() or not self.point then return false end\n local character=self.player.Character;local human=character and character:FindFirstChildOfClass('Humanoid');local tool=character and character:FindFirstChildOfClass('Tool')\n if not human or human.Health<=0 or not tool or not tool:GetAttribute('SeaStraw') then return false end\n if self.world.ready==false or self.world.saveStatus=='Retrying' or self.world.refilling or self.world.complete then return false end\n self.holding=true;self.pulse=0;self.remotes.Suction:FireServer(self.point);self.ui:hintState(true,true);return true\nend\nfunction Controller:waterPoint()\n local reach=if self.state then self.state.stats.reach else Config.SuctionReach\n local character=self.player.Character;local root=character and character:FindFirstChild('HumanoidRootPart');if not root then return nil end\n local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={character,workspace.NPCs,workspace:FindFirstChild('LiveLoot'),self.fx.folder};params.IgnoreWater=false;params.RespectCanCollide=true\n local camera=workspace.CurrentCamera;local cursor=UserInputService:GetMouseLocation();local ray=camera:ViewportPointToRay(cursor.X,cursor.Y)\n local target=workspace:Raycast(ray.Origin,ray.Direction*300,params)\n if target and target.Material==Enum.Material.Water and (target.Position-root.Position).Magnitude<reach-1 then return Vector3.new(target.Position.X,self.world.level,target.Position.Z) end\n -- Touch and gamepad aim at the closest visible water; the same check also makes shore aiming forgiving.\n local best,bestDistance=nil,reach-1\n for radius=6,reach-1,6 do\n  for i=0,11 do\n   local angle=i*math.pi/6;local p=Vector3.new(root.Position.X+math.sin(angle)*radius,self.world.level,root.Position.Z+math.cos(angle)*radius)\n   local distance=(root.Position-p).Magnitude\n   if distance<bestDistance then\n    local hit=workspace:Raycast(p+Vector3.new(0,2,0),Vector3.new(0,-5,0),params)\n    if hit and hit.Material==Enum.Material.Water then\n     local wall=workspace:Raycast(root.Position,p-root.Position,params)\n     if not wall or wall.Material==Enum.Material.Water or (wall.Position-p).Magnitude<1.2 then best=p;bestDistance=distance end\n    end\n   end\n  end\n end\n return best\nend\nfunction Controller:stateChanged(state)\n if not state or (self.state and state.revision<self.state.revision) then return end\n self.state=state;self.ui:update(state)\nend\nfunction Controller:action(action,payload)\n if self.busy then return end;self.busy=true;self.fx:click()\n task.spawn(function()\n  local ok,result=pcall(function() return self.remotes.Request:InvokeServer(action,payload) end)\n  self.busy=false\n  if not ok then self.ui:toastMessage('Connection interrupted. Please try again.','warning');return end\n  if result.state then self:stateChanged(result.state) end\n  if not result.ok then self.ui:toastMessage(result.message or 'Try again.','warning') elseif action~='SellAll' and action~='Upgrade' and action~='BuyStraw' and action~='ToggleHeld' then self.ui:toastMessage(result.message or 'Ready!','success') end\n end)\nend\nfunction Controller:start()\n Controller.current=self\n pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack,false) end)\n pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)\n task.spawn(function() pcall(function() game:GetService('ContentProvider'):PreloadAsync({Package.Assets.Tools,Package.Assets.Icons}) end) end)\n self.remotes.State.OnClientEvent:Connect(function(state) self:stateChanged(state) end)\n self.remotes.World.OnClientEvent:Connect(function(world) self.world=world;self.ui:updateWorld(world);if world.refilling or world.complete then self:stop() end end)\n self.remotes.FX.OnClientEvent:Connect(function(kind,payload)\n  if kind=='OpenShop' then self:stop();for _,g in self.prompts do g.Enabled=false end;self.ui:open(payload.shop)\n  elseif kind=='Needs' then self.ui.comfort:update(payload);if payload.using or payload.percent>=100 then self:stop() end\n  elseif kind=='RestroomStart' then self.restroom:start(payload)\n  elseif kind=='RestroomEnd' then self.restroom:finish(payload.completed)\n  elseif kind=='Notice' then self.ui:toastMessage(payload.message,payload.kind)\n  elseif kind=='SuctionStart' then self.fx:start(payload)\n  elseif kind=='SuctionStop' then self.fx:stop(payload.player);if payload.player==self.player.UserId then self.holding=false end\n  elseif kind=='SuctionAim' then self.fx:aim(payload)\n  elseif kind=='Pickup' then self.fx:pickup(payload)\n  elseif kind=='ChestOpened' then self.fx:chestOpened(payload)\n  elseif kind=='Sale' then self.ui:sale(payload.amount);for i,pitch in {1,1.25,1.5,2} do task.delay((i-1)*.09,function() self.fx:sound(Config.Audio.Collect,pitch,.2) end) end\n  elseif kind=='Upgrade' then self.fx:upgrade(payload)\n  elseif kind=='PurchaseAward' then\n   if payload.coins>0 then self.ui:sale(payload.coins) end\n   if payload.straw then self.ui:toastMessage(payload.name..' unlocked! Equip it in the shop.','success');self.ui:burst(self.ui.root.AbsoluteSize*.5,Color3.fromRGB(255,205,83),18) end\n  end\n end)\n ContextActionService:BindActionAtPriority('SeaSip',function(_,state,input)\n  if state==Enum.UserInputState.Begin then if self:begin() then return Enum.ContextActionResult.Sink end\n  elseif state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel then if self.holding then self:stop();return Enum.ContextActionResult.Sink end end\n  return Enum.ContextActionResult.Pass\n end,false,Enum.ContextActionPriority.High.Value+10,Enum.UserInputType.MouseButton2,Enum.KeyCode.ButtonR2)\n ContextActionService:BindActionAtPriority('ToggleSeaStraw',function(_,state)\n  if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end\n  if state==Enum.UserInputState.Begin then self:stop();self:action('ToggleHeld') end\n  return Enum.ContextActionResult.Sink\n end,false,Enum.ContextActionPriority.High.Value+12,Enum.KeyCode.One,Enum.KeyCode.ButtonY)\n ContextActionService:BindAction('CloseSeaShop',function(_,state) if state==Enum.UserInputState.Begin and self.ui.shop then self.ui:close();return Enum.ContextActionResult.Sink end;return Enum.ContextActionResult.Pass end,false,Enum.KeyCode.Escape,Enum.KeyCode.ButtonB)\n self.ui.touchButton.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then self.touchInput=input;self:begin() end end)\n UserInputService.InputEnded:Connect(function(input) if input==self.touchInput or input.UserInputType==Enum.UserInputType.MouseButton2 or input.KeyCode==Enum.KeyCode.ButtonR2 then self.touchInput=nil;self:stop() end end)\n UserInputService.WindowFocusReleased:Connect(function() self:stop() end);UserInputService.TextBoxFocused:Connect(function() self:stop() end)\n self.player.CharacterAdded:Connect(function(character) self:stop();self.ui:close();local humanoid=character:WaitForChild('Humanoid');humanoid.Died:Connect(function() self:stop();self.ui:close() end) end)\n ProximityPromptService.PromptShown:Connect(function(prompt,inputType) if prompt.Style~=Enum.ProximityPromptStyle.Custom then return end;local old=self.prompts[prompt];if old then old:Destroy() end;self.prompts[prompt]=self.ui:prompt(prompt,inputType) end)\n ProximityPromptService.PromptHidden:Connect(function(prompt) local g=self.prompts[prompt];if g then g:Destroy();self.prompts[prompt]=nil end end)\n RunService.Heartbeat:Connect(function(dt)\n  self.scan+=dt;self.pulse+=dt\n  if self.scan>=.12 then\n   local character=self.player.Character;local tool=character and character:FindFirstChildOfClass('Tool')\n   local held=tool~=nil and tool:GetAttribute('SeaStraw')~=nil\n   self.ui:setHeld(held)\n   self.scan=0;self.point=if held then self:waterPoint() else nil;self.near=self.point~=nil\n   if self.holding and (not self.near or self.ui.shop) then self:stop() end\n   self.ui:hintState(self.near,self.holding)\n   local interactionsEnabled=self.ui.shop==nil and not self.ui.comfort.using and UserInputService:GetFocusedTextBox()==nil\n   ProximityPromptService.Enabled=interactionsEnabled\n   for prompt,g in self.prompts do if prompt.Parent then g.Enabled=interactionsEnabled end end\n   if self.ui.shop and Config.ShopNames[self.ui.shop] then local root=self.player.Character and self.player.Character:FindFirstChild('HumanoidRootPart');local npc=workspace.NPCs:FindFirstChild(Config.ShopNames[self.ui.shop]);if not root or not npc or (root.Position-npc:GetPivot().Position).Magnitude>Config.ShopDistance+2 then self.ui:close() end end\n  end\n  if self.holding and self.pulse>=.35 then self.pulse=0;self.remotes.Suction:FireServer(self.point) end\n end)\n task.spawn(function()\n  for _=1,20 do local ok,result=pcall(function() return self.remotes.Request:InvokeServer('State') end);if ok and result.state then self:stateChanged(result.state);break end;task.wait(.6) end\n end)\n print('[SeaGame] Client ready')\nend\nreturn Controller\n"},{"name":"Effects","class":"ModuleScript","source":"--!nonstrict\nlocal Players=game:GetService('Players');local RunService=game:GetService('RunService');local Debris=game:GetService('Debris');local SoundService=game:GetService('SoundService')\nlocal Package=game:GetService('ReplicatedStorage').SeaGame;local Config=require(Package.Shared.Config);local C=require(script.Parent.Components);local T=require(script.Parent.Theme)\nlocal Effects={};Effects.__index=Effects\nlocal function part(parent,name,size,color)\n return C.new('Part',{Name=name,Size=size,Color=color,Material=Enum.Material.SmoothPlastic,Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false},parent)\nend\nfunction Effects.new(ui)\n local self=setmetatable({ui=ui,streams={},loot={},flights={},rings={},clock=0,lootClock=0},Effects)\n self.folder=C.new('Folder',{Name='LocalSeaEffects'},workspace)\n -- Preload two reusable voices: the first pickup is audible, and rapid pickups\n -- cannot accumulate dozens of sounds. The sparkle follows a soft rising fifth.\n self.pickupAudio=C.new('Folder',{Name='SeaPickupAudio'},SoundService)\n self.pickupNotes={};self.pickupFades={};self.pickupSequence=0\n for _,name in {'SoftNote','SparkleNote'} do\n  local note=C.new('Sound',{Name=name,SoundId=Config.Audio.Collect,Volume=0},self.pickupAudio)\n  C.new('EqualizerSoundEffect',{LowGain=-5,MidGain=0,HighGain=-8},note);table.insert(self.pickupNotes,note)\n end\n task.spawn(function() pcall(function() game:GetService('ContentProvider'):PreloadAsync(self.pickupNotes) end) end)\n self.folder.Destroying:Connect(function() self.pickupSequence+=1;self.pickupAudio:Destroy() end)\n self.worldPolish=require(script.Parent.WorldPolish).new()\n self.rainbowTools=require(script.Parent.RainbowTools).new()\n self.chestPresentation=require(script.Parent.ChestPresentation).new(self.folder,function(...) return self:sound(...) end)\n local horizon=workspace.Ocean:WaitForChild('DistantSea',20)\n if horizon then\n  local function levelChanged() local level=workspace.Ocean:GetAttribute('WaterLevel') or 0;for _,p in horizon:GetChildren() do if p:IsA('BasePart') then p.Position=Vector3.new(p.Position.X,level-.08,p.Position.Z) end end end\n  workspace.Ocean:GetAttributeChangedSignal('WaterLevel'):Connect(levelChanged);levelChanged()\n end\n local boatRig=workspace.Ocean:WaitForChild('BoatPresentation',20);local boat=boatRig and boatRig:FindFirstChild('LittleBoat')\n if boat and boat:IsA('BasePart') then\n  local original=boat.CFrame;local lowest=boat.Position.Y-boat.Size.Y/2\n  local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={workspace.UnderwaterTerrain.Seafloor};params.IgnoreWater=true;params.RespectCanCollide=true\n  local hit=workspace:Raycast(Vector3.new(original.X,10,original.Z),Vector3.new(0,-190,0),params)\n  local floorDelta=if hit then hit.Position.Y-lowest else Config.Ocean.minimum\n  local function floatBoat() local level=workspace.Ocean:GetAttribute('WaterLevel') or 0;C.tween(boat,.45,{CFrame=original+Vector3.new(0,math.max(level,floorDelta),0)}) end\n  workspace.Ocean:GetAttributeChangedSignal('WaterLevel'):Connect(floatBoat);floatBoat()\n end\n local folder=workspace:WaitForChild('LiveLoot')\n local function watch(model) if not model:IsA('Model') then return end;task.defer(function()\n  if not model.Parent then return end\n  local ground=model:GetAttribute('GroundPosition');if not ground then return end\n  local visuals={};for _,p in model:GetDescendants() do if p:IsA('BasePart') and p.Name~='PickupRoot' then table.insert(visuals,{part=p,offset=p.CFrame-model:GetPivot().Position}) end end\n  local rarity=model:GetAttribute('Rarity');local definition=Config.LootById[model:GetAttribute('LootId')]\n  if definition and (rarity=='RARE' or rarity=='EPIC' or rarity=='LEGENDARY') and visuals[1] then\n   C.new('Highlight',{Name='TreasureGleam',Adornee=model,FillColor=definition.color,OutlineColor=definition.color,FillTransparency=.9,OutlineTransparency=.55,DepthMode=Enum.HighlightDepthMode.Occluded},model)\n   local a=C.new('Attachment',{Name='TreasureSparkles'},visuals[1].part)\n   C.new('ParticleEmitter',{Name='GentleSparkles',Texture='rbxasset://textures/particles/sparkles_main.dds',Color=ColorSequence.new(definition.color),LightEmission=.85,Rate=4,Lifetime=NumberRange.new(.65,1.15),Speed=NumberRange.new(.25,.65),SpreadAngle=Vector2.new(180,180),Acceleration=Vector3.new(0,.3,0),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.25,.16),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.2),NumberSequenceKeypoint.new(1,1)})},a)\n  end\n  local elapsed=math.max(0,workspace:GetServerTimeNow()-(model:GetAttribute('BornAt') or workspace:GetServerTimeNow()))\n  local burst=model:GetAttribute('BurstOrigin')\n  if burst and elapsed<.58 then for _,v in visuals do v.part.LocalTransparencyModifier=1 end end\n  self.loot[model]={ground=ground,base=model:GetPivot(),born=os.clock()-elapsed,visuals=visuals,burst=burst}\n end) end\n folder.ChildAdded:Connect(watch);folder.ChildRemoved:Connect(function(model) self.loot[model]=nil end);for _,m in folder:GetChildren() do watch(m) end\n self.connection=RunService.RenderStepped:Connect(function(dt) self:step(math.min(dt,.1)) end)\n return self\nend\nfunction Effects:sound(id,pitch,volume,parent,looped)\n local sound=C.new('Sound',{SoundId=id,Volume=volume or .18,PlaybackSpeed=pitch or 1,Looped=looped or false,RollOffMaxDistance=65},parent or SoundService);sound:Play();if not looped then Debris:AddItem(sound,3) end;return sound\nend\nfunction Effects:click() self:sound(Config.Audio.Click,1.35,.14) end\nfunction Effects:pickupChime(rare)\n self.pickupSequence+=1;local sequence=self.pickupSequence\n for i,note in self.pickupNotes do\n  if self.pickupFades[i] then self.pickupFades[i]:Cancel() end\n  note:Stop()\n  local function play()\n   if self.pickupSequence~=sequence or not note.Parent then return end\n   note.TimePosition=0;note.PlaybackSpeed=(if i==1 then 1.12 else 1.68)*(if rare then 1.08 else 1)\n   note.Volume=if i==1 then .22 else .11;note:Play()\n   self.pickupFades[i]=C.tween(note,if i==1 then .36 else .42,{Volume=0},Enum.EasingStyle.Sine,Enum.EasingDirection.In)\n  end\n  if i==1 then play() else task.delay(.065,play) end\n end\nend\nfunction Effects:burst(position,color,rare)\n if (self.burstCount or 0)>=8 then return end;self.burstCount=(self.burstCount or 0)+1\n local anchor=part(self.folder,'DiscoveryBurst',Vector3.one*.1,color);anchor.Transparency=1;anchor.Position=position\n local emitter=C.new('ParticleEmitter',{Texture='rbxasset://textures/particles/sparkles_main.dds',Color=ColorSequence.new(color,T.Gold),LightEmission=.65,Rate=0,Lifetime=NumberRange.new(.35,.8),Speed=NumberRange.new(2,if rare then 6 else 4),SpreadAngle=Vector2.new(150,150),Acceleration=Vector3.new(0,-4,0),Drag=3,Rotation=NumberRange.new(-180,180),RotSpeed=NumberRange.new(-100,100),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.22,if rare then .24 else .15),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.08),NumberSequenceKeypoint.new(.65,.25),NumberSequenceKeypoint.new(1,1)})},anchor)\n emitter:Emit(if C.reducedMotion() then 4 elseif rare then 22 else 12)\n Debris:AddItem(anchor,1.1);task.delay(1.1,function() self.burstCount-=1 end)\nend\nfunction Effects:upgrade(payload)\n for i,pitch in {1,1.25,1.5} do task.delay((i-1)*.1,function() self:sound(Config.Audio.Collect,pitch,.2) end) end\n self.ui:upgradeCelebration(payload and payload.category)\n local character=Players.LocalPlayer.Character;local root=character and character:FindFirstChild('HumanoidRootPart')\n if root then self:burst(root.Position,T.Gold,true) end\nend\nfunction Effects:stop(userId)\n local stream=self.streams[userId];if not stream then return end;self.streams[userId]=nil\n for _,ik in stream.iks do C.tween(ik,.22,{Weight=0});Debris:AddItem(ik,.25) end\n for _,target in stream.targets do Debris:AddItem(target,.3) end\n if stream.sound then C.tween(stream.sound,.25,{Volume=0});Debris:AddItem(stream.sound,.3) end\n if stream.tool and stream.tool.Parent then C.tween(stream.tool,.25,{Grip=stream.grip}) end\n for _,joint in stream.pose or {} do if joint.motor.Parent then C.tween(joint.motor,.25,{C0=joint.base}) end end\n C.tween(stream.beam,.2,{Width0=0,Width1=0});Debris:AddItem(stream.anchor,.23)\n if stream.core then C.tween(stream.core,.16,{Width0=0,Width1=0}) end\n for _,bubble in stream.bubbles do C.tween(bubble.part,.16,{Transparency=1,Size=Vector3.one*.03});Debris:AddItem(bubble.part,.2) end\n if userId==Players.LocalPlayer.UserId and stream.camera then C.tween(stream.camera,.35,{FieldOfView=stream.fov}) end\nend\nfunction Effects:start(payload)\n self:stop(payload.player)\n local player=Players:GetPlayerByUserId(payload.player);local character=player and player.Character\n if player~=Players.LocalPlayer then\n  local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart');local count=0;for _ in self.streams do count+=1 end\n  if not root or (root.Position-payload.point).Magnitude>110 or count>=5 then return end\n end\n local tool=character and character:FindFirstChildOfClass('Tool');local handle=tool and tool:FindFirstChild('Handle');local tip=handle and handle:FindFirstChild('SuctionTip');local human=character and character:FindFirstChildOfClass('Humanoid');local head=character and character:FindFirstChild('Head')\n if not tip or not human or not head then return end\n local anchor=part(self.folder,'WaterIntake',Vector3.one*.1,T.Teal);anchor.Transparency=1;anchor.CFrame=CFrame.new(payload.point)\n local from=C.new('Attachment',{CFrame=CFrame.Angles(0,0,math.pi/2)},anchor)\n tip.Orientation=Vector3.new(0,0,-90)\n local beam=C.new('Beam',{Name='SuctionStream',Attachment0=from,Attachment1=tip,Width0=0,Width1=0,Segments=16,FaceCamera=true,LightEmission=.35,Color=ColorSequence.new(T.Teal,T.Aqua),Transparency=NumberSequence.new(.24)},anchor)\n C.tween(beam,.3,{Width0=.25,Width1=.10})\n local core=beam:Clone();core.Name='StreamFoam';core.Color=ColorSequence.new(Color3.fromRGB(225,255,247));core.Transparency=NumberSequence.new(.35);core.Parent=anchor;C.tween(core,.32,{Width0=.075,Width1=.035})\n local stream={player=player,character=character,tool=tool,grip=tool.Grip,tip=tip,anchor=anchor,beam=beam,core=core,point=payload.point,targetPoint=payload.point,bubbles={},iks={},targets={},phase=0,ripple=0,special=payload.straw=='AdminStraw' or payload.straw=='PrismStraw'}\n stream.pose={}\n for _,name in {'Waist','Neck'} do local motor=character:FindFirstChild(name,true);if motor and motor:IsA('Motor6D') then table.insert(stream.pose,{motor=motor,base=motor.C0,tilt=if name=='Waist' then -.07 else .045}) end end\n for _,side in {'Right','Left'} do\n  local upper=character:FindFirstChild(side..'UpperArm');local hand=character:FindFirstChild(side..'Hand')\n  if upper and hand then\n   local target=C.new('Attachment',{Name='SipPoseTarget',CFrame=CFrame.new(if side=='Right' then .66 else -.18,-1.1,if side=='Right' then -.8 else -1.08)*CFrame.Angles(0,0,if side=='Right' then math.rad(9) else math.rad(-18))},head)\n   local ik=C.new('IKControl',{Name='Sip'..side,Type=Enum.IKControlType.Transform,ChainRoot=upper,EndEffector=hand,Target=target,Weight=0,SmoothTime=.16,Priority=2},human)\n   table.insert(stream.iks,ik);table.insert(stream.targets,target);C.tween(ik,.32,{Weight=if side=='Right' then 1 else .8})\n  end\n end\n local count=if player==Players.LocalPlayer then 22 else 10\n for i=1,count do local b=part(self.folder,'WaterBubble',Vector3.one*.13,if i%4==0 then T.White else T.Aqua);b.Shape=Enum.PartType.Ball;b.Transparency=.22;table.insert(stream.bubbles,{part=b,t=(i-1)/count,phase=i*2.4}) end\n stream.sound=self:sound(Config.Audio.Water,1.25,.08,anchor,true)\n if player==Players.LocalPlayer and not C.reducedMotion() then stream.camera=workspace.CurrentCamera;stream.fov=stream.camera.FieldOfView;C.tween(stream.camera,.5,{FieldOfView=stream.fov+2}) end\n self.streams[payload.player]=stream\nend\nfunction Effects:aim(payload) local s=self.streams[payload.player];if s then s.targetPoint=payload.point elseif payload.player~=Players.LocalPlayer.UserId then self:start(payload) end end\nfunction Effects:ripple(position)\n if #self.rings>=12 then return end\n local root=part(self.folder,'SipRipple',Vector3.one*.1,T.Aqua);root.Transparency=1;root.CFrame=CFrame.new(position+Vector3.new(0,.065,0))\n local attachments={};local beams={}\n for i=0,3 do\n  local a=i*math.pi/2;local tangent=Vector3.new(-math.sin(a),0,math.cos(a));local cf=CFrame.fromMatrix(Vector3.new(math.cos(a),0,math.sin(a)),tangent,Vector3.yAxis)\n  attachments[i+1]=C.new('Attachment',{CFrame=cf},root)\n end\n for i=1,4 do beams[i]=C.new('Beam',{Attachment0=attachments[i],Attachment1=attachments[i%4+1],Width0=.055,Width1=.055,CurveSize0=.5523,CurveSize1=.5523,Segments=8,FaceCamera=true,Color=ColorSequence.new(T.Aqua),Transparency=NumberSequence.new(.1)},root) end\n table.insert(self.rings,{root=root,attachments=attachments,beams=beams,age=0})\nend\nfunction Effects:pickup(payload)\n local item=Config.LootById[payload.loot];local player=Players:GetPlayerByUserId(payload.player);local root=player and player.Character and player.Character:FindFirstChild('HumanoidRootPart')\n if not item then return end\n -- Confirmed inventory feedback must not depend on a mesh or the flight budget.\n if player==Players.LocalPlayer then\n  self:pickupChime(item.rarity=='LEGENDARY' or item.rarity=='EPIC' or item.rarity=='RARE');self.ui:pickupNotice(item)\n end\n if not root then return end\n local prefab=Package.Assets.Loot:FindFirstChild(payload.loot);if not prefab then return end\n if #self.flights>=12 then return end\n local model=prefab:Clone();model.Name='CollectedTreasure';model.Parent=self.folder;model:PivotTo(CFrame.new(payload.position))\n self:burst(payload.position+Vector3.new(0,.3,0),item.color,item.rarity=='RARE' or item.rarity=='EPIC' or item.rarity=='LEGENDARY')\n local visual=model:FindFirstChildWhichIsA('BasePart',true)\n if visual then\n  local a=C.new('Attachment',{Position=Vector3.new(-.1,0,0)},visual);local b=C.new('Attachment',{Position=Vector3.new(.1,0,0)},visual)\n  C.new('Trail',{Attachment0=a,Attachment1=b,Lifetime=.2,MinLength=.04,FaceCamera=true,LightEmission=.6,Color=ColorSequence.new(item.color,T.PaleGold),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.25),NumberSequenceKeypoint.new(1,1)}),WidthScale=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)})},visual)\n end\n table.insert(self.flights,{model=model,origin=payload.position,target=root,age=0,duration=if C.reducedMotion() then .22 else .85,scale=model:GetScale(),item=item,localPlayer=player==Players.LocalPlayer})\nend\nfunction Effects:chestOpened(payload)\n -- Replicated OpenedAt drives one synchronized presentation, including late joiners.\n -- Keep this event handler for compatibility with the established FX dispatcher.\nend\nfunction Effects:step(dt)\n self.clock+=dt;local now=os.clock()\n for userId,s in self.streams do\n  if not s.tip.Parent or not s.character.Parent then self:stop(userId);continue end\n  s.phase+=dt;s.point=s.point:Lerp(s.targetPoint,1-math.exp(-dt*14));s.anchor.Position=s.point\n  local finish=s.tip.WorldPosition;local origin=s.point;local distance=(finish-origin).Magnitude\n  s.beam.CurveSize0=math.min(distance*.28,5);s.beam.CurveSize1=math.min(distance*.15,2)\n  s.core.CurveSize0=s.beam.CurveSize0;s.core.CurveSize1=s.beam.CurveSize1\n  s.tool.Grip=s.grip*CFrame.Angles(math.sin(s.phase*3.8)*.018,0,math.sin(s.phase*4.5)*.014)\n  if not C.reducedMotion() then for _,joint in s.pose do if joint.motor.Parent then joint.motor.C0=joint.base*CFrame.Angles(joint.tilt*math.min(s.phase/.35,1)+math.sin(s.phase*3.2)*.009,0,0) end end end\n  for _,bubble in s.bubbles do\n   bubble.t=(bubble.t+dt*.72)%1;local t=bubble.t;local travel=math.clamp((t-.18)/.82,0,1);local bend=(origin+finish)*.5+Vector3.new(0,math.min(distance*.3,4),0)\n   local pos=(1-travel)^2*origin+2*(1-travel)*travel*bend+travel*travel*finish\n   local radius=if t<.18 then (1-t/.18)*1.15+.26 else .26*(1-travel)\n   local swirl=Vector3.new(math.cos(bubble.phase+t*19+s.phase*2),0,math.sin(bubble.phase+t*19+s.phase*2))*radius\n   bubble.part.Position=pos+swirl;local size=(.10+math.sin(math.pi*t)*.09)*(1-t*.45);bubble.part.Size=Vector3.one*size;bubble.part.Transparency=.15+math.abs(t-.5)*.45\n  end\n  s.ripple+=dt;if s.ripple>.48 then s.ripple=0;self:ripple(origin) end\n end\n for i=#self.rings,1,-1 do\n  local r=self.rings[i];r.age+=dt;local t=r.age/.9\n  if t>=1 then r.root:Destroy();table.remove(self.rings,i) else\n   local radius=.25+(1-t)*1.4\n   for index,a in r.attachments do local angle=(index-1)*math.pi/2;a.Position=Vector3.new(math.cos(angle),0,math.sin(angle))*radius end\n   for _,beam in r.beams do beam.CurveSize0=.5523*radius;beam.CurveSize1=.5523*radius;beam.Transparency=NumberSequence.new(.15+t*.85) end\n  end\n end\n self.lootClock+=dt\n if self.lootClock>=1/30 then\n  self.lootClock=0;local char=Players.LocalPlayer.Character;local root=char and char:FindFirstChild('HumanoidRootPart')\n  for model,data in self.loot do\n   if not model.Parent then self.loot[model]=nil;continue end\n   if data.settled or (root and (data.ground-root.Position).Magnitude>125) then continue end\n   local age=now-data.born;local rotation=0;local position=data.base.Position;local duration=if data.burst then 1.65 else .55\n   if data.burst and age<duration then\n    local t=math.clamp((age-.58)/1.07,0,1);local ease=t*t*(3-2*t)\n    position=data.burst:Lerp(position,ease)+Vector3.new(0,math.sin(t*math.pi)*3.3,0);rotation=(1-ease)*math.pi*1.5\n   elseif age<duration then position+=data.base.UpVector*math.sin(math.clamp(age/duration,0,1)*math.pi)*.32 end\n   local cf=CFrame.new(position)*data.base.Rotation\n   -- Only the artwork moves: the authoritative pickup position and prompt stay on the ground.\n   for _,v in data.visuals do if v.part.Parent then v.part.LocalTransparencyModifier=if data.burst and age<.58 then 1 else 0;v.part.CFrame=CFrame.new(cf.Position)*CFrame.Angles(0,rotation,0)*v.offset end end\n   if age>=duration then data.settled=true end\n  end\n end\n for i=#self.flights,1,-1 do\n  local flight=self.flights[i];flight.age+=dt;local t=math.clamp(flight.age/flight.duration,0,1)\n  if t>=1 or not flight.target.Parent then\n   if t>=1 and flight.localPlayer then self.ui:pickupArrival(flight.item) end\n   flight.model:Destroy();table.remove(self.flights,i)\n  else\n   local finish=flight.target.Position+Vector3.new(0,.7,0);local bend=(flight.origin+finish)*.5+Vector3.new(0,3.5,0)\n   local ease=t*t;local pos=(1-ease)^2*flight.origin+2*(1-ease)*ease*bend+ease*ease*finish\n   local reduced=C.reducedMotion()\n   flight.model:PivotTo(CFrame.new(pos)*CFrame.Angles(0,if reduced then 0 else t*math.pi*2,if reduced then 0 else math.sin(t*math.pi)*.2));flight.model:ScaleTo(flight.scale*((1+(if reduced then 0 else math.sin(math.min(t/.23,1)*math.pi)*.18))*(1-ease*.84)))\n  end\n end\nend\nreturn Effects\n"},{"name":"RainbowTools","class":"ModuleScript","source":"--!nonstrict\nlocal Players=game:GetService('Players');local RunService=game:GetService('RunService')\nlocal C=require(script.Parent.Components)\nlocal Rainbow={};Rainbow.__index=Rainbow\nfunction Rainbow.new()\n local self=setmetatable({records={},clock=0,scan=0,phase=0},Rainbow)\n self.connection=RunService.Heartbeat:Connect(function(dt) self:step(dt) end)\n return self\nend\nfunction Rainbow:watch(tool)\n if self.records[tool] then return end\n local id=tool:GetAttribute('SeaStraw');if id~='PrismStraw' and id~='AdminStraw' then return end\n local handle=tool:FindFirstChild('Handle');if not handle then return end\n local root=C.new('Attachment',{Name='LocalAurora',Position=Vector3.new(0,-.2,0)},handle)\n local light=C.new('PointLight',{Brightness=if id=='AdminStraw' then .65 else .25,Range=if id=='AdminStraw' then 6 else 3,Shadows=false},root)\n local shine=C.new('Highlight',{Name='AuroraRim',Adornee=tool,FillTransparency=.96,OutlineTransparency=.38,DepthMode=Enum.HighlightDepthMode.Occluded},root)\n local sparks=C.new('ParticleEmitter',{Texture='rbxasset://textures/particles/sparkles_main.dds',Rate=if id=='AdminStraw' then 5 else 2,Speed=NumberRange.new(.1,.35),Lifetime=NumberRange.new(.45,.8),LightEmission=.85,SpreadAngle=Vector2.new(180,180),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.3,.12),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.15),NumberSequenceKeypoint.new(1,1)})},root)\n self.records[tool]={root=root,light=light,shine=shine,sparks=sparks}\nend\nfunction Rainbow:step(dt)\n self.clock+=dt;self.scan+=dt;if self.clock<.06 then return end;self.phase+=self.clock;self.clock=0\n if self.scan>.4 then\n  self.scan=0;local localRoot=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')\n  for _,player in Players:GetPlayers() do\n   local char=player.Character;local root=char and char:FindFirstChild('HumanoidRootPart')\n   if root and localRoot and (root.Position-localRoot.Position).Magnitude<100 then\n    local tool=char:FindFirstChildOfClass('Tool');if tool then self:watch(tool) end\n   end\n  end\n end\n local reduced=C.reducedMotion();local color=Color3.fromHSV(if reduced then .66 else (self.phase/7)%1,.6,1)\n for tool,r in self.records do\n  if not tool:IsDescendantOf(workspace) or not r.root.Parent then r.root:Destroy();self.records[tool]=nil\n  else r.light.Color=color;r.shine.FillColor=color;r.shine.OutlineColor=color;r.sparks.Color=ColorSequence.new(color,Color3.new(1,1,1));r.sparks.Enabled=not reduced end\n end\nend\nreturn Rainbow\n"},{"name":"RestroomEffects","class":"ModuleScript","source":"--!nonstrict\nlocal Players=game:GetService('Players');local TweenService=game:GetService('TweenService');local GuiService=game:GetService('GuiService')\nlocal Config=require(game.ReplicatedStorage.SeaGame.Shared.Config)\nlocal RestroomEffects={};RestroomEffects.__index=RestroomEffects\nfunction RestroomEffects.new(controller)\n local self=setmetatable({controller=controller,generation=0},RestroomEffects)\n self.booth=workspace.Buildings:WaitForChild('BeachRestroom')\n self.door=self.booth:WaitForChild('Door');self.closed=self.door.CFrame;self.open=self.booth.DoorHinge.CFrame*CFrame.Angles(0,math.rad(-92),0)*self.booth.DoorHinge.CFrame:ToObjectSpace(self.closed)\n local function doorChanged()\n  if self.doorTween then self.doorTween:Cancel() end\n  self.doorTween=TweenService:Create(self.door,TweenInfo.new(.55,Enum.EasingStyle.Cubic),{CFrame=if self.booth:GetAttribute('Occupied') then self.closed else self.open});self.doorTween:Play()\n end\n self.booth:GetAttributeChangedSignal('Occupied'):Connect(doorChanged);doorChanged()\n local function character(character)\n  self:finish(false)\n  local human=character:WaitForChild('Humanoid',10);if human then human.Died:Connect(function() self:finish(false) end) end\n end\n Players.LocalPlayer.CharacterAdded:Connect(character)\n if Players.LocalPlayer.Character then task.spawn(character,Players.LocalPlayer.Character) end\n return self\nend\nfunction RestroomEffects:start(payload)\n self:finish(false);self.generation+=1;local token=self.generation\n self.controller:stop();self.controller.ui:close()\n local camera=workspace.CurrentCamera\n self.saved={camera=camera,kind=camera.CameraType,subject=camera.CameraSubject,fov=camera.FieldOfView,frame=camera.CFrame,token=token}\n camera:SetAttribute('SeaRestroomCamera',token);camera.CameraType=Enum.CameraType.Scriptable\n local reduced=false;pcall(function() reduced=GuiService.ReducedMotionEnabled end)\n self.cameraTween=TweenService:Create(camera,TweenInfo.new(if reduced then .05 else .85,Enum.EasingStyle.Quart,Enum.EasingDirection.InOut),{CFrame=payload.camera,FieldOfView=math.min(85,camera.FieldOfView+6)});self.cameraTween:Play()\n local sound=Instance.new('Sound');sound.Name='RestroomWater';sound.SoundId=Config.Restroom.Sound;sound.Volume=.42;sound.RollOffMinDistance=6;sound.RollOffMaxDistance=25;sound.Parent=self.booth.Inside;self.sound=sound\n task.delay(.65,function() if self.generation==token and sound.Parent then sound:Play() end end)\n self.controller.ui:toastMessage('A little shore break...','info')\n task.delay(payload.duration+3,function() if self.generation==token then self:finish(false) end end)\nend\nfunction RestroomEffects:finish(completed)\n self.generation+=1\n if self.cameraTween then self.cameraTween:Cancel();self.cameraTween=nil end\n if self.sound then self.sound:Destroy();self.sound=nil end\n local saved=self.saved;self.saved=nil\n if saved and saved.camera.Parent and saved.camera:GetAttribute('SeaRestroomCamera')==saved.token then\n  local human=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChildOfClass('Humanoid')\n  local function restore()\n   if saved.camera:GetAttribute('SeaRestroomCamera')~=saved.token then return end\n   saved.camera:SetAttribute('SeaRestroomCamera',nil);saved.camera.CameraType=saved.kind;saved.camera.FieldOfView=saved.fov\n   saved.camera.CameraSubject=if saved.subject and saved.subject.Parent then saved.subject else human\n   if saved.kind==Enum.CameraType.Scriptable then saved.camera.CFrame=saved.frame end\n  end\n  local root=human and human.Parent:FindFirstChild('HumanoidRootPart');local reduced=false;pcall(function() reduced=GuiService.ReducedMotionEnabled end)\n  if completed and root and human.Health>0 and not reduced then\n   local focus=root.Position+Vector3.new(0,1,0)\n   local target=CFrame.lookAt(focus-saved.frame.LookVector*12+Vector3.new(0,2,0),focus)\n   self.cameraTween=TweenService:Create(saved.camera,TweenInfo.new(.65,Enum.EasingStyle.Quart,Enum.EasingDirection.InOut),{CFrame=target,FieldOfView=saved.fov});self.cameraTween:Play();task.delay(.66,restore)\n  else restore() end\n end\n if completed then self.controller.ui:toastMessage('All fresh! Back to the sea.','success') end\nend\nreturn RestroomEffects\n"},{"name":"ShoreContours","class":"ModuleScript","source":"--!nonstrict\n-- Blender triangle contours: quantized to .01 stud, sampled every .75 stud of water.\n-- Packed below Roblox's 200,000-character Source limit. Decoded once per client.\nlocal encoded=[==[]==]\nlocal alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'\nlocal values={};for i=1,#alphabet do values[string.byte(alphabet,i)]=i-1 end\nlocal data=buffer.create(108000);local offset=0\nfor i=1,#encoded,4 do\n local a,b,c,d=string.byte(encoded,i,i+3)\n local n=values[a]*262144+values[b]*4096+values[c]*64+values[d]\n buffer.writeu8(data,offset,math.floor(n/65536));buffer.writeu8(data,offset+1,math.floor(n/256)%256);buffer.writeu8(data,offset+2,n%256);offset+=3\nend\nlocal contours={step=.75,count=120,levels=225}\nfunction contours.radius(row,column) return buffer.readu16(data,((row-1)*240+column-1)*2)/100 end\nreturn contours\n"},{"name":"StoreUI","class":"ModuleScript","source":"--!nonstrict\nlocal RunService=game:GetService('RunService');local Marketplace=game:GetService('MarketplaceService')\nlocal Package=game.ReplicatedStorage.SeaGame;local Offers=require(Package.Shared.Offers);local Config=require(Package.Shared.Config)\nlocal C=require(script.Parent.Components);local T=require(script.Parent.Theme)\nlocal Store={};Store.__index=Store\nlocal rainbow=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,137,167)),ColorSequenceKeypoint.new(.2,Color3.fromRGB(255,214,104)),ColorSequenceKeypoint.new(.4,Color3.fromRGB(109,228,173)),ColorSequenceKeypoint.new(.6,Color3.fromRGB(91,203,255)),ColorSequenceKeypoint.new(.8,Color3.fromRGB(182,142,255)),ColorSequenceKeypoint.new(1,Color3.fromRGB(255,137,167))})\nfunction Store.rainbow(parent)\n local stroke=parent:FindFirstChildOfClass('UIStroke') or C.stroke(parent,T.White,3);stroke.Color=T.White;stroke.Thickness=3\n return C.new('UIGradient',{Color=rainbow,Rotation=20},stroke)\nend\nfunction Store.new(ui)\n local self=setmetatable({ui=ui,prices={},offers={},clock=0,phase=0,animated={}},Store)\n for _,offer in Offers do self.offers[offer.id]=offer end\n self.holder,self.button=C.button(ui.coins,'BuyCoins','+',UDim2.fromOffset(44,44),UDim2.new(1,-49,.5,-22),T.Gold,function() ui:open('Coins') end)\n self.button.TextSize=26\n self.shopIcon,self.shopButton=C.button(ui.root,'CoinShopOffer','',UDim2.fromOffset(88,78),UDim2.fromOffset(12,92),T.PaleGold,function() ui:open('Coins') end)\n C.viewport(self.shopButton,'Icons','CoinStack',UDim2.fromOffset(66,49),UDim2.fromOffset(11,-2))\n local title=C.label(self.shopButton,'COINS +',UDim2.new(1,0,0,24),UDim2.new(0,0,1,-27),13,T.Ink,T.Bold);title.TextXAlignment=Enum.TextXAlignment.Center\n task.spawn(function()\n  for _,offer in Offers do\n   if offer.assetId>0 then\n    local ok,info=pcall(function() return Marketplace:GetProductInfoAsync(offer.assetId,if offer.kind=='Pass' then Enum.InfoType.GamePass else Enum.InfoType.Product) end)\n    self.prices[offer.id]=if ok and info.IsForSale and type(info.PriceInRobux)=='number' then info.PriceInRobux else false\n   end\n  end\n  if ui.shop=='Coins' or ui.shop=='Premium' or ui.shop=='Admin' then ui:refreshShop() end\n end)\n self.connection=RunService.Heartbeat:Connect(function(dt)\n  self.clock+=dt;if self.clock<.05 then return end;self.phase+=self.clock;self.clock=0\n  if not ui.gui.Parent then self.connection:Disconnect();return end\n  local reduced=C.reducedMotion()\n  for i=#self.animated,1,-1 do\n   local entry=self.animated[i]\n   if not entry.gradient.Parent then table.remove(self.animated,i) else\n    entry.gradient.Rotation=if reduced then 20 else (self.phase*18)%360\n    if entry.model and entry.model.Parent and ui.window.Visible then entry.model:PivotTo(entry.base*CFrame.Angles(0,if reduced then 0 else math.sin(self.phase*.8)*.22,0)) end\n   end\n  end\n end)\n return self\nend\nfunction Store:animate(parent,art)\n local world=art and art:FindFirstChildOfClass('WorldModel');local model=world and world:FindFirstChildOfClass('Model')\n table.insert(self.animated,{gradient=Store.rainbow(parent),model=model,base=model and model:GetPivot()})\nend\nfunction Store:price(offer)\n local value=self.prices[offer.id]\n return if value==false then 'UNAVAILABLE' else C.number(value or offer.robux)..' R$'\nend\nfunction Store:purchase(offer)\n if offer.straw and self.ui.state.owned[offer.straw] then self.ui.callbacks.action('EquipSpecial',offer.straw);return end\n if offer.assetId<=0 then self.ui:toastMessage('Coming soon \u00b7 Robux purchases are not available yet.','info');return end\n if not self.prices[offer.id] then self.ui:toastMessage('Checking the Roblox price. Please try again shortly.','info');return end\n self.ui.callbacks.action('PurchaseOffer',offer.id)\nend\nfunction Store:resize(v)\n self.shopIcon.Visible=v.X>=650\n self.ui.coinLabel.Size=UDim2.new(1,-108,0,30);self.ui.coinLabel.Position=UDim2.fromOffset(52,24)\n self.ui.coinLabel.TextSize=if v.X<650 then 20 else 23\n local shop=self.ui.shop\n if shop~='Coins' and shop~='Premium' and shop~='Admin' then return end\n local w=self.ui.window.Size.X.Offset;local h=self.ui.window.Size.Y.Offset\n if shop=='Coins' then\n  local columns=if w<540 then 1 else 2\n  self.ui.grid.CellSize=UDim2.fromOffset(math.floor((w-42-12*(columns-1))/columns),236)\n else\n  local narrow=w<530\n  local cardHeight=if narrow then math.max(480,h-128) else math.max(360,h-128)\n  local infoY=cardHeight-363\n  self.ui.grid.CellSize=UDim2.fromOffset(w-42,cardHeight)\n  if self.hero then\n   self.hero.Size=if narrow then UDim2.new(1,-32,0,infoY-10) else UDim2.new(.36,-12,1,-60)\n   self.hero.Position=UDim2.fromOffset(16,if narrow then 8 else 28)\n   self.info.Position=if narrow then UDim2.fromOffset(18,infoY) else UDim2.new(.38,0,0,25)\n   self.info.Size=if narrow then UDim2.new(1,-36,0,280) else UDim2.new(.62,-20,1,-110)\n   self.buyHolder.Size=UDim2.new(1,-36,0,48);self.buyHolder.Position=UDim2.new(0,18,1,-78)\n   local short=h<450 and not narrow\n   self.specialPill.Visible=not short;self.specialNote.Visible=not short;self.detail.Visible=not short\n   self.title.Position=UDim2.fromOffset(0,if short then 0 else 32);self.title.Size=UDim2.new(1,0,0,if short then 28 else 36)\n   self.intro.Position=UDim2.fromOffset(0,if short then 28 else 72);self.intro.TextSize=if short then 12 else 13\n   self.buyButton.TextSize=if short then 16 else 19\n   for i,tile in self.statTiles do\n    local x=(i-1)%2;local y=math.floor((i-1)/2)\n    tile.Size=UDim2.new(.5,-5,0,if short then 44 else 58);tile.Position=UDim2.new(x*.5,x*5,0,(if short then 54 else 108)+y*(if short then 49 else 66))\n    tile.Caption.Position=UDim2.fromOffset(8,if short then 2 else 6);tile.Value.Position=UDim2.fromOffset(8,if short then 16 else 23);tile.Value.TextSize=if short then 17 else 19\n   end\n   if short then\n    self.ui.grid.CellSize=UDim2.fromOffset(w-42,math.max(180,h-126))\n    self.hero.Size=UDim2.new(.34,-12,1,-53);self.hero.Position=UDim2.fromOffset(16,2)\n    self.info.Position=UDim2.new(.36,0,0,0);self.info.Size=UDim2.new(.64,-20,1,0)\n    self.buyHolder.Size=UDim2.new(.34,-18,0,44);self.buyHolder.Position=UDim2.new(0,18,1,-48)\n   end\n  end\n end\nend\nfunction Store:renderCoins()\n local ui=self.ui\n for i=1,4 do\n  local offer=Offers[i];local bundle=offer.id=='AdminBundle';local card=ui:card(offer.id,i)\n  local top=C.frame(card,'Accent',UDim2.new(1,-12,0,79),UDim2.fromOffset(6,6),offer.color:Lerp(T.White,.76));C.corner(top,12)\n  local art=C.viewport(top,if bundle then 'Tools' else 'Icons',offer.art,UDim2.fromScale(1,1))\n  if bundle then self:animate(card,art) end\n  local amount=C.label(card,if bundle then '5,000 + ADMIN STRAW' else C.number(offer.coins)..' COINS',UDim2.new(1,-24,0,33),UDim2.fromOffset(12,90),if bundle then 21 else 27,T.Ink,T.Font);amount.TextXAlignment=Enum.TextXAlignment.Center\n  local description=C.label(card,if bundle then 'Strongest suction \u00b7 Super run & jump' else offer.name,UDim2.new(1,-24,0,24),UDim2.fromOffset(12,122),13,T.Muted,T.Body);description.TextXAlignment=Enum.TextXAlignment.Center;description.TextWrapped=true\n  local note=C.label(card,if bundle then 'Permanent straw \u00b7 Coins granted once' else 'Added directly to your coin balance',UDim2.new(1,-24,0,23),UDim2.fromOffset(12,146),11,T.Muted,T.Body);note.TextXAlignment=Enum.TextXAlignment.Center\n  C.button(card,'Purchase',if bundle then 'VIEW  \u00b7  '..self:price(offer) else 'BUY  \u00b7  '..self:price(offer),UDim2.new(1,-28,0,44),UDim2.fromOffset(14,174),offer.color,function() if bundle then ui:open('Admin') else self:purchase(offer) end end)\n  local status=C.label(card,if offer.assetId<=0 then 'COMING SOON' else 'SECURE ROBLOX CHECKOUT',UDim2.new(1,-24,0,14),UDim2.fromOffset(12,222),9,T.Muted,T.Bold);status.TextXAlignment=Enum.TextXAlignment.Center\n end\nend\nfunction Store:renderSpecial(id)\n local ui=self.ui;local offer=self.offers[id];local admin=id=='AdminBundle';local def=Config.StrawById[offer.straw]\n local card=ui:card('SpecialShowcase',1)\n self.hero=C.viewport(card,'Tools',offer.straw,UDim2.new(.36,-12,1,-60),UDim2.fromOffset(16,28));self.hero.Name='Hero'\n self:animate(card,self.hero)\n self.info=C.frame(card,'Details',UDim2.new(.62,-20,1,-110),UDim2.new(.38,0,0,25));self.info.BackgroundTransparency=1\n self.specialPill=C.pill(self.info,if admin then 'ROYAL AURORA' else 'RAINBOW EDITION',offer.color:Lerp(T.White,.5),UDim2.fromOffset(155,24),UDim2.new())\n self.title=C.label(self.info,offer.name,UDim2.new(1,0,0,36),UDim2.fromOffset(0,32),27,T.Ink,T.Font);self.title.TextScaled=true;C.new('UITextSizeConstraint',{MinTextSize=20,MaxTextSize=27},self.title)\n self.intro=C.label(self.info,if admin then '+5,000 coins \u00b7 Permanent straw' else 'A rainbow finish for every adventure.',UDim2.new(1,0,0,24),UDim2.fromOffset(0,72),13,T.Muted,T.Body)\n local stats=if admin then {{'SUCTION',C.number(def.power*def.speed*Config.Ocean.BaseRemovalRate)..'/s'},{'REACH',def.reach..' studs'},{'SUPER RUN',def.walk..' studs/s'},{'SUPER JUMP',def.jumpHeight..' studs'}} else {{'SUCTION',C.number(def.power*def.speed*Config.Ocean.BaseRemovalRate)..'/s'},{'REACH',def.reach..' studs'},{'POWER',def.power..'x'},{'SPEED',def.speed..'x'}}\n self.statTiles={}\n for i,stat in stats do\n  local x=(i-1)%2;local y=math.floor((i-1)/2)\n  local tile=C.frame(self.info,'Stat'..i,UDim2.new(.5,-5,0,58),UDim2.new(x*.5,x*5,0,108+y*66),if i%2==1 then T.Aqua:Lerp(T.White,.4) else offer.color:Lerp(T.White,.76));C.corner(tile,10)\n  C.label(tile,stat[1],UDim2.new(1,-16,0,17),UDim2.fromOffset(8,6),10,T.Muted,T.Bold).Name='Caption'\n  C.label(tile,stat[2],UDim2.new(1,-16,0,27),UDim2.fromOffset(8,23),19,T.Ink,T.Font).Name='Value';table.insert(self.statTiles,tile)\n end\n self.detail=C.label(self.info,if admin then 'Fastest straw, even with max upgrades.\\nMovement boosts while held. Coins awarded once.' else 'Same base performance as Ocean Vacuum (tier 6).\\nWorks with your existing upgrades.',UDim2.new(1,0,0,42),UDim2.fromOffset(0,241),12,T.Muted,T.Body);self.detail.TextWrapped=true;self.detail.TextYAlignment=Enum.TextYAlignment.Top\n local owned=ui.state.owned[offer.straw];local equipped=ui.state.equipped==offer.straw\n self.buyHolder,self.buyButton=C.button(card,'BuySpecial',if equipped then 'EQUIPPED' elseif owned then 'EQUIP STRAW' else 'BUY  \u00b7  '..self:price(offer),UDim2.new(1,-36,0,48),UDim2.new(0,18,1,-78),if admin then Color3.fromRGB(208,170,255) else T.Gold,function() if not equipped then self:purchase(offer) end end)\n self.buyButton.Active=not equipped;self.buyButton.Selectable=not equipped\n self.specialNote=C.label(card,if offer.assetId<=0 then 'COMING SOON \u00b7 CHECKOUT NOT AVAILABLE YET' else 'ONE-TIME PURCHASE \u00b7 YOURS TO KEEP',UDim2.new(1,-20,0,17),UDim2.new(0,10,1,-23),10,T.Muted,T.Bold);self.specialNote.TextXAlignment=Enum.TextXAlignment.Center\nend\nreturn Store\n"},{"name":"Theme","class":"ModuleScript","source":"--!strict\nreturn table.freeze({\n Ink=Color3.fromRGB(24,62,72),Muted=Color3.fromRGB(91,119,121),Cream=Color3.fromRGB(255,248,228),\n Paper=Color3.fromRGB(255,253,244),Sand=Color3.fromRGB(239,226,194),Teal=Color3.fromRGB(38,190,171),\n DeepTeal=Color3.fromRGB(18,135,130),Aqua=Color3.fromRGB(178,236,224),Coral=Color3.fromRGB(250,133,110),\n Gold=Color3.fromRGB(255,202,83),PaleGold=Color3.fromRGB(255,234,163),White=Color3.fromRGB(255,255,255),\n Font=Enum.Font.FredokaOne,Body=Enum.Font.GothamMedium,Bold=Enum.Font.GothamBold,\n})\n"},{"name":"UI","class":"ModuleScript","source":"--!nonstrict\nlocal Players=game:GetService('Players');local UserInputService=game:GetService('UserInputService');local RunService=game:GetService('RunService');local GuiService=game:GetService('GuiService')\nlocal Package=game:GetService('ReplicatedStorage').SeaGame;local Config=require(Package.Shared.Config);local Economy=require(Package.Shared.Economy)\nlocal T=require(script.Parent.Theme);local C=require(script.Parent.Components)\nlocal ComfortUI=require(script.Parent.ComfortUI)\nlocal StoreUI=require(script.Parent.StoreUI)\nlocal DepthZones=require(Package.Shared.DepthZones)\nlocal UI={};UI.__index=UI\nfunction UI.new(callbacks)\n local self=setmetatable({callbacks=callbacks,shop=nil,state=nil,world={},cards={},toastId=0,closing=0,busy=false},UI)\n local old=Players.LocalPlayer.PlayerGui:FindFirstChild('SeaGameUI');if old then old:Destroy() end\n self.gui=C.new('ScreenGui',{Name='SeaGameUI',ResetOnSpawn=false,DisplayOrder=20,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets},Players.LocalPlayer.PlayerGui)\n self.root=C.frame(self.gui,'SafeArea');self.root.BackgroundTransparency=1\n self.coins=C.panel(self.root,'Coins',UDim2.fromOffset(202,62),UDim2.fromOffset(16,12),T.Cream,16)\n C.viewport(self.coins,'Icons','Coin',UDim2.fromOffset(46,52),UDim2.fromOffset(0,5))\n C.label(self.coins,'COINS',UDim2.fromOffset(130,16),UDim2.fromOffset(52,8),11,T.Muted,T.Bold)\n self.coinLabel=C.label(self.coins,'0',UDim2.new(1,-68,0,30),UDim2.fromOffset(60,24),26,T.Ink,T.Font)\n self.coinValue=C.new('NumberValue',{Value=0},self.gui);self.coinValue.Changed:Connect(function(n) self.coinLabel.Text=C.number(n) end)\n self.coinScale=C.new('UIScale',{Scale=1},self.coins)\n self.bag=C.panel(self.root,'Backpack',UDim2.fromOffset(202,62),UDim2.fromOffset(230,12),T.Cream,16)\n C.viewport(self.bag,'Icons','Backpack',UDim2.fromOffset(54,54),UDim2.fromOffset(2,1))\n C.label(self.bag,'BACKPACK',UDim2.fromOffset(140,16),UDim2.fromOffset(59,7),11,T.Muted,T.Bold)\n self.bagLabel=C.label(self.bag,'0 / 5',UDim2.fromOffset(125,24),UDim2.fromOffset(59,21),22,T.Ink,T.Font)\n local bagTrack=C.frame(self.bag,'Track',UDim2.new(1,-70,0,6),UDim2.fromOffset(59,49),T.Sand);C.corner(bagTrack,3)\n self.bagFill=C.frame(bagTrack,'Fill',UDim2.fromScale(0,1),nil,T.Teal);C.corner(self.bagFill,3)\n self.bagScale=C.new('UIScale',{Scale=1},self.bag)\n self.bagValue=C.new('NumberValue',{Value=0},self.gui);self.bagValue.Changed:Connect(function(n) self.bagLabel.Text=string.format('%d / %d',math.floor(n+.5),if self.state then self.state.capacity else 5) end)\n self.sea=C.frame(self.root,'OceanProgress',UDim2.fromOffset(320,70),UDim2.new(.5,0,0,10));self.sea.BackgroundTransparency=1;self.sea.AnchorPoint=Vector2.new(.5,0)\n local seaShadow=C.frame(self.sea,'Shadow',UDim2.fromScale(1,1),UDim2.fromOffset(0,3),T.DeepTeal);C.corner(seaShadow,16)\n local seaBody=C.panel(self.sea,'Body',UDim2.fromScale(1,1),nil,T.Paper,16)\n seaBody.SandInlay:Destroy();C.skin(seaBody,.14)\n self.wave=C.viewport(seaBody,'Icons','Ocean',UDim2.fromOffset(47,47),UDim2.fromOffset(6,5));self.waveScale=C.new('UIScale',{Scale=1},self.wave)\n C.label(seaBody,'OCEAN REMAINING',UDim2.new(1,-74,0,17),UDim2.fromOffset(61,8),12,T.Muted,T.Bold)\n self.seaLabel=C.label(seaBody,'--.--%',UDim2.new(1,-74,0,30),UDim2.fromOffset(60,23),27,T.Ink,T.Bold);self.seaLabel.Name='Percent'\n local seaTrack=C.frame(seaBody,'Track',UDim2.new(1,-28,0,7),UDim2.fromOffset(14,56),T.Aqua);C.corner(seaTrack,4)\n self.seaFill=C.frame(seaTrack,'Fill',UDim2.fromScale(1,1),nil,T.Teal);C.corner(self.seaFill,4)\n self.seaNumber=C.new('NumberValue',{Name='DisplayedOceanPercent',Value=100},self.gui)\n self.seaNumber.Changed:Connect(function(value)\n  local text=string.format('%.2f%%',math.clamp(value,0,100));if self.seaLabel.Text~=text then self.seaLabel.Text=text end\n  self.seaFill.Size=UDim2.fromScale(math.clamp(value/100,0,1),1)\n end)\n self.slot=C.panel(self.root,'EquippedStraw',UDim2.fromOffset(254,66),UDim2.new(.5,-127,1,-82),T.Cream,17)\n self.toolArt=C.viewport(self.slot,'Tools','BasicStraw',UDim2.fromOffset(58,61),UDim2.fromOffset(1,2))\n self.slotCaption=C.label(self.slot,'EQUIPPED',UDim2.fromOffset(180,16),UDim2.fromOffset(62,10),11,T.Muted,T.Bold)\n self.toolLabel=C.label(self.slot,'Basic Straw',UDim2.fromOffset(183,28),UDim2.fromOffset(62,25),20,T.Ink,T.Font)\n local slotButton=C.new('TextButton',{Name='Equip',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text='',AutoButtonColor=false},self.slot)\n slotButton.Activated:Connect(function() callbacks.stop();callbacks.action('ToggleHeld') end)\n self.hint=C.panel(self.root,'ActionHint',UDim2.fromOffset(360,34),UDim2.new(.5,-180,1,-130),T.Ink,12)\n self.hintLabel=C.label(self.hint,'Find the shore. Hold right mouse to sip.',UDim2.new(1,-16,1,0),UDim2.fromOffset(8,0),14,T.Cream,T.Body);self.hintLabel.TextXAlignment=Enum.TextXAlignment.Center\n self.touchHolder,self.touchButton,self.touchScale=C.button(self.root,'HoldToSip','HOLD\\nTO SIP',UDim2.fromOffset(92,92),UDim2.new(1,-118,1,-227),T.Teal,nil)\n self.touchButton.TextSize=19;self.touchHolder.Visible=UserInputService.TouchEnabled;C.new('UIAspectRatioConstraint',{AspectRatio=1},self.touchHolder)\n self.toast=C.panel(self.root,'Toast',UDim2.fromOffset(370,58),UDim2.new(.5,-185,0,88),T.Cream,16);self.toast.Visible=false\n self.toastLabel=C.label(self.toast,'',UDim2.new(1,-28,1,-12),UDim2.fromOffset(14,6),17,T.Ink,T.Bold);self.toastLabel.TextWrapped=true;self.toastLabel.TextXAlignment=Enum.TextXAlignment.Center\n self.toastS