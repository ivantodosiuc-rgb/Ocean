assert(not game:GetService('RunService'):IsRunning(),'Install in Edit mode only');local function folder(parent,name) local f=parent:FindFirstChild(name);if not f then f=Instance.new('Folder');f.Name=name;f.Parent=parent end;return f end;local package=folder(game:GetService('ReplicatedStorage'),'SeaGame');local remotes=folder(package,'Remotes');for _,name in {'Request','State','World','FX','Suction'} do if not remotes:FindFirstChild(name) then local r=Instance.new(if name=='Request' then 'RemoteFunction' else 'RemoteEvent');r.Name=name;r.Parent=remotes end end;local group="Tests";local parent;if group=='Server' then parent=folder(game:GetService('ServerScriptService'),'SeaGame') elseif group=='Tests' then parent=folder(game:GetService('ServerStorage'),'SeaGameTests') else parent=folder(package,group) end;local sources=game:GetService('HttpService'):JSONDecode([====[[{"name":"Comfort","class":"ModuleScript","source":"--!nonstrict\nreturn function()\n local S=game.ReplicatedStorage.SeaGame.Shared;local C=require(S.Config);local E=require(S.Economy);local N=require(S.Needs)\n local passed=0;local function check(ok,name) assert(ok,name);passed+=1;print('COMFORT_PASS',name) end\n check(#C.Straws==10,'Ten ordinary straws')\n local data=E.new();check(E.stats(data).power*C.Ocean.BaseRemovalRate==250,'Starter is 25 percent faster')\n data.Coins=10000000\n for i,s in C.Straws do\n  if i>1 then local before=data.Coins;check(E.buyStraw(data,s.id) and data.Coins==before-s.price,'Buy '..s.id) end\n  check(E.stats(data).reach==s.reach and E.stats(data).speed==s.speed,'Real characteristics '..s.id)\n end\n local p=C.PremiumStraw;local sixth=C.Straws[6]\n check(p.robux==79 and p.power==sixth.power and p.speed==sixth.speed and p.reach==sixth.reach,'Prism matches tier six')\n check(not E.buyStraw(data,p.id) and not E.equip(data,p.id),'Preview cannot be acquired through coin remotes')\n check(N.percent(C.Ocean.TotalOceanVolume*.01)==20 and N.percent(C.Ocean.TotalOceanVolume*.05)==100,'Five personal percent fills the meter')\n local a,b=N.share(100,1,4),N.share(100,3,4)\n check(a==25 and b==75 and a+b==100,'Accepted water attributed once proportionally')\n check(N.share(0,100,100)==0,'No credit for rejected water or other servers')\n check(N.availablePower(N.Capacity,200,.1)==0,'Full meter blocks suction')\n check(math.abs(N.availablePower(N.Capacity-5,200,.1)*.1*C.Ocean.BaseRemovalRate-5)<.00001,'Threshold limits removal without overshoot')\n data.NeedsWater=12345.678901234;local saved=E.normalize(E.copy(data));check(saved.NeedsWater==data.NeedsWater,'Fractional need survives profile serialization')\n check(E.normalize({NeedsWater=0/0}).NeedsWater==0 and E.normalize({NeedsWater=math.huge}).NeedsWater==0,'Invalid need values rejected')\n local bag=E.new();check(E.addLoot(bag,'StarterMussel'),'Starter mussel collectible');local ok,_,amount=E.sell(bag);check(ok and amount==1 and bag.Coins==1,'Mussel sells for exactly one coin')\n local Profiles=require(game.ServerScriptService.SeaGame.Profiles);local store={values={}}\n function store:UpdateAsync(key,fn) local value=fn(self.values[key]);if value then self.values[key]=game.HttpService:JSONDecode(game.HttpService:JSONEncode(value)) end;return self.values[key] end\n local player={UserId=9876123,Parent=true};local first=Profiles.new(nil,store);first:load(player).NeedsWater=12345.678901234;first:release(player)\n local second=Profiles.new(nil,store);check(second:load(player).NeedsWater==12345.678901234,'Need survives mock leave and rejoin');second:release(player)\n return passed\nend\n"},{"name":"Commerce","class":"ModuleScript","source":"--!nonstrict\nreturn function()\n local Shared=game.ReplicatedStorage.SeaGame.Shared;local Config=require(Shared.Config);local E=require(Shared.Economy);local Offers=require(Shared.Offers)\n local Profiles=require(game.ServerScriptService.SeaGame.Profiles);local Commerce=require(game.ServerScriptService.SeaGame.Commerce)\n local passed=0;local function check(ok,name) assert(ok,name);passed+=1;print('COMMERCE_PASS',name) end\n check(Offers[1].coins==500 and Offers[1].robux==39,'500 / 39 offer')\n check(Offers[2].coins==1000 and Offers[2].robux==89,'1000 / 89 offer')\n check(Offers[3].coins==1500 and Offers[3].robux==149,'1500 / 149 offer')\n check(Offers[4].coins==5000 and Offers[4].robux==1999 and Offers[4].straw=='AdminStraw','Admin bundle / 1999')\n local data=E.new();data.Coins=1e9\n check(not E.buyStraw(data,'AdminStraw') and not data.Owned.AdminStraw,'Coins cannot buy Admin')\n check(not E.buyStraw(data,'PrismStraw') and not data.Owned.PrismStraw,'Coins cannot buy Prism')\n check(not E.equip(data,'AdminStraw'),'Unowned special cannot equip')\n data.Owned.AdminStraw=true;check(E.equip(data,'AdminStraw'),'Owned special can equip')\n data.Upgrades.Power=15;data.Upgrades.Speed=15;local a=E.stats(data);data.Equipped='Leviathan';local b=E.stats(data)\n check(a.power*a.speed>b.power*b.speed,'Admin stronger at max upgrades')\n check(a.power*a.speed*Config.Ocean.BaseRemovalRate<Config.Ocean.MaxRemovalRate,'Admin upgrades remain below cap')\n local store={values={},fail=false}\n local function copy(v) return game.HttpService:JSONDecode(game.HttpService:JSONEncode(v)) end\n function store:UpdateAsync(key,fn)\n  if self.fail then error('Intentional offline fixture') end\n  local value=fn(copy(self.values[key] or {}));if value==nil then return nil end\n  self.values[key]=copy(value);return copy(value)\n end\n local player=game.Players:GetPlayers()[1];assert(player,'Run commerce tests in Play')\n local profiles=Profiles.new(nil,store);profiles:load(player)\n local fake={profiles=profiles,remotes={FX={FireClient=function() end}},sendState=function() end}\n local market={owns=false,prompts=0}\n function market:UserOwnsGamePassAsync() return self.owns end\n function market:PromptProductPurchase() self.prompts+=1 end\n function market:PromptGamePassPurchase() self.prompts+=1 end\n local c=Commerce.new(fake,market);c.products[90901]=Offers[1]\n local receipt={ProductId=90901,PlayerId=player.UserId,PurchaseId='test-one'}\n check(c:receipt(receipt)==Enum.ProductPurchaseDecision.PurchaseGranted,'Persisted receipt acknowledged')\n check(profiles:get(player).Coins==500 and store.values['u_'..player.UserId].Data.Coins==500,'Coins durable before acknowledgement')\n check(c:receipt(receipt)==Enum.ProductPurchaseDecision.PurchaseGranted and profiles:get(player).Coins==500,'Duplicate receipt gives no extra coins')\n check(c:receipt({ProductId=99999,PlayerId=player.UserId,PurchaseId='unknown'})==Enum.ProductPurchaseDecision.NotProcessedYet,'Unknown product remains pending')\n check(c:receipt({ProductId=90901,PlayerId=-999,PurchaseId='absent'})==Enum.ProductPurchaseDecision.NotProcessedYet,'Absent player remains pending')\n local ok=c:prompt(player,'Coins500');check(not ok and market.prompts==0,'Unconfigured checkout cannot charge')\n check(not c:prompt(player,{}),'Invalid offer payload rejected')\n local pass={assetId=90902,coins=5000,straw='AdminStraw',name='Admin'}\n check(not c:reconcilePass(player,pass) and not profiles:get(player).Owned.AdminStraw,'Unverified pass grants nothing')\n market.owns=true;check(c:reconcilePass(player,pass),'Verified pass grants bundle')\n check(profiles:get(player).Coins==5500 and profiles:get(player).Owned.AdminStraw,'Bundle includes exact coins and entitlement')\n check(c:reconcilePass(player,pass) and profiles:get(player).Coins==5500,'Pass bonus awarded once')\n profiles:release(player);local resumed=Profiles.new(nil,store);resumed:load(player)\n check(resumed:get(player).Owned.AdminStraw and resumed:get(player).Coins==5500,'Bundle survives mock rejoin')\n c.game.profiles=resumed\n check(c:receipt(receipt)==Enum.ProductPurchaseDecision.PurchaseGranted and resumed:get(player).Coins==5500,'Receipt stays idempotent after rejoin')\n local normalized=E.normalize(E.copy(resumed:get(player)));check(normalized.Receipts['product:test-one'] and normalized.Owned.AdminStraw,'Receipt and entitlement survive normalization')\n local clone=E.copy(normalized);clone.Receipts['product:test-one']=nil;check(normalized.Receipts['product:test-one'],'Receipt snapshot is independent')\n -- Failed and ambiguous saves never acknowledge or double-credit on retry.\n store.fail=true;receipt.PurchaseId='test-offline'\n check(c:receipt(receipt)==Enum.ProductPurchaseDecision.NotProcessedYet,'Offline store leaves receipt pending')\n local pending=resumed:get(player).Coins;check(pending==6000,'Pending award applied once in current session')\n store.fail=false\n check(c:receipt(receipt)==Enum.ProductPurchaseDecision.PurchaseGranted and resumed:get(player).Coins==pending,'Retry persists without duplicate award')\n check(store.values['u_'..player.UserId].Data.Receipts['product:test-offline'],'Retry commits receipt marker with coins')\n resumed:release(player)\n local ephemeral=Profiles.new();ephemeral.store=nil;ephemeral:load(player)\n check(not ephemeral:grantPurchase(player,'no-save',500,nil),'Ephemeral profile cannot acknowledge purchases')\n check(ephemeral:get(player).Coins==0,'No unsaved coin award in unpublished experience')\n return passed\nend\n"},{"name":"DepthZones","class":"ModuleScript","source":"--!nonstrict\nreturn function()\n local P=game.ReplicatedStorage.SeaGame;local Z=require(P.Shared.DepthZones);local C=require(P.Shared.Config);local E=require(P.Shared.Economy)\n local passed=0;local function check(v,name) assert(v,'Depth system: '..name);passed+=1 end\n for i=1,5 do check(Z.index((i-1)*32)==i,'Exact zone boundary '..i);check(Z.index(i*32-.001)==i,'Fractional zone boundary '..i) end\n check(Z.index(999)==5 and Z.index(-1)==1,'Depth clamps')\n local expected={{'CommonShell','SpiralShell','Starfish','SmallCrabShell','OldBottle'},{'ColorfulShell','PearlShell','PinkPearl','CoralFragment','BlueStar'},{'GoldenCoinPile','CeramicJug','TreasureChest','Compass','BlackPearl'},{'GiantPearl','AncientRelic','CrystalCoral','RoyalCrown','AtlanteanTablet'},{'RoyalTreasureChest','AquamarineCluster','GoldenIdol','LegendaryPearl','CrystalHeart'}}\n for zone,ids in expected do for _,id in ids do check(C.LootById[id].minZone==zone,'Named resource gate '..id) end end\n local means={};local results={}\n for zone=1,5 do\n  local counts={};local total=0;local highest=0;local random=Random.new(912+zone);local samples=8000\n  for i=1,samples do\n   local id=E.rollLoot(random,(zone-.5)*32);local item=C.LootById[id]\n   assert(item and item.minZone<=zone and item.weight>0,'Forbidden zone loot')\n   counts[item.rarity]=(counts[item.rarity]or 0)+1;total+=item.value;highest=math.max(highest,item.value)\n  end\n  for rarity,chance in Z.List[zone].weights do check(math.abs((counts[rarity]or 0)/samples-chance/100)<.022,'Rarity distribution '..zone..' '..rarity) end\n  means[zone]=total/samples;results[zone]={mean=means[zone],highest=highest,counts=counts}\n  check((counts.COMMON or 0)>samples*.3,'Cheap loot remains at depth '..zone)\n  if zone>1 then check(means[zone]>means[zone-1],'Expected value rises at zone '..zone) end\n  task.wait()\n end\n local a,b=Random.new(Z.Seed+7919),Random.new(Z.Seed+7919)\n for i=1,200 do assert(E.rollLoot(a,145)==E.rollLoot(b,145),'Seeded site reroll changed') end;check(true,'Deterministic site sequence')\n check(E.rollLoot(Random.new(1),0,99999)==nil,'Impossible pool never grants a cheap fallback')\n check(C.Capacities[1]==5 and C.Capacities[5]==20,'Bag compatibility')\n local sites=require(game.ServerScriptService.SeaGame.GroundSites);local last=math.huge;local distribution={0,0,0,0,0}\n for i=1,sites.count do local p,n=sites.get(i);assert(p.Y<=last+.001 and p.Y>C.Ocean.minimum and n.Y>.72,'Invalid ground site');last=p.Y;distribution[Z.index(-p.Y)]+=1 end\n for i=1,5 do check(distribution[i]>100,'Available unobstructed sites zone '..i) end\n check(C.Ocean.TotalOceanVolume==(C.Ocean.halfSize*2)^2*(C.Ocean.initial-C.Ocean.minimum),'Volume matches actual vertical ocean bounds')\n workspace:SetAttribute('DepthDistributionTest',game.HttpService:JSONEncode({results=results,sites=distribution}))\n return passed\nend\n"},{"name":"EconomyProfiles","class":"ModuleScript","source":"--!nonstrict\nreturn function()\n local Package=game.ReplicatedStorage.SeaGame;local E=require(Package.Shared.Economy);local C=require(Package.Shared.Config);local Profiles=require(game.ServerScriptService.SeaGame.Profiles)\n local passed=0\n local function check(condition,name) assert(condition,'FAILED: '..name);passed+=1;print('STEP3_TEST_PASS',name) end\n local d=E.new();check(d.Coins==0 and E.capacity(d)==5 and d.Owned.BasicStraw,'New player defaults')\n check(not E.buyStraw(d,'OceanVacuum') and d.Coins==0,'Insufficient funds never subtract')\n check(not E.buyStraw(d,'invalid') and not E.equip(d,'GoldenStraw'),'Unknown and unowned equipment rejected')\n for _=1,5 do check(E.addLoot(d,'CommonShell'),'Collect into free slot') end\n check(not E.addLoot(d,'AncientRelic') and E.count(d)==5,'Full backpack rejects extra loot')\n local ok,_,value=E.sell(d);check(ok and value==50 and d.Coins==50 and E.count(d)==0,'Sale has exact authoritative value')\n check(not E.sell(d) and d.Coins==50,'Duplicate sale awards zero')\n d.Coins=150;check(E.buyStraw(d,'ColorfulStraw') and d.Coins==0 and d.Equipped=='ColorfulStraw','Buy equips and charges once')\n check(not E.buyStraw(d,'ColorfulStraw') and d.Coins==0,'Duplicate purchase rejected')\n d.Coins=1e6\n for i,capacity in {7,10,15,20} do local before=d.Coins;check(E.upgrade(d,'Backpack') and E.capacity(d)==capacity and before-d.Coins==C.BackpackPrices[i],'Backpack tier '..i) end\n check(not E.upgrade(d,'Backpack'),'Backpack maximum enforced')\n for i,speed in {18,20,23,26,30} do check(E.upgrade(d,'Walk') and E.stats(d).walk==speed,'Walk tier '..i) end\n E.upgrade(d,'Power');E.upgrade(d,'Speed');check(math.abs(E.stats(d).power-2.4)<.0001 and math.abs(E.stats(d).speed-1.155)<.000001,'Power and speed modifiers')\n local strongest=C.Straws[#C.Straws]\n check(C.Ocean.MaxRemovalRate>strongest.power*strongest.speed*(1+.2*15)*(1+.1*15)*C.Ocean.BaseRemovalRate,'Strongest straw and all single-player upgrades retain their full effect')\n local bad=E.normalize({Coins=-900,Owned={Unknown=true},Equipped='Unknown',Upgrades={Walk=999,Backpack=-10},Bag={AncientRelic=3,CommonShell=-1,Invalid=500}})\n check(bad.Coins==0 and bad.Equipped=='BasicStraw' and bad.Upgrades.Walk==5 and E.count(bad)==3,'Corrupt profile normalized safely')\n local nan=E.normalize({Coins=0/0,Bag={CommonShell=math.huge},Upgrades={Power=0/0}});check(nan.Coins==0 and E.count(nan)==0 and nan.Upgrades.Power==0,'NaN and infinity rejected')\n local copy=E.copy(d);copy.Owned.Test=true;copy.Upgrades.Power=999;check(not d.Owned.Test and d.Upgrades.Power==1,'Save snapshot is independent')\n local rng=Random.new(128)\n check(#C.Loot==58,'Existing fifty-one resources plus seven expedition finds')\n for _=1,1000 do local id=E.rollLoot(rng,0);assert((C.LootById[id].minDepth or 0)==0,'Deep item appeared at the surface') end\n check(true,'Shallow loot respects depth gates')\n for _=1,1000 do local id=E.rollLoot(rng,80,600);assert(C.LootById[id].value>=600 and C.LootById[id].minDepth<=80,'Chest reward outside its pool') end\n check(true,'Wreck chest guarantees valuable loot')\n local http=game.HttpService;local store={values={},failures=0,calls=0}\n function store:UpdateAsync(key,transform)\n  self.calls+=1;if self.failures>0 then self.failures-=1;error('Simulated temporary DataStore outage') end\n  local old=self.values[key];if old then old=http:JSONDecode(http:JSONEncode(old)) end\n  local value=transform(old);if value then self.values[key]=http:JSONDecode(http:JSONEncode(value));return self.values[key] end;return nil\n end\n local player={UserId=987654321,Parent=true};local a=Profiles.new(nil,store);local profile=a:load(player)\n profile.Coins=4321;profile.Owned.GoldenStraw=true;profile.Equipped='GoldenStraw';profile.Upgrades.Backpack=3;profile.Bag.PearlShell=2;profile.Revision+=1\n check(a:save(player,false),'DataStore save through UpdateAsync')\n check(store.values.u_987654321.Session.Token==a.session,'Session lock retained during save')\n a:release(player);check(store.values.u_987654321.Session==nil,'Leave releases session lock')\n local b=Profiles.new(nil,store);local restored=b:load(player)\n check(restored.Coins==4321 and restored.Equipped=='GoldenStraw' and restored.Owned.GoldenStraw and restored.Upgrades.Backpack==3 and restored.Bag.PearlShell==2,'Rejoin restores every requested field')\n store.failures=1;restored.Coins=4322;check(b:save(player,false) and store.values.u_987654321.Data.Coins==4322,'Transient save failure retries successfully')\n store.values.u_987654321.Session.Token='another-server';local before=store.values.u_987654321.Data.Coins;restored.Coins=9000\n check(not b:save(player,false) and store.values.u_987654321.Data.Coins==before,'Lost session ownership never overwrites another server')\n print('STEP3_UNIT_COMPLETE',passed)\n return passed\nend\n"},{"name":"OceanProgress","class":"ModuleScript","source":"--!nonstrict\nreturn function()\n local V=require(game.ReplicatedStorage.SeaGame.Shared.OceanVolume)\n local C=require(game.ReplicatedStorage.SeaGame.Shared.Config).Ocean\n local L=require(game.ServerScriptService.SeaGame.OceanLedger)\n local P=require(game.ServerScriptService.SeaGame.OceanProgress)\n local http=game.HttpService;local passed=0\n local function copy(value) return if value==nil then nil else http:JSONDecode(http:JSONEncode(value)) end\n local function check(ok,name) assert(ok,'FAILED: '..name);passed+=1;print('OCEAN_TEST_PASS',name) end\n local function near(a,b) return math.abs(a-b)<.0000001 end\n local total=C.TotalOceanVolume\n local fractional=total*.000004\n check(near(V.percent(total-fractional,total),99.9996),'100.0000 to 99.9996 is preserved internally')\n check(string.format('%.2f',V.percent(total-fractional,total))=='100.00','Two-decimal formatting does not alter the source value')\n check(near(V.atLevel(V.level(total-fractional,total,C.initial,C.minimum),total,C.initial,C.minimum),total-fractional),'Precise volume and physical height round trip')\n check(V.percent(0,total)==0 and V.percent(total,total)==100,'Exact endpoints')\n check(V.flow(0/0,200,80000)==0 and V.flow(math.huge,200,80000)==0,'Invalid flow rejected')\n local catalog=require(game.ReplicatedStorage.SeaGame.Shared.Config).Straws\n local strongest=catalog[#catalog];local upgraded=strongest.power*strongest.speed*4*2.5\n check(V.flow(upgraded,C.BaseRemovalRate,C.MaxRemovalRate)==upgraded*C.BaseRemovalRate,'Strongest single-player upgrades are preserved')\n local starter=catalog[1]\n local seconds=total*.0001/(C.BaseRemovalRate*starter.power*starter.speed)\n check(near(seconds,39.6361728),'Expanded ocean takes about forty seconds per 0.01 percent with the unchanged starter')\n local now=1000\n local store={values={},failBefore=false,failAfter=false,conflict=nil}\n function store:GetAsync(key)\n  if self.failReads then error('Injected read outage') end\n  return copy(self.values[key])\n end\n function store:UpdateAsync(key,transform)\n  if self.failBefore then self.failBefore=false;error('Injected outage before commit') end\n  local result=transform(copy(self.values[key]))\n  if self.conflict then local inject=self.conflict;self.conflict=nil;inject();result=transform(copy(self.values[key])) end\n  if result~=nil then self.values[key]=copy(result) end\n  if self.failAfter then self.failAfter=false;error('Injected lost response after successful commit') end\n  return copy(result)\n end\n local function server(id,shard) local p=P.new({store=store,id=id,shard=shard,now=function() return now end,noMessaging=true});p:load();return p end\n local a=server('ServerA',1);local b=server('ServerB',1)\n check(a.ready and b.ready and a.remaining==total,'Two servers load one shared ocean')\n a:consume(200.125);b:consume(300.25)\n store.conflict=function() assert(b:flush()) end\n check(a:flush(),'Conflicting UpdateAsync callback retries successfully')\n check(near(store.values[a:key(1)].removed,500.375),'Concurrent servers add deltas without overwriting')\n a:poll(1);b:poll(1)\n check(a.remaining==b.remaining,'Servers reconcile to the same volume')\n local prior=a.remaining;a:consume(.00004);store.failAfter=true\n check(not a:flush() and a.blocked,'Ambiguous commit pauses further draining')\n check(a.remaining==prior,'Unacknowledged progress is not displayed optimistically')\n check(a:consume(100)==0,'No unsaved removal during an outage')\n local committed=store.values[a:key(1)].removed\n check(a:flush() and store.values[a:key(1)].removed==committed,'Retry after lost acknowledgement does not double count')\n check(near(a.remaining,total-500.37504),'Sub-centesimal delta survives serialization and retry')\n local c=server('ServerC',2);c:consume(1234.56789);check(c:flush(),'Independent shard commits')\n a:poll(2);local merged=a.remaining\n check(near(merged,total-1734.94293),'Shard contributions merge without losing fractional volume')\n a:absorb(2,{version=1,removed=1,sessions={}})\n check(a.remaining==merged,'Old or out-of-order message cannot refill the ocean')\n local rejoined=server('RejoinedServer',3)\n check(near(rejoined.remaining,merged),'A new server restores all existing contributions')\n a:consume(11.75);store.failBefore=true\n check(not a:flush(),'Failure before commit is retained for retry')\n check(a:flush() and near(store.values[a:key(1)].removed,512.12504),'Pending batch is saved exactly once after recovery')\n local stale=L.claim(nil,'expired',now,120);stale=L.commit(stale,'expired',1,77.25,now,120,total)\n local unchanged=L.commit(stale,'expired',1,77.25,now+121,120,total)\n check(unchanged.removed==77.25 and unchanged.sessions.expired==nil,'Expired lease cannot replay an old delta')\n local duplicate=L.commit(stale,'expired',1,77.25,now+2,120,total)\n check(duplicate.removed==stale.removed and stale.sessions.expired.expires==now+120,'Retry transform is idempotent and does not mutate input')\n local outOfOrder=L.commit(stale,'expired',4,1000,now+3,120,total)\n check(outOfOrder.removed==77.25,'Skipped sequence is rejected')\n local finish=L.commit(stale,'expired',2,total*3,now+3,120,total)\n check(finish.removed==total and V.remaining(total,finish.removed)==0,'Global completion clamps exactly at zero')\n local disconnected=server('Disconnected',4);disconnected:consume(22.5);disconnected:close()\n local last=server('AfterShutdown',5)\n check(near(last.remaining,total-1769.19293),'Shutdown flush survives a later server load')\n store.failReads=true;local unavailable=P.new({store=store,id='ReadFailure',noMessaging=true})\n check(not pcall(function() unavailable:load() end) and not unavailable.ready,'Read error never falls back to a new full ocean')\n store.failReads=false\n check(not pcall(function() L.commit({removed='bad'},'x',1,5,now,120,total) end),'Corrupt stored data is never silently overwritten')\n store.values[a:key(15)]={version=1,removed='corrupt',sessions={}}\n local corrupt=P.new({store=store,id='CorruptReader',noMessaging=true})\n check(not pcall(function() corrupt:load() end) and not corrupt.ready and store.values[a:key(15)].removed=='corrupt','Invalid saved shard cannot be replaced with zero progress')\n print('OCEAN_UNIT_COMPLETE',passed)\n return passed\nend\n"}]]====]);for _,entry in sources do local targetParent=if entry.class=='LocalScript' then game:GetService('StarterPlayer').StarterPlayerScripts else parent;local name=if entry.class=='LocalScript' then 'SeaGameClient' else entry.name;local existing=targetParent:FindFirstChild(name);if existing and existing.ClassName~=entry.class then existing:Destroy();existing=nil end;local object=existing or Instance.new(entry.class);object.Name=name;object.Source=entry.source;object.Parent=targetParent end;print('GAMEPLAY_CODE_INSTALLED',group,#sources)