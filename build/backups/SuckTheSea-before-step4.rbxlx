				<Item class="ModuleScript" referent="RBXC60B6EE53D264350A71D4D9C504ACCE4">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
local TweenService=game:GetService('TweenService')
local T=require(script.Parent.Theme)
local C={}
function C.new(class,properties,parent)
 local object=Instance.new(class);for k,v in properties do object[k]=v end;object.Parent=parent;return object
end
function C.corner(parent,radius) return C.new('UICorner',{CornerRadius=UDim.new(0,radius or 16)},parent) end
function C.stroke(parent,color,width) return C.new('UIStroke',{Color=color or T.Ink,Thickness=width or 2,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},parent) end
function C.tween(object,time,properties,style,direction)
 local tween=TweenService:Create(object,TweenInfo.new(time or .2,style or Enum.EasingStyle.Quart,direction or Enum.EasingDirection.Out),properties);tween:Play();return tween
end
function C.frame(parent,name,size,pos,color)
 return C.new('Frame',{Name=name,Size=size or UDim2.fromScale(1,1),Position=pos or UDim2.new(),BackgroundColor3=color or T.Paper,BorderSizePixel=0},parent)
end
function C.panel(parent,name,size,pos,color,radius)
 local p=C.frame(parent,name,size,pos,color);C.corner(p,radius);C.stroke(p,T.Ink,2);return p
end
function C.label(parent,text,size,pos,fontSize,color,font)
 return C.new('TextLabel',{Name='Label',BackgroundTransparency=1,Size=size,Position=pos or UDim2.new(),Text=text,Font=font or T.Body,TextSize=fontSize or 16,TextColor3=color or T.Ink,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center},parent)
end
function C.button(parent,name,text,size,pos,color,callback)
 local holder=C.frame(parent,name,size,pos);holder.BackgroundTransparency=1
 local shadow=C.frame(holder,'Shadow',UDim2.fromScale(1,1),UDim2.fromOffset(0,4),T.Ink);C.corner(shadow,12)
 local button=C.new('TextButton',{Name='Button',Size=UDim2.fromScale(1,1),BackgroundColor3=color or T.Teal,Text=text,TextColor3=T.Ink,Font=T.Font,TextSize=19,AutoButtonColor=false,BorderSizePixel=0,Selectable=true},holder)
 C.corner(button,12);C.stroke(button,T.Ink,2)
 C.new('UIGradient',{Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.new(1,1,1)),ColorSequenceKeypoint.new(1,Color3.fromRGB(227,239,231))}),Rotation=90},button)
 local scale=C.new('UIScale',{Scale=1},holder)
 button.MouseEnter:Connect(function() C.tween(scale,.14,{Scale=1.025}) end)
 button.MouseLeave:Connect(function() C.tween(scale,.16,{Scale=1});C.tween(button,.16,{Position=UDim2.new()}) end)
 button.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then C.tween(scale,.09,{Scale=.96});C.tween(button,.09,{Position=UDim2.fromOffset(0,2)}) end end)
 button.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then C.tween(scale,.22,{Scale=1},Enum.EasingStyle.Back);C.tween(button,.12,{Position=UDim2.new()}) end end)
 if callback then button.Activated:Connect(callback) end
 return holder,button,scale
end
function C.viewport(parent,category,id,size,pos)
 local frame=C.new('ViewportFrame',{Name='Art_'..id,BackgroundTransparency=1,Size=size,Position=pos or UDim2.new(),Ambient=Color3.fromRGB(222,230,235),LightColor=Color3.fromRGB(255,250,234),LightDirection=Vector3.new(-1,-1,-1)},parent)
 local prefab=game:GetService('ReplicatedStorage').SeaGame.Assets[category]:FindFirstChild(id)
 if prefab then
  local world=C.new('WorldModel',{},frame);local model=prefab:Clone();model.Parent=world
  local cf,bounds=model:GetBoundingBox();local camera=C.new('Camera',{FieldOfView=30},frame);frame.CurrentCamera=camera
  local radius=math.max(bounds.X,bounds.Y,bounds.Z);local distance=radius*2.15
  camera.CFrame=CFrame.lookAt(cf.Position+Vector3.new(distance*.28,distance*.2,distance),cf.Position)
 end
 return frame
end
function C.number(value)
 local n=tostring(math.floor(value+.5));return n:reverse():gsub('(%d%d%d)','%1,'):reverse():gsub('^,','')
end
function C.waveIcon(parent,pos)
 local icon=C.frame(parent,'WaveIcon',UDim2.fromOffset(38,38),pos,T.DeepTeal);C.corner(icon,12)
 -- An original small vector wave, drawn from rounded strokes rather than emoji.
 local function line(points,width,color)
  for i=1,#points-1 do
   local a,b=points[i],points[i+1];local d=b-a
   local segment=C.frame(icon,'Foam',UDim2.fromOffset(d.Magnitude+width,width),UDim2.fromOffset((a.X+b.X)/2,(a.Y+b.Y)/2),color)
   segment.AnchorPoint=Vector2.new(.5,.5);segment.Rotation=math.deg(math.atan2(d.Y,d.X));C.corner(segment,width/2)
  end
 end
 line({Vector2.new(6,23),Vector2.new(11,23),Vector2.new(15,20),Vector2.new(17,13),Vector2.new(20,10),Vector2.new(24,10),Vector2.new(28,13),Vector2.new(28,17),Vector2.new(25,19),Vector2.new(22,18),Vector2.new(22,15),Vector2.new(24,14)},2.8,T.White)
 line({Vector2.new(6,29),Vector2.new(12,27),Vector2.new(18,29),Vector2.new(24,27),Vector2.new(31,29)},2.3,T.Aqua)
 return icon
end
function C.pill(parent,text,color,size,pos)
 local p=C.frame(parent,'Pill',size,pos,color);C.corner(p,8);local l=C.label(p,text,UDim2.fromScale(1,1),nil,12,T.Ink,T.Bold);l.TextXAlignment=Enum.TextXAlignment.Center;return p
end
return C
]]></ProtectedString>
						<string name="ScriptGuid">{50E20F3E-6629-45BC-AE89-DCDCAA8B2B14}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Components</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000013db</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX76318125EFFF4BF897E5F7F5142E8964">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players');local UserInputService=game:GetService('UserInputService');local ContextActionService=game:GetService('ContextActionService');local RunService=game:GetService('RunService');local ProximityPromptService=game:GetService('ProximityPromptService');local StarterGui=game:GetService('StarterGui')
local Package=game:GetService('ReplicatedStorage').SeaGame;local Config=require(Package.Shared.Config)
local UI=require(script.Parent.UI);local Effects=require(script.Parent.Effects)
local Controller={};Controller.__index=Controller
function Controller.new()
 local self=setmetatable({holding=false,near=false,point=nil,pulse=0,scan=0,busy=false,prompts={},world={level=0},state=nil},Controller)
 self.player=Players.LocalPlayer;self.remotes=Package.Remotes
 self.ui=UI.new({action=function(action,payload) self:action(action,payload) end,stop=function() self:stop() end})
 self.fx=Effects.new(self.ui)
 return self
end
function Controller:stop()
 if self.holding then self.holding=false;self.remotes.Suction:FireServer(false);self.fx:stop(self.player.UserId) end
 self.ui:hintState(self.near,false)
end
function Controller:begin()
 if self.ui.shop or UserInputService:GetFocusedTextBox() or not self.point then return false end
 local character=self.player.Character;local human=character and character:FindFirstChildOfClass('Humanoid');local tool=character and character:FindFirstChildOfClass('Tool')
 if not human or human.Health<=0 or not tool or not tool:GetAttribute('SeaStraw') then return false end
 if self.world.ready==false or self.world.saveStatus=='Retrying' or self.world.refilling or self.world.complete then return false end
 self.holding=true;self.pulse=0;self.remotes.Suction:FireServer(self.point);self.ui:hintState(true,true);return true
end
function Controller:waterPoint()
 local character=self.player.Character;local root=character and character:FindFirstChild('HumanoidRootPart');if not root then return nil end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={character,workspace.NPCs,workspace:FindFirstChild('LiveLoot'),self.fx.folder};params.IgnoreWater=false;params.RespectCanCollide=true
 local camera=workspace.CurrentCamera;local cursor=UserInputService:GetMouseLocation();local ray=camera:ViewportPointToRay(cursor.X,cursor.Y)
 local target=workspace:Raycast(ray.Origin,ray.Direction*300,params)
 if target and target.Material==Enum.Material.Water and (target.Position-root.Position).Magnitude<Config.SuctionReach-1 then return Vector3.new(target.Position.X,self.world.level,target.Position.Z) end
 -- Touch and gamepad aim at the closest visible water; the same check also makes shore aiming forgiving.
 local best,bestDistance=nil,Config.SuctionReach-1
 for radius=6,24,6 do
  for i=0,11 do
   local angle=i*math.pi/6;local p=Vector3.new(root.Position.X+math.sin(angle)*radius,self.world.level,root.Position.Z+math.cos(angle)*radius)
   local distance=(root.Position-p).Magnitude
   if distance<bestDistance then
    local hit=workspace:Raycast(p+Vector3.new(0,2,0),Vector3.new(0,-5,0),params)
    if hit and hit.Material==Enum.Material.Water then
     local wall=workspace:Raycast(root.Position,p-root.Position,params)
     if not wall or wall.Material==Enum.Material.Water or (wall.Position-p).Magnitude<1.2 then best=p;bestDistance=distance end
    end
   end
  end
 end
 return best
end
function Controller:stateChanged(state)
 if not state or (self.state and state.revision<self.state.revision) then return end
 self.state=state;self.ui:update(state)
end
function Controller:action(action,payload)
 if self.busy then return end;self.busy=true;self.fx:click()
 task.spawn(function()
  local ok,result=pcall(function() return self.remotes.Request:InvokeServer(action,payload) end)
  self.busy=false
  if not ok then self.ui:toastMessage('Connection interrupted. Please try again.','warning');return end
  if result.state then self:stateChanged(result.state) end
  if not result.ok then self.ui:toastMessage(result.message or 'Try again.','warning') elseif action~='SellAll' and action~='Upgrade' and action~='BuyStraw' and action~='ToggleHeld' then self.ui:toastMessage(result.message or 'Ready!','success') end
 end)
end
function Controller:start()
 Controller.current=self
 pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack,false) end)
 pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false) end)
 task.spawn(function() pcall(function() game:GetService('ContentProvider'):PreloadAsync({Package.Assets.Tools,Package.Assets.Icons}) end) end)
 self.remotes.State.OnClientEvent:Connect(function(state) self:stateChanged(state) end)
 self.remotes.World.OnClientEvent:Connect(function(world) self.world=world;self.ui:updateWorld(world);if world.refilling or world.complete then self:stop() end end)
 self.remotes.FX.OnClientEvent:Connect(function(kind,payload)
  if kind=='OpenShop' then self:stop();for _,g in self.prompts do g.Enabled=false end;self.ui:open(payload.shop)
  elseif kind=='Notice' then self.ui:toastMessage(payload.message,payload.kind)
  elseif kind=='SuctionStart' then self.fx:start(payload)
  elseif kind=='SuctionStop' then self.fx:stop(payload.player);if payload.player==self.player.UserId then self.holding=false end
  elseif kind=='SuctionAim' then self.fx:aim(payload)
  elseif kind=='Pickup' then self.fx:pickup(payload)
  elseif kind=='ChestOpened' then self.fx:chestOpened(payload)
  elseif kind=='Sale' then self.ui:sale(payload.amount);for i,pitch in {1,1.25,1.5,2} do task.delay((i-1)*.09,function() self.fx:sound(Config.Audio.Collect,pitch,.2) end) end
  elseif kind=='Upgrade' then self.fx:upgrade() end
 end)
 ContextActionService:BindActionAtPriority('SeaSip',function(_,state,input)
  if state==Enum.UserInputState.Begin then if self:begin() then return Enum.ContextActionResult.Sink end
  elseif state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel then if self.holding then self:stop();return Enum.ContextActionResult.Sink end end
  return Enum.ContextActionResult.Pass
 end,false,Enum.ContextActionPriority.High.Value+10,Enum.UserInputType.MouseButton2,Enum.KeyCode.ButtonR2)
 ContextActionService:BindActionAtPriority('ToggleSeaStraw',function(_,state)
  if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
  if state==Enum.UserInputState.Begin then self:stop();self:action('ToggleHeld') end
  return Enum.ContextActionResult.Sink
 end,false,Enum.ContextActionPriority.High.Value+12,Enum.KeyCode.One,Enum.KeyCode.ButtonY)
 ContextActionService:BindAction('CloseSeaShop',function(_,state) if state==Enum.UserInputState.Begin and self.ui.shop then self.ui:close();return Enum.ContextActionResult.Sink end;return Enum.ContextActionResult.Pass end,false,Enum.KeyCode.Escape,Enum.KeyCode.ButtonB)
 self.ui.touchButton.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then self.touchInput=input;self:begin() end end)
 UserInputService.InputEnded:Connect(function(input) if input==self.touchInput or input.UserInputType==Enum.UserInputType.MouseButton2 or input.KeyCode==Enum.KeyCode.ButtonR2 then self.touchInput=nil;self:stop() end end)
 UserInputService.WindowFocusReleased:Connect(function() self:stop() end);UserInputService.TextBoxFocused:Connect(function() self:stop() end)
 self.player.CharacterAdded:Connect(function(character) self:stop();self.ui:close();local humanoid=character:WaitForChild('Humanoid');humanoid.Died:Connect(function() self:stop();self.ui:close() end) end)
 ProximityPromptService.PromptShown:Connect(function(prompt,inputType) if prompt.Style~=Enum.ProximityPromptStyle.Custom then return end;local gui=self.ui:prompt(prompt,inputType);if gui then self.prompts[prompt]=gui end end)
 ProximityPromptService.PromptHidden:Connect(function(prompt) local g=self.prompts[prompt];if g then g:Destroy();self.prompts[prompt]=nil end end)
 RunService.Heartbeat:Connect(function(dt)
  self.scan+=dt;self.pulse+=dt
  if self.scan>=.12 then
   local character=self.player.Character;local tool=character and character:FindFirstChildOfClass('Tool')
   local held=tool~=nil and tool:GetAttribute('SeaStraw')~=nil
   self.ui:setHeld(held)
   self.scan=0;self.point=if held then self:waterPoint() else nil;self.near=self.point~=nil
   if self.holding and (not self.near or self.ui.shop) then self:stop() end
   self.ui:hintState(self.near,self.holding)
   for prompt,g in self.prompts do if prompt.Parent then g.Enabled=self.ui.shop==nil end end
   if self.ui.shop then local root=self.player.Character and self.player.Character:FindFirstChild('HumanoidRootPart');local npc=workspace.NPCs:FindFirstChild(Config.ShopNames[self.ui.shop]);if not root or not npc or (root.Position-npc:GetPivot().Position).Magnitude>Config.ShopDistance+2 then self.ui:close() end end
  end
  if self.holding and self.pulse>=.35 then self.pulse=0;self.remotes.Suction:FireServer(self.point) end
 end)
 task.spawn(function()
  for _=1,20 do local ok,result=pcall(function() return self.remotes.Request:InvokeServer('State') end);if ok and result.state then self:stateChanged(result.state);break end;task.wait(.6) end
 end)
 print('[SeaGame] Client ready')
end
return Controller
]]></ProtectedString>
						<string name="ScriptGuid">{2E09FD5D-BEEC-4E5B-AB8F-F741B8A07800}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Controller</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000013dd</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX6F571FD941FD4CA390D7F05EC92E67BC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
local Players=game:GetService('Players');local RunService=game:GetService('RunService');local Debris=game:GetService('Debris');local SoundService=game:GetService('SoundService')
local Package=game:GetService('ReplicatedStorage').SeaGame;local Config=require(Package.Shared.Config);local C=require(script.Parent.Components);local T=require(script.Parent.Theme)
local Effects={};Effects.__index=Effects
local function part(parent,name,size,color)
 return C.new('Part',{Name=name,Size=size,Color=color,Material=Enum.Material.SmoothPlastic,Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false},parent)
end
function Effects.new(ui)
 local self=setmetatable({ui=ui,streams={},loot={},flights={},rings={},clock=0,lootClock=0},Effects)
 self.folder=C.new('Folder',{Name='LocalSeaEffects'},workspace)
 local horizon=workspace.Ocean:FindFirstChild('DistantSea')
 if horizon then
  local function levelChanged() local level=workspace.Ocean:GetAttribute('WaterLevel') or 0;for _,p in horizon:GetChildren() do if p:IsA('BasePart') then p.Position=Vector3.new(p.Position.X,level-.08,p.Position.Z) end end end
  workspace.Ocean:GetAttributeChangedSignal('WaterLevel'):Connect(levelChanged);levelChanged()
 end
 local boat=workspace.Ocean:FindFirstChild('LittleBoat')
 if boat and boat:IsA('BasePart') then
  local original=boat.CFrame;local lowest=boat.Position.Y-boat.Size.Y/2
  local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.FilterDescendantsInstances={workspace.UnderwaterTerrain.Seafloor};params.IgnoreWater=true;params.RespectCanCollide=true
  local hit=workspace:Raycast(Vector3.new(original.X,10,original.Z),Vector3.new(0,-110,0),params)
  local floorDelta=if hit then hit.Position.Y-lowest else Config.Ocean.minimum
  local function floatBoat() local level=workspace.Ocean:GetAttribute('WaterLevel') or 0;C.tween(boat,.45,{CFrame=original+Vector3.new(0,math.max(level,floorDelta),0)}) end
  workspace.Ocean:GetAttributeChangedSignal('WaterLevel'):Connect(floatBoat);floatBoat()
 end
 local folder=workspace:WaitForChild('LiveLoot')
 local function watch(model) if not model:IsA('Model') then return end;task.defer(function()
  if not model.Parent then return end
  local ground=model:GetAttribute('GroundPosition');if not ground then return end
  local visuals={};for _,p in model:GetDescendants() do if p:IsA('BasePart') and p.Name~='PickupRoot' then table.insert(visuals,{part=p,offset=p.CFrame-model:GetPivot().Position}) end end
  local rarity=model:GetAttribute('Rarity');local definition=Config.LootById[model:GetAttribute('LootId')]
  if definition and (rarity=='RARE' or rarity=='LEGENDARY') and visuals[1] then
   C.new('Highlight',{Name='TreasureGleam',Adornee=model,FillColor=definition.color,OutlineColor=definition.color,FillTransparency=.9,OutlineTransparency=.55,DepthMode=Enum.HighlightDepthMode.Occluded},model)
   local a=C.new('Attachment',{Name='TreasureSparkles'},visuals[1].part)
   C.new('ParticleEmitter',{Name='GentleSparkles',Texture='rbxasset://textures/particles/sparkles_main.dds',Color=ColorSequence.new(definition.color),LightEmission=.85,Rate=4,Lifetime=NumberRange.new(.65,1.15),Speed=NumberRange.new(.25,.65),SpreadAngle=Vector2.new(180,180),Acceleration=Vector3.new(0,.3,0),Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.25,.16),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.2),NumberSequenceKeypoint.new(1,1)})},a)
  end
  local elapsed=math.max(0,workspace:GetServerTimeNow()-(model:GetAttribute('BornAt') or workspace:GetServerTimeNow()))
  self.loot[model]={ground=ground,base=model:GetPivot(),born=os.clock()-elapsed,visuals=visuals,burst=model:GetAttribute('BurstOrigin')}
 end) end
 folder.ChildAdded:Connect(watch);folder.ChildRemoved:Connect(function(model) self.loot[model]=nil end);for _,m in folder:GetChildren() do watch(m) end
 self.connection=RunService.RenderStepped:Connect(function(dt) self:step(math.min(dt,.1)) end)
 return self
end
function Effects:sound(id,pitch,volume,parent,looped)
 local sound=C.new('Sound',{SoundId=id,Volume=volume or .18,PlaybackSpeed=pitch or 1,Looped=looped or false,RollOffMaxDistance=65},parent or SoundService);sound:Play();if not looped then Debris:AddItem(sound,3) end;return sound
end
function Effects:click() self:sound(Config.Audio.Click,1.35,.14) end
function Effects:upgrade()
 for i,pitch in {1,1.25,1.5} do task.delay((i-1)*.1,function() self:sound(Config.Audio.Collect,pitch,.2) end) end
 self.ui:toastMessage('A little stronger. A little further!','success')
end
function Effects:stop(userId)
 local stream=self.streams[userId];if not stream then return end;self.streams[userId]=nil
 for _,ik in stream.iks do C.tween(ik,.22,{Weight=0});Debris:AddItem(ik,.25) end
 for _,target in stream.targets do Debris:AddItem(target,.3) end
 if stream.sound then C.tween(stream.sound,.25,{Volume=0});Debris:AddItem(stream.sound,.3) end
 if stream.tool and stream.tool.Parent then C.tween(stream.tool,.25,{Grip=stream.grip}) end
 C.tween(stream.beam,.2,{Width0=0,Width1=0});Debris:AddItem(stream.anchor,.23)
 for _,bubble in stream.bubbles do C.tween(bubble.part,.16,{Transparency=1,Size=Vector3.one*.03});Debris:AddItem(bubble.part,.2) end
 if userId==Players.LocalPlayer.UserId and stream.camera then C.tween(stream.camera,.35,{FieldOfView=stream.fov}) end
end
function Effects:start(payload)
 self:stop(payload.player)
 local player=Players:GetPlayerByUserId(payload.player);local character=player and player.Character
 if player~=Players.LocalPlayer then
  local root=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart');local count=0;for _ in self.streams do count+=1 end
  if not root or (root.Position-payload.point).Magnitude>150 or count>=8 then return end
 end
 local tool=character and character:FindFirstChildOfClass('Tool');local handle=tool and tool:FindFirstChild('Handle');local tip=handle and handle:FindFirstChild('SuctionTip');local human=character and character:FindFirstChildOfClass('Humanoid');local head=character and character:FindFirstChild('Head')
 if not tip or not human or not head then return end
 local anchor=part(self.folder,'WaterIntake',Vector3.one*.1,T.Teal);anchor.Transparency=1;anchor.CFrame=CFrame.new(payload.point)
 local from=C.new('Attachment',{CFrame=CFrame.Angles(0,0,math.pi/2)},anchor)
 tip.Orientation=Vector3.new(0,0,-90)
 local beam=C.new('Beam',{Name='SuctionStream',Attachment0=from,Attachment1=tip,Width0=0,Width1=0,Segments=16,FaceCamera=true,LightEmission=.3,Color=ColorSequence.new(T.Aqua,T.Teal),Transparency=NumberSequence.new(.18)},anchor)
 C.tween(beam,.25,{Width0=.16,Width1=.09})
 local stream={player=player,character=character,tool=tool,grip=tool.Grip,tip=tip,anchor=anchor,beam=beam,point=payload.point,targetPoint=payload.point,bubbles={},iks={},targets={},phase=0,ripple=0}
 for _,side in {'Right','Left'} do
  local upper=character:FindFirstChild(side..'UpperArm');local hand=character:FindFirstChild(side..'Hand')
  if upper and hand then
   local target=C.new('Attachment',{Name='SipPoseTarget',CFrame=CFrame.new(if side=='Right' then .66 else -.18,-1.1,if side=='Right' then -.8 else -1.08)*CFrame.Angles(0,0,if side=='Right' then math.rad(9) else math.rad(-18))},head)
   local ik=C.new('IKControl',{Name='Sip'..side,Type=Enum.IKControlType.Transform,ChainRoot=upper,EndEffector=hand,Target=target,Weight=0,SmoothTime=.16,Priority=2},human)
   table.insert(stream.iks,ik);table.insert(stream.targets,target);C.tween(ik,.32,{Weight=if side=='Right' then 1 else .8})
  end
 end
 for i=1,16 do local b=part(self.folder,'WaterBubble',Vector3.one*.13,T.Aqua);b.Shape=Enum.PartType.Ball;b.Transparency=.25;table.insert(stream.bubbles,{part=b,t=(i-1)/16,phase=i*2.4}) end
 stream.sound=self:sound(Config.Audio.Water,1.25,.08,anchor,true)
 if player==Players.LocalPlayer then stream.camera=workspace.CurrentCamera;stream.fov=stream.camera.FieldOfView;C.tween(stream.camera,.4,{FieldOfView=stream.fov+2}) end
 self.streams[payload.player]=stream
end
function Effects:aim(payload) local s=self.streams[payload.player];if s then s.targetPoint=payload.point elseif payload.player~=Players.LocalPlayer.UserId then self:start(payload) end end
function Effects:ripple(position)
 if #self.rings>=12 then return end
 local root=part(self.folder,'SipRipple',Vector3.one*.1,T.Aqua);root.Transparency=1;root.CFrame=CFrame.new(position+Vector3.new(0,.065,0))
 local attachments={};local beams={}
 for i=0,3 do
  local a=i*math.pi/2;local tangent=Vector3.new(-math.sin(a),0,math.cos(a));local cf=CFrame.fromMatrix(Vector3.new(math.cos(a),0,math.sin(a)),tangent,Vector3.yAxis)
  attachments[i+1]=C.new('Attachment',{CFrame=cf},root)
 end
 for i=1,4 do beams[i]=C.new('Beam',{Attachment0=attachments[i],Attachment1=attachments[i%4+1],Width0=.055,Width1=.055,CurveSize0=.5523,CurveSize1=.5523,Segments=8,FaceCamera=true,Color=ColorSequence.new(T.Aqua),Transparency=NumberSequence.new(.1)},root) end
 table.insert(self.rings,{root=root,attachments=attachments,beams=beams,age=0})
end
function Effects:pickup(payload)
 local item=Config.LootById[payload.loot];local player=Players:GetPlayerByUserId(payload.player);local root=player and player.Character and player.Character:FindFirstChild('HumanoidRootPart')
 if not item or not root then return end
 local prefab=Package.Assets.Loot:FindFirstChild(payload.loot);if not prefab then return end
 local model=prefab:Clone();model.Name='CollectedTreasure';model.Parent=self.folder;model:PivotTo(CFrame.new(payload.position))
 table.insert(self.flights,{model=model,origin=payload.position,target=root,age=0,duration=.68,scale=model:GetScale()})
 if player==Players.LocalPlayer then
  self:sound(Config.Audio.Collect,1.3+math.random()*.3,.22);self.ui:toastMessage('+1 '..item.name,if item.rarity=='LEGENDARY' or item.rarity=='RARE' then 'success' else 'info')
  if item.rarity=='LEGENDARY' or item.rarity=='RARE' then for i,pitch in {1.6,2} do task.delay(i*.09,function() self:sound(Config.Audio.Collect,pitch,.18) end) end end
 end
end
function Effects:chestOpened(payload)
 local root=part(self.folder,'ChestSparkleBurst',Vector3.one*.1,T.Gold);root.Transparency=1;root.Position=payload.position+Vector3.new(0,2,0)
 local spark=C.new('ParticleEmitter',{Texture='rbxasset://textures/particles/sparkles_main.dds',Color=ColorSequence.new(T.Gold,T.Cream),Rate=0,Lifetime=NumberRange.new(.6,1.1),Speed=NumberRange.new(3,7),SpreadAngle=Vector2.new(65,65),Acceleration=Vector3.new(0,-6,0),Drag=3,LightEmission=.8,Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.15),NumberSequenceKeypoint.new(.4,.25),NumberSequenceKeypoint.new(1,0)})},root)
 spark:Emit(24);Debris:AddItem(root,2)
 for i,pitch in {1,1.3,1.65,2} do task.delay((i-1)*.12,function() self:sound(Config.Audio.Collect,pitch,.23,root) end) end
end
function Effects:step(dt)
 self.clock+=dt;local now=os.clock()
 for userId,s in self.streams do
  if not s.tip.Parent or not s.character.Parent then self:stop(userId);continue end
  s.phase+=dt;s.point=s.point:Lerp(s.targetPoint,1-math.exp(-dt*14));s.anchor.Position=s.point
  local finish=s.tip.WorldPosition;local origin=s.point;local distance=(finish-origin).Magnitude
  s.beam.CurveSize0=math.min(distance*.28,5);s.beam.CurveSize1=math.min(distance*.15,2)
  s.tool.Grip=s.grip*CFrame.Angles(math.sin(s.phase*3.8)*.018,0,math.sin(s.phase*4.5)*.014)
  for _,bubble in s.bubbles do
   bubble.t=(bubble.t+dt*.75)%1;local t=bubble.t;local bend=(origin+finish)*.5+Vector3.new(0,math.min(distance*.3,4),0)
   local pos=(1-t)^2*origin+2*(1-t)*t*bend+t*t*finish
   local swirl=Vector3.new(math.cos(bubble.phase+t*13),0,math.sin(bubble.phase+t*13))*.4*(1-t)
   bubble.part.Position=pos+swirl;local size=(.10+math.sin(math.pi*t)*.09)*(1-t*.45);bubble.part.Size=Vector3.one*size;bubble.part.Transparency=.15+math.abs(t-.5)*.45
  end
  s.ripple+=dt;if s.ripple>.48 then s.ripple=0;self:ripple(origin) end
 end
 for i=#self.rings,1,-1 do
  local r=self.rings[i];r.age+=dt;local t=r.age/.9
  if t>=1 then r.root:Destroy();table.remove(self.rings,i) else
   local radius=.25+t*1.4
   for index,a in r.attachments do local angle=(index-1)*math.pi/2;a.Position=Vector3.new(math.cos(angle),0,math.sin(angle))*radius end
   for _,beam in r.beams do beam.CurveSize0=.5523*radius;beam.CurveSize1=.5523*radius;beam.Transparency=NumberSequence.new(.15+t*.85) end
  end
 end
 self.lootClock+=dt
 if self.lootClock>=1/30 then
  self.lootClock=0;local char=Players.LocalPlayer.Character;local root=char and char:FindFirstChild('HumanoidRootPart')
  for model,data in self.loot do
   if not model.Parent then self.loot[model]=nil;continue end
   if data.settled or (root and (data.ground-root.Position).Magnitude>125) then continue end
   local age=now-data.born;local rotation=0;local position=data.base.Position;local duration=if data.burst then 1.15 else .55
   if data.burst and age<duration then
    local t=math.clamp((age-.25)/.9,0,1);position=data.burst:Lerp(position,t)+Vector3.new(0,math.sin(t*math.pi)*3,0);rotation=(1-t)*math.pi*2
   elseif age<duration then position+=data.base.UpVector*math.sin(math.clamp(age/duration,0,1)*math.pi)*.32 end
   local cf=CFrame.new(position)*data.base.Rotation
   -- Only the artwork moves: the authoritative pickup position and prompt stay on the ground.
   for _,v in data.visuals do if v.part.Parent then v.part.CFrame=CFrame.new(cf.Position)*CFrame.Angles(0,rotation,0)*v.offset end end
   if age>=duration then data.settled=true end
  end
 end
 for i=#self.flights,1,-1 do
  local flight=self.flights[i];flight.age+=dt;local t=math.clamp(flight.age/flight.duration,0,1)
  if t>=1 or not flight.target.Parent then flight.model:Destroy();table.remove(self.flights,i) else
   local finish=flight.target.Position+Vector3.new(0,.7,0);local bend=(flight.origin+finish)*.5+Vector3.new(0,3.5,0)
   local pos=(1-t)^2*flight.origin+2*(1-t)*t*bend+t*t*finish
   flight.model:PivotTo(CFrame.new(pos)*CFrame.Angles(0,t*math.pi*2,math.sin(t*math.pi)*.2));flight.model:ScaleTo(flight.scale*(1-t*.82))
  end
 end
end
return Effects
]]></ProtectedString>
