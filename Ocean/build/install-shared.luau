assert(not game:GetService('RunService'):IsRunning(),'Install in Edit mode only');local function folder(parent,name) local f=parent:FindFirstChild(name);if not f then f=Instance.new('Folder');f.Name=name;f.Parent=parent end;return f end;local package=folder(game:GetService('ReplicatedStorage'),'SeaGame');local remotes=folder(package,'Remotes');for _,name in {'Request','State','World','FX','Suction'} do if not remotes:FindFirstChild(name) then local r=Instance.new(if name=='Request' then 'RemoteFunction' else 'RemoteEvent');r.Name=name;r.Parent=remotes end end;local group="Shared";local parent;if group=='Server' then parent=folder(game:GetService('ServerScriptService'),'SeaGame') elseif group=='Tests' then parent=folder(game:GetService('ServerStorage'),'SeaGameTests') else parent=folder(package,group) end;local sources=game:GetService('HttpService'):JSONDecode([====[[{"name":"Config","class":"ModuleScript","source":"--!strict\nlocal Config={}\nConfig.Version=1\nConfig.DataStoreName='SuckTheSea_Player_v1'\nConfig.Straws={\n {id='BasicStraw',name='Basic Straw',price=0,power=1.25,speed=1,reach=26,color=Color3.fromRGB(250,139,116),tag='STARTER'},\n {id='ColorfulStraw',name='Colorful Straw',price=150,power=2,speed=1.05,reach=27,color=Color3.fromRGB(49,190,175),tag='PLAYFUL'},\n {id='BambooStraw',name='Bamboo Straw',price=600,power=4,speed=1.1,reach=29,color=Color3.fromRGB(136,201,74),tag='NATURAL'},\n {id='GoldenStraw',name='Golden Straw',price=2000,power=8,speed=1.15,reach=30,color=Color3.fromRGB(255,200,87),tag='GOLDEN'},\n {id='CrystalStraw',name='Crystal Straw',price=7500,power=16,speed=1.2,reach=32,color=Color3.fromRGB(73,189,235),tag='CRYSTAL'},\n {id='OceanVacuum',name='Ocean Vacuum',price=25000,power=35,speed=1.25,reach=34,color=Color3.fromRGB(21,139,137),tag='TURBINE'},\n {id='CoralTwister',name='Coral Twister',price=65000,power=55,speed=1.3,reach=36,color=Color3.fromRGB(247,121,130),tag='CORAL'},\n {id='TidalCoil',name='Tidal Coil',price=160000,power=85,speed=1.4,reach=38,color=Color3.fromRGB(68,178,239),tag='TIDAL'},\n {id='StarSiphon',name='Star Siphon',price=420000,power=130,speed=1.45,reach=40,color=Color3.fromRGB(170,132,229),tag='CELESTIAL'},\n {id='Leviathan',name='Leviathan',price=1000000,power=200,speed=1.5,reach=42,color=Color3.fromRGB(32,116,131),tag='LEGENDARY'},\n}\n-- Robux entitlements are separate from the coin catalogue; IDs live in Offers.\nConfig.PremiumStraw={id='PrismStraw',name='Prism Straw',robux=79,power=35,speed=1.25,reach=34,comparisonTier=6,color=Color3.fromRGB(229,153,239),tag='PRISM',premium=true}\nConfig.AdminStraw={id='AdminStraw',name='Admin Straw',robux=1999,power=400,speed=1.6,reach=56,walk=48,jumpHeight=22,color=Color3.fromRGB(181,136,245),tag='ADMIN',premium=true}\nConfig.Restroom={PersonalOceanFraction=.05,UseSeconds=5,Distance=10,StarterMusselRespawn=45,Sound='rbxassetid://9126175899'}\nConfig.Loot=require(script.Parent.LootCatalog)\nConfig.StrawById={};for _,item in Config.Straws do Config.StrawById[item.id]=item end\nConfig.StrawById.PrismStraw=Config.PremiumStraw;Config.StrawById.AdminStraw=Config.AdminStraw\nConfig.LootById={};for _,item in Config.Loot do Config.LootById[item.id]=item end\nConfig.Capacities={5,7,10,15,20}\nConfig.BackpackPrices={100,300,800,2000}\nConfig.WalkSpeeds={16,18,20,23,26,30}\nConfig.WalkPrices={100,250,650,1400,3000}\nConfig.Upgrades={\n {id='Power',name='Suction Power',description='+20% power per level',icon='Power',max=15},\n {id='Speed',name='Suction Speed',description='+10% suction speed per level',icon='Speed',max=15},\n {id='Walk',name='Walk Speed',description='Explore the shore faster',icon='Walk',max=5},\n {id='Backpack',name='Backpack',description='Bring back more treasure',icon='Backpack',max=4},\n}\nConfig.UpgradeById={};for _,u in Config.Upgrades do Config.UpgradeById[u.id]=u end\nConfig.ShopNames={Straws='Finn',Upgrades='Maya',Sell='Captain Shell'}\nConfig.ShopDistance=23\nConfig.PickupDistance=8\nConfig.SuctionReach=26\nConfig.Ocean={\n initial=0,minimum=-168,bottom=-172,halfSize=384,\n -- Drainable volume of the expanded 768 x 768 x 168 stud ocean. Full precision.\n TotalOceanVolume=99_090_432,BaseRemovalRate=200,MaxRemovalRate=1_600_000,\n ProgressStore='SuckTheSea_Ocean_v1',WorldKey='StarterOcean_v1',ShardCount=16,\n CommitInterval=8,PollInterval=2,LeaseSeconds=120,\n updatePeriod=.6,updateDistance=.000001,\n maxActiveLoot=56,lootSpacing=6,lootRadius=342,lootMargin=.12,\n}\nConfig.Audio={Click='rbxasset://sounds/volume_slider.ogg',Collect='rbxasset://sounds/volume_slider.ogg',Water='rbxasset://sounds/action_swim.mp3',Splash='rbxasset://sounds/impact_water.mp3'}\nreturn table.freeze(Config)\n"},{"name":"DepthZones","class":"ModuleScript","source":"--!strict\n-- 3.2 studs = one gameplay metre. All depth gates are absolute below the initial sea.\nlocal Zones={Seed=573215,StudsPerMetre=3.2,ZoneHeight=32}\nZones.Rarities={'COMMON','UNCOMMON','RARE','EPIC','LEGENDARY'}\nZones.List={\n {name='Shallow Shores',minimum=0,weights={COMMON=78,UNCOMMON=22,RARE=0,EPIC=0,LEGENDARY=0},color=Color3.fromRGB(238,208,149)},\n {name='Coral Gardens',minimum=32,weights={COMMON=55,UNCOMMON=32,RARE=13,EPIC=0,LEGENDARY=0},color=Color3.fromRGB(248,149,161)},\n {name='Sunken Treasures',minimum=64,weights={COMMON=48,UNCOMMON=32,RARE=16,EPIC=4,LEGENDARY=0},color=Color3.fromRGB(237,194,99)},\n {name='Ancient Reef',minimum=96,weights={COMMON=42,UNCOMMON=31,RARE=20,EPIC=7,LEGENDARY=0},color=Color3.fromRGB(165,163,226)},\n {name='Abyssal Treasures',minimum=128,weights={COMMON=36,UNCOMMON=30,RARE=23,EPIC=9.5,LEGENDARY=1.5},color=Color3.fromRGB(86,208,214)},\n}\nfunction Zones.index(depth:number):number return math.clamp(math.floor(math.max(0,depth)/Zones.ZoneHeight)+1,1,5) end\nfunction Zones.roll(catalog,random,depth:number,minimumValue:number?):string?\n local zone=Zones.index(depth);local definition=Zones.List[zone];local minimum=minimumValue or 0\n local groups={};local totalRarity=0;local lastRarity=nil\n for _,rarity in Zones.Rarities do\n  local items={};local weight=0\n  for _,item in catalog do\n   if item.weight>0 and item.rarity==rarity and (item.minZone or 1)<=zone and item.value>=minimum then\n    -- Favour the zone's own finds without removing inexpensive earlier discoveries.\n    local w=item.weight*(if item.minZone==zone then 2.5 else 1)\n    weight+=w;table.insert(items,{item=item,weight=w})\n   end\n  end\n  local chance=definition.weights[rarity]\n  if weight>0 and chance>0 then groups[rarity]={items=items,total=weight};totalRarity+=chance;lastRarity=rarity end\n end\n if totalRarity<=0 then return nil end\n local pick=random:NextNumber()*totalRarity;local chosen=lastRarity\n for _,rarity in Zones.Rarities do if groups[rarity] then pick-=definition.weights[rarity];if pick<=0 then chosen=rarity;break end end end\n local group=groups[chosen];local roll=random:NextNumber()*group.total\n for _,entry in group.items do roll-=entry.weight;if roll<=0 then return entry.item.id end end\n return group.items[#group.items].item.id\nend\nreturn table.freeze(Zones)\n"},{"name":"Economy","class":"ModuleScript","source":"--!strict\nlocal Config=require(script.Parent.Config)\nlocal DepthZones=require(script.Parent.DepthZones)\nlocal Economy={}\nlocal function integer(value:any,default:number,maximum:number):number\n if type(value)~='number' or value~=value or value==math.huge or value==-math.huge then return default end\n return math.clamp(math.floor(value),0,maximum)\nend\nfunction Economy.new()\n return {Version=Config.Version,Coins=0,Owned={BasicStraw=true},Equipped='BasicStraw',Upgrades={Power=0,Speed=0,Walk=0,Backpack=0},Bag={},Revision=0,NeedsWater=0,Receipts={}}\nend\nfunction Economy.capacity(data):number return Config.Capacities[data.Upgrades.Backpack+1] end\nfunction Economy.count(data):number local n=0;for id,count in data.Bag do if Config.LootById[id] then n+=count end end;return n end\nfunction Economy.value(data):number local n=0;for id,count in data.Bag do local item=Config.LootById[id];if item then n+=item.value*count end end;return n end\nfunction Economy.normalize(raw:any)\n local data=Economy.new();if type(raw)~='table' then return data end\n data.Coins=integer(raw.Coins,0,1e12);data.Revision=integer(raw.Revision,0,1e12)\n if type(raw.Receipts)=='table' then for id,paid in raw.Receipts do if type(id)=='string' and #id<=150 and paid==true then data.Receipts[id]=true end end end\n if type(raw.NeedsWater)=='number' and raw.NeedsWater==raw.NeedsWater and math.abs(raw.NeedsWater)<math.huge then data.NeedsWater=math.clamp(raw.NeedsWater,0,Config.Ocean.TotalOceanVolume*Config.Restroom.PersonalOceanFraction) end\n if type(raw.Owned)=='table' then for id,value in raw.Owned do if Config.StrawById[id] and value==true then data.Owned[id]=true end end end\n if type(raw.Equipped)=='string' and data.Owned[raw.Equipped] then data.Equipped=raw.Equipped end\n if type(raw.Upgrades)=='table' then for _,u in Config.Upgrades do data.Upgrades[u.id]=integer(raw.Upgrades[u.id],0,u.max) end end\n local remaining=20\n if type(raw.Bag)=='table' then for _,item in Config.Loot do local count=integer(raw.Bag[item.id],0,remaining);if count>0 then data.Bag[item.id]=count;remaining-=count end end end\n while Economy.count(data)>Economy.capacity(data) and data.Upgrades.Backpack<4 do data.Upgrades.Backpack+=1 end\n return data\nend\nfunction Economy.copy(data)\n return {Version=Config.Version,Coins=data.Coins,Owned=table.clone(data.Owned),Equipped=data.Equipped,Upgrades=table.clone(data.Upgrades),Bag=table.clone(data.Bag),Revision=data.Revision,NeedsWater=data.NeedsWater,Receipts=table.clone(data.Receipts or {})}\nend\nfunction Economy.stats(data)\n local straw=Config.StrawById[data.Equipped]\n return {power=straw.power*(1+data.Upgrades.Power*.2),speed=straw.speed*(1+data.Upgrades.Speed*.1),reach=straw.reach,walk=Config.WalkSpeeds[data.Upgrades.Walk+1],capacity=Economy.capacity(data)}\nend\nfunction Economy.upgradeCost(data,id:string):number?\n local def=Config.UpgradeById[id];if not def then return nil end\n local level=data.Upgrades[id];if level>=def.max then return nil end\n if id=='Backpack' then return Config.BackpackPrices[level+1] end\n if id=='Walk' then return Config.WalkPrices[level+1] end\n return math.floor((if id=='Power' then 100 else 125)*(if id=='Power' then 1.65 else 1.7)^level)\nend\nfunction Economy.buyStraw(data,id:string)\n local item=Config.StrawById[id];if not item then return false,'Unknown straw.' end\n if item.premium then return false,'This straw is a Robux pass.' end\n if data.Owned[id] then return false,'You already own this straw.' end\n if data.Coins<item.price then return false,'Not enough Coins.' end\n data.Coins-=item.price;data.Owned[id]=true;data.Equipped=id;data.Revision+=1\n return true,'New straw equipped!',item.price\nend\nfunction Economy.equip(data,id:string)\n if not Config.StrawById[id] or not data.Owned[id] then return false,'You do not own this straw.' end\n if data.Equipped==id then return false,'Already equipped.' end\n data.Equipped=id;data.Revision+=1;return true,'Straw equipped!'\nend\nfunction Economy.upgrade(data,id:string)\n if not Config.UpgradeById[id] then return false,'Unknown upgrade.' end\n local price=Economy.upgradeCost(data,id);if not price then return false,'Fully upgraded!' end\n if data.Coins<price then return false,'Not enough Coins.' end\n data.Coins-=price;data.Upgrades[id]+=1;data.Revision+=1;return true,'Upgrade complete!',price\nend\nfunction Economy.addLoot(data,id:string)\n if not Config.LootById[id] then return false,'Unknown treasure.' end\n if Economy.count(data)>=Economy.capacity(data) then return false,'BACKPACK FULL!' end\n data.Bag[id]=(data.Bag[id] or 0)+1;data.Revision+=1;return true\nend\nfunction Economy.sell(data)\n local total=Economy.value(data);if total<=0 then return false,'Your backpack is empty.',0 end\n data.Bag={};data.Coins+=total;data.Revision+=1;return true,'Treasure sold!',total\nend\nfunction Economy.rollLoot(random,depth:number?,minimumValue:number?)\n return DepthZones.roll(Config.Loot,random,depth or 168,minimumValue)\nend\nreturn Economy\n"},{"name":"LootCatalog","class":"ModuleScript","source":"--!strict\n-- Stable IDs preserve inventory saves. Prices, zone gates and item weights are editable here.\nreturn {\n {id=\"StarterMussel\",name=\"Little Mussel\",weight=0,value=1,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"CommonShell\",name=\"Common Shell\",weight=28,value=10,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"Starfish\",name=\"Starfish\",weight=19,value=20,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"PearlShell\",name=\"Pearl Oyster\",weight=8,value=95,minDepth=32,minZone=2,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"OldBottle\",name=\"Old Bottle\",weight=5,value=100,minDepth=0,minZone=1,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"TreasureChest\",name=\"Treasure Chest\",weight=3,value=650,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"AncientRelic\",name=\"Ancient Relic\",weight=1,value=1600,minDepth=96,minZone=4,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"SunriseScallop\",name=\"Sunrise Scallop\",weight=18,value=18,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"SpiralShell\",name=\"Spiral Shell\",weight=14,value=32,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"CowrieShell\",name=\"Tiger Cowrie\",weight=12,value=38,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"NautilusShell\",name=\"Nautilus Shell\",weight=8,value=75,minDepth=0,minZone=1,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"ConeShell\",name=\"Violet Cone Shell\",weight=11,value=48,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"TurbanShell\",name=\"Turban Shell\",weight=9,value=65,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"BlueStar\",name=\"Rare Starfish\",weight=15,value=180,minDepth=32,minZone=2,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"BrittleStar\",name=\"Brittle Star\",weight=11,value=42,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"SandDollar\",name=\"Sand Dollar\",weight=16,value=24,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"SeaUrchin\",name=\"Sea Urchin\",weight=10,value=55,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"CoralFragment\",name=\"Coral Fragment\",weight=12,value=62,minDepth=32,minZone=2,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"SeaGlass\",name=\"Sea Glass\",weight=14,value=35,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"PinkPearl\",name=\"Small Pearl\",weight=5,value=230,minDepth=32,minZone=2,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"BlackPearl\",name=\"Rare Pearl\",weight=2,value=1250,minDepth=64,minZone=3,rarity=\"EPIC\",color=Color3.fromRGB(178,128,230)},\n {id=\"AmberStone\",name=\"Ocean Amber\",weight=8,value=95,minDepth=32,minZone=2,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"JadeBead\",name=\"Carved Jade Bead\",weight=6,value=120,minDepth=32,minZone=2,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"MessageBottle\",name=\"Message in a Bottle\",weight=5,value=165,minDepth=32,minZone=2,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"CeramicJug\",name=\"Ancient Vase\",weight=5,value=360,minDepth=64,minZone=3,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"PorcelainPlate\",name=\"Sailor Porcelain\",weight=6,value=145,minDepth=32,minZone=2,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"CopperCoin\",name=\"Copper Sea Coin\",weight=12,value=65,minDepth=32,minZone=2,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"SilverCoin\",name=\"Silver Crown Coin\",weight=8,value=150,minDepth=64,minZone=3,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"GoldDoubloon\",name=\"Gold Doubloon\",weight=5,value=340,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"CoralRing\",name=\"Coral Ring\",weight=4,value=240,minDepth=64,minZone=3,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"CaptainsRing\",name=\"Captain's Signet\",weight=2,value=650,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"RubyBrooch\",name=\"Ruby Sun Brooch\",weight=2,value=840,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"SapphirePendant\",name=\"Sapphire Pendant\",weight=2,value=920,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"BronzeKey\",name=\"Bronze Cabin Key\",weight=5,value=210,minDepth=64,minZone=3,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"AnchorCharm\",name=\"Anchor Charm\",weight=4,value=280,minDepth=64,minZone=3,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"Compass\",name=\"Golden Compass\",weight=3,value=850,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"PocketWatch\",name=\"Captain's Watch\",weight=3,value=520,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"Spyglass\",name=\"Brass Spyglass\",weight=3,value=480,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"ShipBell\",name=\"Ship Bell\",weight=2,value=720,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"CopperLantern\",name=\"Pearl Lantern\",weight=2,value=790,minDepth=64,minZone=3,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"RoyalCrown\",name=\"Golden Crown\",weight=1,value=3000,minDepth=96,minZone=4,rarity=\"EPIC\",color=Color3.fromRGB(178,128,230)},\n {id=\"GoldenChalice\",name=\"Golden Chalice\",weight=2,value=1800,minDepth=96,minZone=4,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"RubyCluster\",name=\"Ruby Cluster\",weight=3,value=980,minDepth=96,minZone=4,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"SapphireCluster\",name=\"Sapphire Cluster\",weight=3,value=1100,minDepth=96,minZone=4,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"AmethystCluster\",name=\"Amethyst Geode\",weight=2,value=2200,minDepth=96,minZone=4,rarity=\"EPIC\",color=Color3.fromRGB(178,128,230)},\n {id=\"AquamarineCluster\",name=\"Ocean Crystal\",weight=2,value=2400,minDepth=128,minZone=5,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"GoldenIdol\",name=\"Ancient Golden Idol\",weight=1,value=7200,minDepth=128,minZone=5,rarity=\"EPIC\",color=Color3.fromRGB(178,128,230)},\n {id=\"AncientTrident\",name=\"Ancient Trident\",weight=1,value=10000,minDepth=128,minZone=5,rarity=\"LEGENDARY\",color=Color3.fromRGB(255,199,75)},\n {id=\"AtlanteanTablet\",name=\"Lost Artifact\",weight=1,value=4200,minDepth=96,minZone=4,rarity=\"EPIC\",color=Color3.fromRGB(178,128,230)},\n {id=\"CrystalHeart\",name=\"Mythic Ocean Relic\",weight=0.6,value=20000,minDepth=128,minZone=5,rarity=\"LEGENDARY\",color=Color3.fromRGB(255,199,75)},\n {id=\"ObsidianFang\",name=\"Obsidian Fang\",weight=1.5,value=2600,minDepth=128,minZone=5,rarity=\"EPIC\",color=Color3.fromRGB(178,128,230)},\n {id=\"SmallCrabShell\",name=\"Small Crab Shell\",weight=15,value=15,minDepth=0,minZone=1,rarity=\"COMMON\",color=Color3.fromRGB(255,176,173)},\n {id=\"ColorfulShell\",name=\"Colorful Shell\",weight=14,value=140,minDepth=32,minZone=2,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"GoldenCoinPile\",name=\"Golden Coin Pile\",weight=14,value=300,minDepth=64,minZone=3,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"GiantPearl\",name=\"Giant Pearl\",weight=9,value=1800,minDepth=96,minZone=4,rarity=\"RARE\",color=Color3.fromRGB(75,173,234)},\n {id=\"LegendaryPearl\",name=\"Legendary Pearl\",weight=4,value=12000,minDepth=128,minZone=5,rarity=\"LEGENDARY\",color=Color3.fromRGB(255,199,75)},\n {id=\"CrystalCoral\",name=\"Crystal Coral\",weight=10,value=700,minDepth=96,minZone=4,rarity=\"UNCOMMON\",color=Color3.fromRGB(93,210,177)},\n {id=\"RoyalTreasureChest\",name=\"Royal Treasure Chest\",weight=6,value=5200,minDepth=128,minZone=5,rarity=\"EPIC\",color=Color3.fromRGB(178,128,230)},\n}\n"},{"name":"Needs","class":"ModuleScript","source":"--!strict\nlocal Config=require(script.Parent.Config)\nlocal Needs={}\nNeeds.Capacity=Config.Ocean.TotalOceanVolume*Config.Restroom.PersonalOceanFraction\nfunction Needs.percent(volume:number):number return math.clamp(volume/Needs.Capacity*100,0,100) end\nfunction Needs.availablePower(volume:number,desired:number,dt:number):number\n return math.min(desired,math.max(0,Needs.Capacity-volume)/(Config.Ocean.BaseRemovalRate*math.max(.000001,math.min(dt,.25))))\nend\n-- Attribute only locally accepted water, including the shared rate/remaining-volume caps.\nfunction Needs.share(consumed:number,contribution:number,totalPower:number):number\n if totalPower<=0 then return 0 end\n return math.max(0,consumed)*contribution/totalPower\nend\nreturn table.freeze(Needs)\n"},{"name":"OceanVolume","class":"ModuleScript","source":"--!strict\n-- Pure conversions. Only the UI is allowed to round a percentage for display.\nlocal Volume={}\nfunction Volume.finite(value:any):boolean\n return type(value)=='number' and value==value and math.abs(value)<math.huge\nend\nfunction Volume.remaining(total:number,removed:number):number return math.clamp(total-removed,0,total) end\nfunction Volume.percent(remaining:number,total:number):number return math.clamp(remaining/total*100,0,100) end\nfunction Volume.level(remaining:number,total:number,initial:number,minimum:number):number\n return minimum+(initial-minimum)*math.clamp(remaining/total,0,1)\nend\nfunction Volume.atLevel(level:number,total:number,initial:number,minimum:number):number\n return math.clamp((level-minimum)/(initial-minimum),0,1)*total\nend\nfunction Volume.flow(power:number,base:number,maximum:number):number\n if not Volume.finite(power) or power<=0 then return 0 end\n return math.min(base*power,maximum)\nend\nreturn table.freeze(Volume)\n"},{"name":"Offers","class":"ModuleScript","source":"--!strict\n-- Configure IDs from this experience. Zero keeps checkout safely unavailable.\nreturn table.freeze({\n {id='Coins500',name='Pocket of sunshine',coins=500,robux=39,kind='Product',assetId=0,art='Coin',color=Color3.fromRGB(255,205,83)},\n {id='Coins1000',name='Treasure stack',coins=1000,robux=89,kind='Product',assetId=0,art='CoinStack',color=Color3.fromRGB(68,203,177)},\n {id='Coins1500',name='Golden tide',coins=1500,robux=149,kind='Product',assetId=0,art='CoinVault',color=Color3.fromRGB(120,174,249)},\n {id='AdminBundle',name='ADMIN STRAW',coins=5000,robux=1999,kind='Pass',assetId=0,straw='AdminStraw',art='AdminStraw',color=Color3.fromRGB(183,133,244)},\n {id='Prism',name='PRISM STRAW',coins=0,robux=79,kind='Pass',assetId=0,straw='PrismStraw',art='PrismStraw',color=Color3.fromRGB(245,145,190)},\n})\n"}]]====]);for _,entry in sources do local targetParent=if entry.class=='LocalScript' then game:GetService('StarterPlayer').StarterPlayerScripts else parent;local name=if entry.class=='LocalScript' then 'SeaGameClient' else entry.name;local existing=targetParent:FindFirstChild(name);if existing and existing.ClassName~=entry.class then existing:Destroy();existing=nil end;local object=existing or Instance.new(entry.class);object.Name=name;object.Source=entry.source;object.Parent=targetParent end;print('GAMEPLAY_CODE_INSTALLED',group,#sources)