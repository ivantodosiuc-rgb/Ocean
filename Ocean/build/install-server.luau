assert(not game:GetService('RunService'):IsRunning(),'Install in Edit mode only');local function folder(parent,name) local f=parent:FindFirstChild(name);if not f then f=Instance.new('Folder');f.Name=name;f.Parent=parent end;return f end;local package=folder(game:GetService('ReplicatedStorage'),'SeaGame');local remotes=folder(package,'Remotes');for _,name in {'Request','State','World','FX','Suction'} do if not remotes:FindFirstChild(name) then local r=Instance.new(if name=='Request' then 'RemoteFunction' else 'RemoteEvent');r.Name=name;r.Parent=remotes end end;local group="Server";local parent;if group=='Server' then parent=folder(game:GetService('ServerScriptService'),'SeaGame') elseif group=='Tests' then parent=folder(game:GetService('ServerStorage'),'SeaGameTests') else parent=folder(package,group) end;local sources=game:GetService('HttpService'):JSONDecode([====[[{"name":"Bootstrap","class":"Script","source":"--!strict\nlocal Game=require(script.Parent.Game)\nlocal gameSession=Game.new()\ngameSession:start()\n"},{"name":"Commerce","class":"ModuleScript","source":"--!strict\nlocal Players=game:GetService('Players')\nlocal Marketplace=game:GetService('MarketplaceService')\nlocal Offers=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Offers)\nlocal Commerce={};Commerce.__index=Commerce\nfunction Commerce.new(gameController,marketOverride)\n local self=setmetatable({game=gameController,market=marketOverride or Marketplace,offers={},products={},passes={},prompting={}},Commerce)\n for _,offer in Offers do\n  self.offers[offer.id]=offer\n  if offer.assetId>0 then\n   local map=if offer.kind=='Pass' then self.passes else self.products\n   assert(not map[offer.assetId],'Duplicate commerce asset ID');map[offer.assetId]=offer\n  end\n end\n return self\nend\nfunction Commerce:award(player,key,offer)\n local ok,fresh=self.game.profiles:grantPurchase(player,key,offer.coins,offer.straw)\n if ok and player.Parent then\n  self.game:sendState(player)\n  if fresh then self.game.remotes.FX:FireClient(player,'PurchaseAward',{coins=offer.coins,straw=offer.straw,name=offer.name}) end\n end\n return ok\nend\nfunction Commerce:receipt(receipt)\n local offer=self.products[receipt.ProductId];local player=Players:GetPlayerByUserId(receipt.PlayerId)\n if not offer or not player or type(receipt.PurchaseId)~='string' then return Enum.ProductPurchaseDecision.NotProcessedYet end\n local ok,granted=pcall(function() return self:award(player,'product:'..receipt.PurchaseId,offer) end)\n return if ok and granted then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet\nend\nfunction Commerce:reconcilePass(player,offer)\n if offer.assetId<=0 or not player.Parent then return false end\n local ok,owns=pcall(function() return self.market:UserOwnsGamePassAsync(player.UserId,offer.assetId) end)\n if not ok or not owns then return false end\n return self:award(player,'pass:'..offer.assetId,offer)\nend\nfunction Commerce:joined(player)\n for _,offer in self.passes do\n  task.spawn(function()\n   for attempt=1,4 do\n    if not player.Parent then return end\n    if self:reconcilePass(player,offer) then return end\n    if attempt<4 then task.wait(attempt*3) end\n   end\n  end)\n end\nend\nfunction Commerce:prompt(player,id)\n local offer=if type(id)=='string' then self.offers[id] else nil\n if not offer then return false,'Unknown offer.' end\n if offer.assetId<=0 or game.GameId==0 then return false,'Purchases are not available yet.' end\n if not self.game.profiles:canPurchase(player) then return false,'Your progress is still syncing. Please try again shortly.' end\n if self.prompting[player] then return false,'Finish the current Roblox purchase first.' end\n local data=self.game.profiles:get(player)\n if offer.straw and data.Owned[offer.straw] then return false,'You already own this straw.' end\n self.prompting[player]={id=offer.assetId,kind=offer.kind}\n local ok=pcall(function()\n  if offer.kind=='Pass' then self.market:PromptGamePassPurchase(player,offer.assetId)\n  else self.market:PromptProductPurchase(player,offer.assetId) end\n end)\n if not ok then self.prompting[player]=nil;return false,'Roblox checkout is unavailable. Please try again.' end\n return true,'Check the Roblox purchase window.'\nend\nfunction Commerce:start()\n self.market.ProcessReceipt=function(receipt) return self:receipt(receipt) end\n self.market.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)\n  local current=self.prompting[player];if current and current.kind=='Pass' and current.id==id then self.prompting[player]=nil end\n  local offer=self.passes[id]\n  if purchased and offer then task.spawn(function()\n   for attempt=1,5 do if not player.Parent or self:reconcilePass(player,offer) then return end;task.wait(attempt*2) end\n  end) end\n end)\n -- This signal unlocks the prompt only. It NEVER grants developer-product rewards.\n self.market.PromptProductPurchaseFinished:Connect(function(userId,id)\n  local player=Players:GetPlayerByUserId(userId);local current=player and self.prompting[player]\n  if current and current.kind=='Product' and current.id==id then self.prompting[player]=nil end\n end)\n Players.PlayerRemoving:Connect(function(player) self.prompting[player]=nil end)\nend\nreturn Commerce\n"},{"name":"Game","class":"ModuleScript","source":"--!strict\nlocal Players=game:GetService('Players');local ReplicatedStorage=game:GetService('ReplicatedStorage');local RunService=game:GetService('RunService')\nlocal Package=ReplicatedStorage.SeaGame;local Config=require(Package.Shared.Config);local Economy=require(Package.Shared.Economy)\nlocal Profiles=require(script.Parent.Profiles);local Ocean=require(script.Parent.Ocean);local Loot=require(script.Parent.Loot);local Wrecks=require(script.Parent.Wrecks)\nlocal Restroom=require(script.Parent.Restroom);local Needs=require(Package.Shared.Needs)\nlocal Commerce=require(script.Parent.Commerce)\nlocal Game={};Game.__index=Game\nlocal function finiteVector(value:any):boolean\n return typeof(value)=='Vector3' and value.X==value.X and value.Y==value.Y and value.Z==value.Z and value.Magnitude<10000\nend\nfunction Game.new()\n local self=setmetatable({active={},buckets={},noticeTimes={},connections={},clock=0,worldClock=0,fxClock=0,dead=false},Game)\n self.remotes=Package.Remotes;self.ocean=Ocean.new()\n self.profiles=Profiles.new(function(player,status) self:sendState(player);if status=='Retrying' then self:notice(player,'Saving is taking longer. Your progress is still here.','warning') end end)\n self.loot=Loot.new(self.ocean,self.profiles,function(player) self:sendState(player) end,function(kind,payload) self.remotes.FX:FireAllClients(kind,payload) end,function(player,message,kind) self:notice(player,message,kind) end)\n self.wrecks=Wrecks.new(self.ocean,self.loot,function(player,message,kind) self:notice(player,message,kind) end,function(kind,payload) self.remotes.FX:FireAllClients(kind,payload) end)\n self.restroom=Restroom.new(self)\n self.commerce=Commerce.new(self)\n return self\nend\nfunction Game:snapshot(player)\n local data=self.profiles:get(player);if not data then return nil end\n local tool=player.Character and player.Character:FindFirstChildOfClass('Tool')\n return {coins=data.Coins,owned=table.clone(data.Owned),equipped=data.Equipped,held=tool~=nil and tool:GetAttribute('SeaStraw')==data.Equipped,upgrades=table.clone(data.Upgrades),bag=table.clone(data.Bag),count=Economy.count(data),capacity=Economy.capacity(data),value=Economy.value(data),stats=Economy.stats(data),saveStatus=self.profiles:status(player),revision=data.Revision}\nend\nfunction Game:sendState(player) local state=self:snapshot(player);if state and player.Parent then self.remotes.State:FireClient(player,state);if self.restroom then self.restroom:send(player) end end end\nfunction Game:notice(player,message,kind)\n local now=os.clock();local last=self.noticeTimes[player]\n if last and last.message==message and now-last.time<2 then return end\n self.noticeTimes[player]={message=message,time=now};self.remotes.FX:FireClient(player,'Notice',{message=message,kind=kind or 'info'})\nend\nfunction Game:allow(player,channel:string,capacity:number,refill:number):boolean\n local all=self.buckets[player];if not all then all={};self.buckets[player]=all end\n local bucket=all[channel];local now=os.clock();if not bucket then bucket={tokens=capacity,time=now};all[channel]=bucket end\n bucket.tokens=math.min(capacity,bucket.tokens+(now-bucket.time)*refill);bucket.time=now\n if bucket.tokens<1 then return false end;bucket.tokens-=1;return true\nend\nfunction Game:nearShop(player,shop:string):boolean\n local character=player.Character;local root=character and character:FindFirstChild('HumanoidRootPart');local human=character and character:FindFirstChildOfClass('Humanoid');local npc=workspace.NPCs:FindFirstChild(Config.ShopNames[shop] or '')\n return root~=nil and human~=nil and human.Health>0 and npc~=nil and (root.Position-npc:GetPivot().Position).Magnitude<=Config.ShopDistance\nend\nfunction Game:movement(player)\n local data=self.profiles:get(player);local character=player.Character;local human=character and character:FindFirstChildOfClass('Humanoid')\n if not data or not human then return end\n local held=character:FindFirstChildOfClass('Tool');local admin=held and held:GetAttribute('SeaStraw')=='AdminStraw' and data.Owned.AdminStraw==true\n if human:GetAttribute('SeaBaseJumpHeight')==nil then human:SetAttribute('SeaBaseJumpHeight',human.JumpHeight);human:SetAttribute('SeaBaseJumpPower',human.JumpPower) end\n human.WalkSpeed=if admin then Config.AdminStraw.walk else Economy.stats(data).walk\n human.JumpHeight=if admin then Config.AdminStraw.jumpHeight else human:GetAttribute('SeaBaseJumpHeight')\n human.JumpPower=if admin then math.sqrt(2*workspace.Gravity*Config.AdminStraw.jumpHeight) else human:GetAttribute('SeaBaseJumpPower')\n character:SetAttribute('AdminMovement',admin==true)\nend\nfunction Game:equipTool(player)\n local data=self.profiles:get(player);local character=player.Character;local backpack=player:FindFirstChildOfClass('Backpack')\n if not data or not character or not backpack then return end\n local humanoid=character:FindFirstChildOfClass('Humanoid');if not humanoid or humanoid.Health<=0 then return end\n self:stopSuction(player)\n for _,parent in {character,backpack} do for _,p in parent:GetChildren() do if p:IsA('Tool') and p:GetAttribute('SeaStraw') then p:Destroy() end end end\n local prefab=Package.Assets.Tools:FindFirstChild(data.Equipped);assert(prefab,'Missing straw model '..data.Equipped)\n local tool=Instance.new('Tool');tool.Name=Config.StrawById[data.Equipped].name;tool.CanBeDropped=false;tool.RequiresHandle=true;tool:SetAttribute('SeaStraw',data.Equipped);tool.ToolTip='Hold right mouse button near the sea'\n local handle=Instance.new('Part');handle.Name='Handle';handle.Size=Vector3.new(.16,.3,.16);handle.Transparency=1;handle.CanCollide=false;handle.CanQuery=false;handle.CanTouch=false;handle.Massless=true;handle.Parent=tool\n for _,p in prefab:GetDescendants() do if p:IsA('BasePart') then\n  local visual=p:Clone();visual.Name='StrawVisual';visual.CFrame=CFrame.new(0,-1.35,0)*p.CFrame;visual.Anchored=false;visual.CanCollide=false;visual.CanTouch=false;visual.CanQuery=false;visual.Massless=true;visual.Parent=tool\n  local weld=Instance.new('Weld');weld.Part0=handle;weld.Part1=visual;weld.C0=visual.CFrame;weld.Parent=handle\n end end\n local tip=Instance.new('Attachment');tip.Name='SuctionTip';tip.Position=Vector3.new(0,-1.35,0);tip.Parent=handle\n local mouth=Instance.new('Attachment');mouth.Name='MouthTip';mouth.Position=Vector3.new(-.72,1.15,0);mouth.Parent=handle\n tool.Grip=CFrame.new(0,-.05,0)*CFrame.Angles(0,0,math.rad(-8));tool.Parent=backpack;humanoid:EquipTool(tool)\n self:movement(player)\n tool.Equipped:Connect(function() task.defer(function() self:movement(player);self:sendState(player) end) end)\n tool.Unequipped:Connect(function() self:stopSuction(player);task.defer(function() self:movement(player);self:sendState(player) end) end)\n task.defer(function() self:sendState(player) end)\nend\nfunction Game:stopSuction(player)\n if self.active[player] then self.active[player]=nil;self.remotes.FX:FireAllClients('SuctionStop',{player=player.UserId}) end\n if player.Character then player.Character:SetAttribute('SuckingOcean',false) end\nend\nfunction Game:validTarget(player,point:any):boolean\n if not self.restroom:canSip(player) then return false end\n if not finiteVector(point) or not self.ocean:canDrain() or self.ocean:isComplete() then return false end\n local character=player.Character;local root=character and character:FindFirstChild('HumanoidRootPart');local humanoid=character and character:FindFirstChildOfClass('Humanoid');local data=self.profiles:get(player)\n if not root or not humanoid or humanoid.Health<=0 or not data then return false end\n local equipped=character:FindFirstChildOfClass('Tool');if not equipped or equipped:GetAttribute('SeaStraw')~=data.Equipped then return false end\n local target=Vector3.new(point.X,self.ocean.applied,point.Z)\n if (root.Position-target).Magnitude>Economy.stats(data).reach or math.abs(point.Y-self.ocean.applied)>3 then return false end\n if math.abs(point.X)>Config.Ocean.halfSize-4 or math.abs(point.Z)>Config.Ocean.halfSize-4 then return false end\n local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={character,workspace.NPCs,self.loot.folder};params.IgnoreWater=false;params.RespectCanCollide=true\n local hit=workspace:Raycast(target+Vector3.new(0,2,0),Vector3.new(0,-5,0),params)\n if not hit or hit.Material~=Enum.Material.Water then return false end\n -- A dry wall or floor may not separate the player's straw from the water point.\n local origin=root.Position;local wall=workspace:Raycast(origin,target-origin,params)\n return wall==nil or wall.Material==Enum.Material.Water or (wall.Position-target).Magnitude<1.2\nend\nfunction Game:suctionPulse(player,point:any)\n if not self:allow(player,'suction',8,5) then return end\n if point==false then self:stopSuction(player);return end\n if not self.restroom:canSip(player) then self:stopSuction(player);self:notice(player,'Visit the beach restroom to feel fresh again.','warning');return end\n if not self:validTarget(player,point) then self:stopSuction(player);return end\n local first=self.active[player]==nil;self.active[player]={point=Vector3.new(point.X,self.ocean.applied,point.Z),expires=os.clock()+1.3}\n player.Character:SetAttribute('SuckingOcean',true)\n if first then self.remotes.FX:FireAllClients('SuctionStart',{player=player.UserId,point=self.active[player].point,straw=self.profiles:get(player).Equipped}) end\nend\nfunction Game:request(player,action:any,payload:any)\n if type(action)~='string' or #action>30 or not self:allow(player,'request',10,4) then return {ok=false,message='Please slow down.'} end\n local data=self.profiles:get(player);if not data then return {ok=false,message='Your backpack is loading.'} end\n if action=='State' then self.restroom:send(player);return {ok=true,state=self:snapshot(player)} end\n if self.restroom.using[player] then return {ok=false,message='Enjoy your shore break.'} end\n local success,message,amount=false,'Unknown action.',0\n if action=='PurchaseOffer' then\n  if not self:allow(player,'purchase',1,.3) then return {ok=false,message='Please wait a moment.'} end\n  success,message=self.commerce:prompt(player,payload)\n elseif action=='EquipSpecial' then\n  local def=if type(payload)=='string' then Config.StrawById[payload] else nil\n  if not def or not def.premium or not data.Owned[payload] then return {ok=false,message='You do not own this special straw.'} end\n  success,message=Economy.equip(data,payload);if success then self:equipTool(player) end\n elseif action=='UseRestroom' then\n  success,message=self.restroom:use(player)\n elseif action=='BuyStraw' or action=='EquipStraw' then\n  if type(payload)~='string' or #payload>32 or not self:nearShop(player,'Straws') then return {ok=false,message='Visit Finn at STRAWS.'} end\n  if action=='BuyStraw' then success,message,amount=Economy.buyStraw(data,payload) else success,message=Economy.equip(data,payload) end\n  if success then self:equipTool(player) end\n elseif action=='Upgrade' then\n  if type(payload)~='string' or #payload>24 or not self:nearShop(player,'Upgrades') then return {ok=false,message='Visit Maya at UPGRADES.'} end\n  success,message,amount=Economy.upgrade(data,payload)\n  if success then self:movement(player) end\n elseif action=='SellAll' then\n  if not self:nearShop(player,'Sell') then return {ok=false,message='Visit Captain Shell at TREASURES.'} end\n  success,message,amount=Economy.sell(data)\n  if success then self.remotes.FX:FireClient(player,'Sale',{amount=amount}) end\n elseif action=='Collect' then\n  if type(payload)~='string' or #payload>48 then return {ok=false,message='Invalid treasure.'} end\n  success,message=self.loot:collect(player,payload)\n elseif action=='OpenChest' then\n  if type(payload)~='string' or #payload>48 then return {ok=false,message='Invalid chest.'} end\n  success,message,amount=self.wrecks:open(player,payload)\n elseif action=='ToggleHeld' or action=='EquipHeld' then\n  if not self:allow(player,'equip',2,4) then return {ok=false,message='Please slow down.'} end\n  local character=player.Character;local human=character and character:FindFirstChildOfClass('Humanoid');local backpack=player:FindFirstChildOfClass('Backpack')\n  if not human or human.Health<=0 or not backpack then return {ok=false,message='Your straw is not ready.'} end\n  self:stopSuction(player)\n  local held=character:FindFirstChildOfClass('Tool')\n  if held and held:GetAttribute('SeaStraw') then human:UnequipTools();success=true;message='Straw put away.'\n  else for _,tool in backpack:GetChildren() do if tool:IsA('Tool') and tool:GetAttribute('SeaStraw')==data.Equipped then human:EquipTool(tool);success=true;message='Straw ready.';break end end end\n elseif action=='NewTide' then\n  return {ok=false,message='The ocean is shared. Its progress is permanent.'}\n end\n if success then self:sendState(player);if action=='Upgrade' or action=='BuyStraw' then self.remotes.FX:FireClient(player,'Upgrade',{category=payload}) end end\n return {ok=success,message=message,amount=amount or 0,state=self:snapshot(player)}\nend\nfunction Game:characterAdded(player,character)\n if character:GetAttribute('SeaInitialized') then return end;character:SetAttribute('SeaInitialized',true)\n local humanoid=character:WaitForChild('Humanoid',10);if not humanoid then return end\n humanoid.Died:Connect(function() self:stopSuction(player);self.restroom:finish(player,false) end)\n local deadline=os.clock()+25;while not self.profiles:get(player) and player.Parent and os.clock()<deadline do task.wait(.1) end\n if player.Parent and self.profiles:get(player) then self:equipTool(player);self:sendState(player) end\nend\nfunction Game:playerAdded(player)\n player.CharacterAdded:Connect(function(character) self:characterAdded(player,character) end)\n local data=self.profiles:load(player);if not data then return end\n if player.Character then self:characterAdded(player,player.Character) end\n self:sendState(player)\n self.commerce:joined(player)\nend\nfunction Game:start()\n Game.current=self\n self.ocean.progress:start()\n self.restroom:start()\n self.commerce:start()\n for shop,npcName in Config.ShopNames do\n  local npc=workspace.NPCs:FindFirstChild(npcName);local attachment=Instance.new('Attachment');attachment.Name='ShopInteraction';attachment.Position=Vector3.new(0,1,0);attachment.Parent=npc.HumanoidRootPart\n  local prompt=Instance.new('ProximityPrompt');prompt.Name='Shop_'..shop;prompt.ActionText=if shop=='Sell' then 'Sell treasure' elseif shop=='Straws' then 'Browse straws' else 'Upgrade';prompt.ObjectText=npcName;prompt.MaxActivationDistance=18;prompt.HoldDuration=0;prompt.RequiresLineOfSight=false;prompt.Style=Enum.ProximityPromptStyle.Custom;prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.GamepadKeyCode=Enum.KeyCode.ButtonX;prompt:SetAttribute('Shop',shop);prompt.Parent=attachment\n  prompt.Triggered:Connect(function(player) if self:nearShop(player,shop) then self:stopSuction(player);self.remotes.FX:FireClient(player,'OpenShop',{shop=shop}) end end)\n end\n self.remotes.Request.OnServerInvoke=function(player,action,payload) return self:request(player,action,payload) end\n self.remotes.Suction.OnServerEvent:Connect(function(player,point) self:suctionPulse(player,point) end)\n Players.PlayerAdded:Connect(function(player) task.spawn(function() self:playerAdded(player) end) end)\n Players.PlayerRemoving:Connect(function(player) self:stopSuction(player);self.restroom:finish(player,false);self.restroom.dirty[player]=nil;task.spawn(function() self.ocean.progress:flush() end);self.profiles:release(player);self.buckets[player]=nil;self.noticeTimes[player]=nil end)\n for _,player in Players:GetPlayers() do task.spawn(function() self:playerAdded(player) end) end\n RunService.Heartbeat:Connect(function(dt)\n  if self.dead then return end\n  local power=0;local contributions={}\n  for player,active in self.active do\n   active.validationClock=(active.validationClock or 0)+dt\n   local valid=true\n   if active.validationClock>=.15 then active.validationClock=0;valid=self:validTarget(player,active.point) end\n   if os.clock()>active.expires or not valid then self:stopSuction(player)\n   else local data=self.profiles:get(player);if data then local stats=Economy.stats(data);local contribution=Needs.availablePower(data.NeedsWater,stats.power*stats.speed,dt);power+=contribution;contributions[player]=contribution;active.point=Vector3.new(active.point.X,self.ocean.applied,active.point.Z) end end\n  end\n  local consumed=self.ocean:step(dt,power)\n  for player,contribution in contributions do self.restroom:credit(player,Needs.share(consumed,contribution,power)) end\n  self.restroom:step(dt);if self.ocean.ready then self.loot:step(dt) end;self.clock+=dt;self.worldClock+=dt;self.fxClock+=dt\n  if self.clock>=1 then self.clock=0;self.profiles:tick() end\n  if self.worldClock>=.3 then self.worldClock=0;local world=self.ocean:snapshot();world.activeLoot=self.loot.count;self.remotes.World:FireAllClients(world) end\n  if self.fxClock>=.25 then self.fxClock=0;for player,a in self.active do self.remotes.FX:FireAllClients('SuctionAim',{player=player.UserId,point=a.point}) end end\n end)\n game:BindToClose(function()\n  self.dead=true;local remaining=2\n  task.spawn(function() self.profiles:close();remaining-=1 end)\n  task.spawn(function() self.ocean.progress:close();remaining-=1 end)\n  local deadline=os.clock()+26;while remaining>0 and os.clock()<deadline do task.wait(.1) end\n end)\n print('[SeaGame] Server ready')\nend\nreturn Game\n"},{"name":"GroundSites","class":"ModuleScript","source":"--!strict\n-- Offline samples from the visible Blender ground triangles. Rebuild with tools/bake_step5_layout.py.\n-- Positions have 0.02-stud precision. Normals are normalized signed 16-bit components.\nlocal encoded=[==[]==]\nlocal alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'\nlocal values:{[number]:number}={};for i=1,#alphabet do values[string.byte(alphabet,i)]=i-1 end\nlocal data=buffer.create(69370);local offset=0\nfor i=1,#encoded,4 do\n local a,b,c,d=string.byte(encoded,i,i+3)\n local n=values[a]*262144+values[b]*4096+(values[c] or 0)*64+(values[d] or 0)\n for _,divisor in {65536,256,1} do if offset<buffer.len(data) then buffer.writeu8(data,offset,math.floor(n/divisor)%256);offset+=1 end end\nend\nlocal Sites={count=6937,spacing=6,radius=342}\nfunction Sites.get(index:number):(Vector3,Vector3)\n assert(index>=1 and index<=Sites.count,'Ground site index')\n local i=(index-1)*10;local x=buffer.readi16(data,i)/50;local y=buffer.readi16(data,i+2)/50;local z=buffer.readi16(data,i+4)/50\n local nx=buffer.readi16(data,i+6)/32767;local nz=buffer.readi16(data,i+8)/32767\n return Vector3.new(x,y,z),Vector3.new(nx,math.sqrt(math.max(0,1-nx*nx-nz*nz)),nz)\nend\nreturn Sites\n"},{"name":"Loot","class":"ModuleScript","source":"--!strict\nlocal Players=game:GetService('Players')\nlocal RunService=game:GetService('RunService')\nlocal ReplicatedStorage=game:GetService('ReplicatedStorage')\nlocal Shared=ReplicatedStorage.SeaGame.Shared\nlocal Config=require(Shared.Config);local Economy=require(Shared.Economy)\nlocal GroundSites=require(script.Parent.GroundSites)\nlocal DepthZones=require(Shared.DepthZones)\nlocal Loot={};Loot.__index=Loot\nfunction Loot.new(ocean,profiles,onChanged,onFX,onNotice)\n local folder=Instance.new('Folder');folder.Name='LiveLoot';folder.Parent=workspace\n local self=setmetatable({ocean=ocean,profiles=profiles,onChanged=onChanged,onFX=onFX,onNotice=onNotice,folder=folder,nodes={},pending={},active={},count=0,rng=Random.new(),clock=0,ready=false,nextNode=1,serial=0,searchIndex=1},Loot)\n task.spawn(function() self:measureShore() end)\n self.starterNodes={};self.starterClock=0\n local sites=workspace.StarterIsland:FindFirstChild('StarterMusselSites')\n if sites then for _,site in sites:GetChildren() do table.insert(self.starterNodes,{position=site.Position,normal=site:GetAttribute('SurfaceNormal') or Vector3.yAxis,used=false,respawnAt=0,starter=true}) end end\n return self\nend\nfunction Loot:measureShore()\n -- These positions come from the rendered ground mesh. Convex collision hulls\n -- can sit several studs above it, so they must not be used to seat artwork.\n local radius=math.min(Config.Ocean.lootRadius,GroundSites.radius)\n for i=1,GroundSites.count do\n  local position,normal=GroundSites.get(i)\n  if position.X*position.X+position.Z*position.Z<=radius*radius and position.Y>Config.Ocean.minimum+.5 then\n   table.insert(self.nodes,{id=tostring(i),position=position,normal=normal,used=false})\n  end\n  if i%300==0 then RunService.Heartbeat:Wait() end\n end\n self.ready=true\n print('[SeaGame] Loaded visible-ground loot sites',#self.nodes)\nend\nfunction Loot:spawnNode(node)\n if node.used or self.count>=Config.Ocean.maxActiveLoot then return false end\n local id=Economy.rollLoot(Random.new(DepthZones.Seed+tonumber(node.id)*7919),math.max(0,-node.position.Y))\n if not id then return false end\n return self:spawnReward(node.position,id,node.normal,nil,node)\nend\nfunction Loot:spawnReward(position:Vector3,id:string,normal:Vector3?,burstOrigin:Vector3?,sourceNode)\n if self.count>=Config.Ocean.maxActiveLoot+8 then return false end\n local node=sourceNode or {position=position,normal=normal or Vector3.yAxis,used=false}\n local definition=Config.LootById[id];local prefab=ReplicatedStorage.SeaGame.Assets.Loot:FindFirstChild(id)\n if not prefab then warn('[SeaGame] Missing loot asset '..id);return false end\n self.serial+=1;local token=tostring(self.ocean.cycle)..':'..self.serial\n local model=prefab:Clone();model.Name=token;model:SetAttribute('LootId',id);model:SetAttribute('Token',token);model:SetAttribute('GroundPosition',position);model:SetAttribute('BornAt',workspace:GetServerTimeNow());model:SetAttribute('Rarity',definition.rarity)\n if burstOrigin then model:SetAttribute('BurstOrigin',burstOrigin) end\n local up=normal or Vector3.yAxis;local right=Vector3.xAxis-up*up.X\n if right.Magnitude<.1 then right=Vector3.zAxis-up*up.Z end\n right=right.Unit;local aligned=CFrame.fromMatrix(position-up*.025,right,up,right:Cross(up))\n local yaw=if node.id then Random.new(DepthZones.Seed+tonumber(node.id)*104729):NextNumber(0,math.pi*2) else self.rng:NextNumber(0,math.pi*2)\n model:PivotTo(aligned*CFrame.Angles(0,yaw,0))\n local anchor=Instance.new('Part');anchor.Name='PickupRoot';anchor.Size=Vector3.new(.2,.2,.2);anchor.Transparency=1;anchor.Anchored=true;anchor.CanCollide=false;anchor.CanQuery=false;anchor.CanTouch=false;anchor.CFrame=CFrame.new(node.position+Vector3.new(0,.6,0));anchor.Parent=model\n -- A quick press must collect, including keyboard taps shorter than one tenth of a second.\n local prompt=Instance.new('ProximityPrompt');prompt.Name='Collect';prompt.ActionText='Pick up';prompt.ObjectText=definition.name;prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.GamepadKeyCode=Enum.KeyCode.ButtonX;prompt.MaxActivationDistance=Config.PickupDistance-1;prompt.HoldDuration=0;prompt.RequiresLineOfSight=false;prompt.Style=Enum.ProximityPromptStyle.Custom;prompt.Parent=anchor\n local record={node=node,model=model,id=id,position=node.position,taken=false,connection=nil}\n record.connection=prompt.Triggered:Connect(function(player) self:collect(player,token) end)\n node.used=true;self.active[token]=record;self.count+=1;model.ModelStreamingMode=Enum.ModelStreamingMode.Atomic;model.Parent=self.folder\n return true\nend\nfunction Loot:collect(player,token:string)\n local record=self.active[token];local data=self.profiles:get(player)\n if not record or record.taken or not data then return false,'This treasure is already gone.' end\n local character=player.Character;local root=character and character:FindFirstChild('HumanoidRootPart');local humanoid=character and character:FindFirstChildOfClass('Humanoid')\n if not root or not humanoid or humanoid.Health<=0 or (root.Position-record.position).Magnitude>Config.PickupDistance then return false,'Move closer to the treasure.' end\n if record.position.Y<self.ocean.applied-.05 or self.ocean.refilling then return false,'This treasure is still underwater.' end\n local ok,message=Economy.addLoot(data,record.id)\n if not ok then self.onNotice(player,message,'warning');return false,message end\n -- No yielding between claiming the world ID and granting inventory. Second calls fail.\n record.taken=true;self.active[token]=nil;self.count-=1\n if record.node.starter then record.node.respawnAt=os.clock()+Config.Restroom.StarterMusselRespawn;record.node.used=false end\n if record.connection then record.connection:Disconnect() end\n self.onFX('Pickup',{player=player.UserId,loot=record.id,position=record.position,token=token})\n record.model:Destroy();self.onChanged(player)\n if Economy.count(data)==Economy.capacity(data) then self.onNotice(player,'BACKPACK FULL!','warning') end\n return true,'Treasure collected!'\nend\nfunction Loot:step(dt:number)\n self.starterClock+=dt\n if self.starterClock>=1 then\n  self.starterClock=0\n  for _,node in self.starterNodes do if not node.used and os.clock()>=node.respawnAt and self.count<Config.Ocean.maxActiveLoot then self:spawnReward(node.position,'StarterMussel',node.normal,nil,node) end end\n end\n if not self.ready or self.ocean.refilling then return end\n self.clock+=dt\n while self.nextNode<=#self.nodes do\n  local node=self.nodes[self.nextNode]\n  if node.position.Y-Config.Ocean.lootMargin<self.ocean.applied then break end\n  table.insert(self.pending,node);self.nextNode+=1\n end\n if self.clock<.45 or self.count>=Config.Ocean.maxActiveLoot or #self.pending==0 then return end\n self.clock=0\n -- Bound the work even after thousands of sites are exposed. Cache player positions once.\n local positions={}\n for _,player in Players:GetPlayers() do local root=player.Character and player.Character:FindFirstChild('HumanoidRootPart');if root then table.insert(positions,root.Position) end end\n local chosen,distance=nil,math.huge\n for _=1,math.min(180,#self.pending) do\n  if self.searchIndex>#self.pending then self.searchIndex=1 end\n  local i=self.searchIndex;self.searchIndex+=1;local node=self.pending[i]\n  for _,p in positions do local d=(p-node.position).Magnitude;if d<distance then chosen=i;distance=d end end\n end\n if chosen and distance<90 then local node=self.pending[chosen];self.pending[chosen]=self.pending[#self.pending];self.pending[#self.pending]=nil;self:spawnNode(node) end\nend\nfunction Loot:restart()\n for _,record in self.active do if record.connection then record.connection:Disconnect() end;record.model:Destroy() end\n self.active={};self.count=0;self.pending={};self.nextNode=1;self.searchIndex=1\n for _,node in self.nodes do node.used=false end\nend\nreturn Loot\n"},{"name":"Ocean","class":"ModuleScript","source":"--!strict\nlocal Config=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Config)\nlocal Volume=require(game.ReplicatedStorage.SeaGame.Shared.OceanVolume)\nlocal Progress=require(script.Parent.OceanProgress)\nlocal Ocean={};Ocean.__index=Ocean\nfunction Ocean.new()\n local self=setmetatable({level=Config.Ocean.initial,applied=Config.Ocean.initial,tiles={},queue={},grids={},clock=0,index=1,cycleLevel=0,cycle=1,refilling=false,onApplied=nil,progress=Progress.new(),ready=false},Ocean)\n local half=Config.Ocean.halfSize;local span=half\n for x=0,1 do for z=0,1 do table.insert(self.tiles,{x=-half+(x+.5)*span,z=-half+(z+.5)*span,width=span,level=Config.Ocean.initial}) end end\n workspace.Ocean:SetAttribute('WaterLevel',self.applied);workspace.Ocean:SetAttribute('MinimumWaterLevel',Config.Ocean.minimum);workspace.Ocean:SetAttribute('Expedition',self.cycle)\n return self\nend\nfunction Ocean:writeTile(tile,target:number)\n local bottom=math.floor(math.min(target,tile.level)/4)*4;local top=math.ceil(math.max(target,tile.level)/4)*4\n if top<=bottom then tile.level=target;return end\n local count=tile.width/4;local height=(top-bottom)/4;local cached=self.grids[height]\n if not cached then\n  local layers=table.create(height);for y=1,height do layers[y]=table.create(count,0) end\n  -- Every horizontal row has the same water level. Shared immutable-during-write rows\n  -- avoid allocating hundreds of thousands of Lua values on each update.\n  cached={layers=layers,grid=table.create(count,layers)};self.grids[height]=cached\n end\n for y=1,height do local value=math.clamp((target-(bottom+(y-1)*4))/4,0,1);for z=1,count do cached.layers[y][z]=value end end\n local half=tile.width/2\n local region=Region3.new(Vector3.new(tile.x-half,bottom,tile.z-half),Vector3.new(tile.x+half,top,tile.z+half))\n workspace.Terrain:WriteVoxelChannels(region,4,{LiquidOccupancy=cached.grid})\n tile.level=target\nend\nfunction Ocean:step(dt:number,power:number)\n dt=math.min(dt,.25);self.clock+=dt\n local consumed=0\n if self.ready then consumed=self.progress:consume(Volume.flow(power,Config.Ocean.BaseRemovalRate,Config.Ocean.MaxRemovalRate)*dt) end\n self.progress:step(dt)\n if self.progress.ready then self.level=Volume.level(self.progress.remaining,self.progress.total,Config.Ocean.initial,Config.Ocean.minimum) end\n local difference=math.abs(self.level-self.applied)\n local endpoint=(self.level==0 or self.level==Config.Ocean.minimum) and difference>.00001\n if #self.queue==0 and self.clock>=Config.Ocean.updatePeriod and (difference>=Config.Ocean.updateDistance or endpoint) then\n  self.clock=0;self.queue=table.clone(self.tiles);self.index=1;self.cycleLevel=self.level\n end\n if #self.queue>0 then\n  debug.profilebegin('SeaGame water tiles')\n  for _=1,1 do\n   local tile=self.queue[self.index];if not tile then break end\n   self:writeTile(tile,self.cycleLevel);self.index+=1\n  end\n  debug.profileend()\n  if self.index>#self.queue then\n   table.clear(self.queue);self.applied=self.cycleLevel;workspace.Ocean:SetAttribute('WaterLevel',self.applied)\n   local remaining=Volume.atLevel(self.applied,self.progress.total,Config.Ocean.initial,Config.Ocean.minimum)\n   workspace.Ocean:SetAttribute('RemainingWaterVolume',remaining)\n   workspace.Ocean:SetAttribute('TotalOceanVolume',self.progress.total)\n   if self.onApplied then self.onApplied(self.applied) end\n  end\n end\n if self.progress.ready and #self.queue==0 and math.abs(self.applied-self.level)<=Config.Ocean.updateDistance then self.ready=true end\n return consumed\nend\nfunction Ocean:canDrain():boolean return self.ready and self.progress:canDrain() end\nfunction Ocean:isComplete():boolean return self.ready and self.progress.remaining==0 and self.applied<=Config.Ocean.minimum+.000001 end\nfunction Ocean:snapshot()\n local total=self.progress.total\n local remaining=Volume.atLevel(self.applied,total,Config.Ocean.initial,Config.Ocean.minimum)\n return {level=self.applied,target=self.level,minimum=Config.Ocean.minimum,complete=self:isComplete(),refilling=false,cycle=1,ready=self.ready,saveStatus=self.progress.status,TotalOceanVolume=total,RemainingWaterVolume=remaining,OceanRemainingPercent=Volume.percent(remaining,total)}\nend\nreturn Ocean\n"},{"name":"OceanLedger","class":"ModuleScript","source":"--!strict\n-- Pure DataStore transforms. Callbacks may run repeatedly and never mutate input.\nlocal V=require(game.ReplicatedStorage.SeaGame.Shared.OceanVolume)\nlocal Ledger={}\nfunction Ledger.valid(record:any):boolean\n return type(record)=='table' and record.version==1 and V.finite(record.removed) and record.removed>=0 and type(record.sessions)=='table'\nend\nfunction Ledger.copy(old:any,now:number)\n if old~=nil then assert(Ledger.valid(old),'Invalid ocean shard; refusing to replace saved progress') end\n local result={version=1,removed=if old then old.removed else 0,sessions={}}\n if old then for id,session in old.sessions do\n  assert(type(id)=='string' and type(session)=='table' and V.finite(session.sequence) and V.finite(session.expires),'Invalid ocean session')\n  if session.expires>now then result.sessions[id]={sequence=session.sequence,expires=session.expires} end\n end end\n return result\nend\nfunction Ledger.claim(old:any,id:string,now:number,ttl:number)\n local result=Ledger.copy(old,now)\n if not result.sessions[id] then result.sessions[id]={sequence=0,expires=now+ttl} end\n return result\nend\nfunction Ledger.commit(old:any,id:string,sequence:number,amount:number,now:number,ttl:number,total:number)\n assert(V.finite(amount) and amount>=0 and V.finite(sequence) and sequence%1==0 and sequence>=1,'Invalid ocean delta')\n local result=Ledger.copy(old,now);local session=result.sessions[id]\n -- Missing/expired writer leases can never recreate themselves through a retry.\n if not session then return result end\n if sequence==session.sequence+1 then\n  result.removed=math.min(total,result.removed+amount);session.sequence=sequence\n elseif sequence~=session.sequence then return result end\n session.expires=now+ttl\n return result\nend\nreturn table.freeze(Ledger)\n"},{"name":"OceanProgress","class":"ModuleScript","source":"--!nonstrict\nlocal DataStoreService=game:GetService('DataStoreService')\nlocal MessagingService=game:GetService('MessagingService')\nlocal HttpService=game:GetService('HttpService')\nlocal RunService=game:GetService('RunService')\nlocal Config=require(game.ReplicatedStorage.SeaGame.Shared.Config).Ocean\nlocal V=require(game.ReplicatedStorage.SeaGame.Shared.OceanVolume)\nlocal Ledger=require(script.Parent.OceanLedger)\nlocal Progress={};Progress.__index=Progress\nlocal function memoryStore()\n local store={values={}}\n function store:GetAsync(key) return self.values[key] end\n function store:UpdateAsync(key,transform) local result=transform(self.values[key]);if result~=nil then self.values[key]=result end;return result end\n return store\nend\nfunction Progress.new(options)\n options=options or {}\n local persistent=options.store~=nil or game.GameId~=0\n local store=options.store or (if persistent then DataStoreService:GetDataStore(Config.ProgressStore..(if RunService:IsStudio() then '_Studio' else '')) else memoryStore())\n local id=options.id or HttpService:GenerateGUID(false)\n local hash=0;for i=1,#id do hash=(hash*31+string.byte(id,i))%65521 end\n return setmetatable({store=store,persistent=persistent,now=options.now or os.time,id=id,shard=options.shard or hash%Config.ShardCount+1,sequence=0,totals=table.create(Config.ShardCount,0),total=Config.TotalOceanVolume,remaining=Config.TotalOceanVolume,pending=0,batch=nil,ready=false,status='Loading',busy=false,blocked=false,closing=false,clock=0,pollClock=0,pollIndex=1,leaseUntil=0,retryAt=0,failures=0,noMessaging=options.noMessaging or not persistent,topic=Config.WorldKey..(if RunService:IsStudio() then '_Studio' else '')},Progress)\nend\nfunction Progress:key(index) return Config.WorldKey..'_s'..index end\nfunction Progress:absorb(index,record)\n if record==nil then return end\n assert(Ledger.valid(record),'Invalid saved ocean shard')\n self.totals[index]=math.max(self.totals[index],record.removed)\n local sum=0;for _,amount in self.totals do sum+=amount end\n self.remaining=V.remaining(self.total,sum)\nend\nfunction Progress:claim()\n local result=self.store:UpdateAsync(self:key(self.shard),function(old) return Ledger.claim(old,self.id,self.now(),Config.LeaseSeconds) end)\n self:absorb(self.shard,result)\n local session=result.sessions[self.id];assert(session,'Ocean writer registration failed')\n self.sequence=session.sequence;self.leaseUntil=session.expires\nend\nfunction Progress:load()\n local metadata=self.store:GetAsync(Config.WorldKey..'_meta')\n if metadata==nil then metadata=self.store:UpdateAsync(Config.WorldKey..'_meta',function(old)\n  return old or {version=1,total=Config.TotalOceanVolume,shards=Config.ShardCount,initial=Config.initial,minimum=Config.minimum,halfSize=Config.halfSize}\n end) end\n assert(type(metadata)=='table' and metadata.version==1 and V.finite(metadata.total) and metadata.total>0 and metadata.shards==Config.ShardCount,'Invalid ocean metadata; existing progress is protected')\n assert(metadata.initial==Config.initial and metadata.minimum==Config.minimum and metadata.halfSize==Config.halfSize,'Ocean geometry differs from the saved world')\n self.total=metadata.total\n for index=1,Config.ShardCount do self:absorb(index,self.store:GetAsync(self:key(index))) end\n self:claim();self.ready=true;self.status=if self.persistent then 'Saved' else 'Session'\n return true\nend\nfunction Progress:start()\n task.spawn(function()\n  while not self.closing and not self.ready do\n   local ok,err=pcall(function() self:load() end)\n   if not ok then self.status='Unavailable';warn('[SeaGame] Ocean loading will retry: '..tostring(err));task.wait(8) end\n  end\n  if self.closing or self.noMessaging then return end\n  local ok,connection=pcall(function() return MessagingService:SubscribeAsync(self.topic,function(message)\n   local data=message.Data\n   if type(data)=='table' and V.finite(data.shard) and data.shard%1==0 and data.shard>=1 and data.shard<=Config.ShardCount and V.finite(data.removed) and data.removed>=0 and data.removed<=self.total then\n    self:absorb(data.shard,{version=1,removed=data.removed,sessions={}})\n   end\n  end) end)\n  if ok then self.subscription=connection else warn('[SeaGame] Ocean messages unavailable; periodic DataStore reconciliation remains active') end\n end)\nend\nfunction Progress:canDrain() return self.ready and not self.blocked and not self.closing and self.remaining>0 end\nfunction Progress:consume(volume)\n if not self:canDrain() or not V.finite(volume) or volume<=0 then return 0 end\n local amount=math.min(volume,math.max(0,self.remaining-self.pending));self.pending+=amount;return amount\nend\nfunction Progress:flush()\n if self.busy or not self.ready then return false end\n self.busy=true\n if not self.batch then self.batch={sequence=self.sequence+1,amount=self.pending} end\n local batch=self.batch\n local ok,result=pcall(function() return self.store:UpdateAsync(self:key(self.shard),function(old)\n  return Ledger.commit(old,self.id,batch.sequence,batch.amount,self.now(),Config.LeaseSeconds,self.total)\n end) end)\n if ok and result then\n  self:absorb(self.shard,result)\n  local session=result.sessions[self.id]\n  if session and session.sequence==batch.sequence then\n   self.pending=math.max(0,self.pending-batch.amount);self.sequence=batch.sequence;self.leaseUntil=session.expires;self.batch=nil\n   self.blocked=false;self.failures=0;self.status=if self.persistent then 'Saved' else 'Session';self.clock=0\n   if not self.noMessaging and batch.amount>0 then task.spawn(function() pcall(function() MessagingService:PublishAsync(self.topic,{shard=self.shard,removed=result.removed}) end) end) end\n  else\n   -- An expired, uncertain batch is never replayed under a new writer identity.\n   -- Its canonical saved total was absorbed above; displayed progress never rewinds.\n   self.pending=0;self.batch=nil;self.id=HttpService:GenerateGUID(false);self.sequence=0;self.blocked=true\n   local claimed=pcall(function() self:claim() end);self.blocked=not claimed;self.status=if claimed then (if self.persistent then 'Saved' else 'Session') else 'Retrying'\n   if claimed then self.failures=0;self.clock=0 else self.failures+=1;self.retryAt=os.clock()+math.min(20,2^math.min(self.failures,4)) end\n  end\n else\n  self.blocked=true;self.status='Retrying';self.failures+=1;self.retryAt=os.clock()+math.min(20,2^math.min(self.failures,4))\n  warn('[SeaGame] Ocean commit will retry without double counting')\n end\n self.busy=false;return ok and not self.blocked\nend\nfunction Progress:poll(index)\n local options=Instance.new('DataStoreGetOptions');options.UseCache=false\n local result=self.store:GetAsync(self:key(index),options)\n self:absorb(index,result)\nend\nfunction Progress:step(dt)\n if not self.ready or self.closing then return end\n self.clock+=dt;self.pollClock+=dt\n if not self.busy and os.clock()>=self.retryAt and (self.batch or (self.pending>0 and self.clock>=Config.CommitInterval) or self.now()>self.leaseUntil-30) then\n  task.spawn(function() self:flush() end)\n end\n if self.pollClock>=Config.PollInterval and not self.polling then\n  self.pollClock=0;local index=self.pollIndex;self.pollIndex=index%Config.ShardCount+1;self.polling=true\n  task.spawn(function() local ok=pcall(function() self:poll(index) end);self.polling=false;if not ok then self.pollClock=-4 end end)\n end\nend\nfunction Progress:close()\n self.closing=true;local deadline=os.clock()+22\n repeat\n  if not self.busy and self.ready and (self.pending>0 or self.batch) then self:flush() end\n  if not self.busy and self.pending<=0 and not self.batch then break end\n  task.wait(.2)\n until os.clock()>deadline\n if self.subscription then self.subscription:Disconnect() end\nend\nreturn Progress\n"},{"name":"Profiles","class":"ModuleScript","source":"--!strict\nlocal DataStoreService=game:GetService('DataStoreService')\nlocal HttpService=game:GetService('HttpService')\nlocal RunService=game:GetService('RunService')\nlocal Shared=game:GetService('ReplicatedStorage').SeaGame.Shared\nlocal Config=require(Shared.Config);local Economy=require(Shared.Economy)\nlocal Profiles={};Profiles.__index=Profiles\nfunction Profiles.new(onStatus,storeOverride)\n local self=setmetatable({records={},onStatus=onStatus,session=game.JobId..HttpService:GenerateGUID(false),store=nil,closing=false},Profiles)\n if storeOverride then self.store=storeOverride\n elseif game.GameId~=0 then self.store=DataStoreService:GetDataStore(Config.DataStoreName..(if RunService:IsStudio() then '_Studio' else '')) end\n return self\nend\nfunction Profiles:get(player) local r=self.records[player];return r and r.data end\nfunction Profiles:status(player) local r=self.records[player];return r and r.status or 'Loading' end\nfunction Profiles:load(player)\n if self.records[player] then return self.records[player].data end\n local data=Economy.new();local persistent=self.store~=nil\n if persistent then\n  local loaded=nil;local lastError='Session is still active on another server.'\n  for attempt=1,4 do\n   local ok,result=pcall(function()\n    return self.store:UpdateAsync('u_'..player.UserId,function(old)\n     old=if type(old)=='table' then old else {};local lock=old.Session\n     if type(lock)=='table' and lock.Token~=self.session and type(lock.Expires)=='number' and lock.Expires>os.time() then return nil end\n     return {Data=Economy.normalize(old.Data or old),Session={Token=self.session,Expires=os.time()+180}}\n    end)\n   end)\n   if ok and result then loaded=result;break end\n   if not ok then lastError=tostring(result) end\n   if attempt<4 then task.wait(2^(attempt-1)) end\n  end\n  if loaded then data=Economy.normalize(loaded.Data)\n  elseif RunService:IsStudio() then persistent=false;warn('[SeaGame] Studio save unavailable: '..lastError)\n  else warn('[SeaGame] Profile load failed for '..player.UserId..': '..lastError);player:Kick('Your progress could not be loaded safely. Please rejoin in a moment.');return nil end\n end\n if not player.Parent then\n  if persistent then pcall(function() self.store:UpdateAsync('u_'..player.UserId,function(old) if old and old.Session and old.Session.Token==self.session then old.Session=nil;return old end;return nil end) end) end\n  return nil\n end\n self.records[player]={data=data,persistent=persistent,status=if persistent then 'Saved' else 'Session',saving=false,nextSave=os.clock()+45+(player.UserId%13),savedRevision=data.Revision,savedReceipts=table.clone(data.Receipts)}\n return data\nend\nfunction Profiles:save(player,release:boolean?)\n local r=self.records[player];if not r then return true end\n if not r.persistent then return true end\n if r.saving then return false end\n r.saving=true;local snapshot=Economy.copy(r.data);local success=false;local errorMessage='Session ownership changed.'\n for attempt=1,3 do\n  local ok,result=pcall(function()\n   return self.store:UpdateAsync('u_'..player.UserId,function(old)\n    if type(old)~='table' or type(old.Session)~='table' or old.Session.Token~=self.session then return nil end\n    return {Data=snapshot,Session=if release then nil else {Token=self.session,Expires=os.time()+180}}\n   end)\n  end)\n  if ok and result then success=true;break end\n  if not ok then errorMessage=tostring(result) end\n  if attempt<3 then task.wait(attempt) end\n end\n r.saving=false;r.status=if success then 'Saved' else 'Retrying';r.nextSave=os.clock()+(if success then 45 else 12)\n if success then r.savedRevision=snapshot.Revision;r.savedReceipts=table.clone(snapshot.Receipts) else warn('[SeaGame] Save retry required for '..player.UserId..': '..errorMessage) end\n if self.onStatus and player.Parent then self.onStatus(player,r.status) end\n return success\nend\n-- The award and receipt marker are committed in the SAME session-locked record.\n-- A failed/ambiguous save remains unacknowledged; retry cannot add the award twice.\nfunction Profiles:grantPurchase(player,key:string,coins:number,straw:string?)\n local r=self.records[player]\n if not r or not r.persistent or r.saving or self.closing then return false,false end\n if type(key)~='string' or #key>150 or coins<0 or coins~=math.floor(coins) or (straw and not Config.StrawById[straw]) then return false,false end\n if r.savedReceipts[key] then return true,false end\n local fresh=not r.data.Receipts[key]\n if fresh then\n  local count=0;for _ in r.data.Receipts do count+=1 end\n  if count>=8000 then return false,false end -- Do not evict receipts and risk duplicate credit.\n  r.data.Coins=math.min(1e12,r.data.Coins+coins)\n  if straw then r.data.Owned[straw]=true end\n  r.data.Receipts[key]=true;r.data.Revision+=1\n end\n self:save(player,false)\n return r.savedReceipts[key]==true,fresh\nend\nfunction Profiles:canPurchase(player):boolean\n local r=self.records[player];return r~=nil and r.persistent and not self.closing and r.status~='Retrying'\nend\nfunction Profiles:release(player)\n local r=self.records[player];if not r then return end\n local deadline=os.clock()+12;while r.saving and os.clock()<deadline do task.wait(.1) end\n self:save(player,true);self.records[player]=nil\nend\nfunction Profiles:tick()\n if self.closing then return end\n for player,r in self.records do\n  if r.persistent and not r.saving and os.clock()>=r.nextSave then r.nextSave=os.clock()+45;task.spawn(function() self:save(player,false) end);break end\n end\nend\nfunction Profiles:close()\n self.closing=true;local remaining=0\n for player in self.records do remaining+=1;task.spawn(function() self:release(player);remaining-=1 end) end\n local deadline=os.clock()+25;while remaining>0 and os.clock()<deadline do task.wait(.1) end\nend\nreturn Profiles\n"},{"name":"Restroom","class":"ModuleScript","source":"--!strict\nlocal Players=game:GetService('Players')\nlocal Package=game:GetService('ReplicatedStorage').SeaGame\nlocal Config=require(Package.Shared.Config);local Needs=require(Package.Shared.Needs);local Economy=require(Package.Shared.Economy)\nlocal Restroom={};Restroom.__index=Restroom\nfunction Restroom.new(owner)\n return setmetatable({owner=owner,using={},dirty={},clock=0,occupant=nil},Restroom)\nend\nfunction Restroom:state(player)\n local data=self.owner.profiles:get(player)\n return {percent=Needs.percent(if data then data.NeedsWater else 0),using=self.using[player]~=nil}\nend\nfunction Restroom:send(player)\n if player.Parent then self.owner.remotes.FX:FireClient(player,'Needs',self:state(player)) end\nend\nfunction Restroom:credit(player,amount:number)\n local data=self.owner.profiles:get(player);if not data or amount<=0 then return end\n data.NeedsWater=math.min(Needs.Capacity,data.NeedsWater+amount);self.dirty[player]=true\n if data.NeedsWater>=Needs.Capacity-.000001 then data.NeedsWater=Needs.Capacity;self.owner:stopSuction(player) end\nend\nfunction Restroom:canSip(player):boolean\n local data=self.owner.profiles:get(player)\n return data~=nil and not self.using[player] and data.NeedsWater<Needs.Capacity-.000001\nend\nfunction Restroom:finish(player,completed:boolean)\n local use=self.using[player];if not use then return end\n self.using[player]=nil;self.occupant=nil\n local data=self.owner.profiles:get(player)\n if completed and data then data.NeedsWater=0;data.Revision+=1 end\n local root=use.root;local human=use.human\n if root.Parent and human.Parent then\n  if completed and human.Health>0 then root.CFrame=self.booth.Exit.CFrame end\n  root.Anchored=use.anchored;human.AutoRotate=use.rotate;human.WalkSpeed=if data then Economy.stats(data).walk else use.walk\n  if use.held and human.Health>0 and use.held.Parent then human:EquipTool(use.held) end\n end\n self.booth:SetAttribute('Occupied',false);self.booth:SetAttribute('UseStartedAt',nil)\n self.booth.PrivacyDoor.CanCollide=false;self.booth.PrivacyDoor.CanQuery=false\n if self.prompt then self.prompt.Enabled=true end\n if player.Parent then self.owner.remotes.FX:FireClient(player,'RestroomEnd',{completed=completed});self:send(player);self.owner:sendState(player) end\nend\nfunction Restroom:use(player)\n local data=self.owner.profiles:get(player);local character=player.Character\n local root=character and character:FindFirstChild('HumanoidRootPart');local human=character and character:FindFirstChildOfClass('Humanoid')\n if not data or not root or not human or human.Health<=0 or not self.booth or (root.Position-self.booth.Entry.Position).Magnitude>Config.Restroom.Distance then return false,'Walk to the beach restroom.' end\n if self.occupant then return false,'The restroom is occupied.' end\n if data.NeedsWater<=.000001 then return false,'You feel fresh already!' end\n self.owner:stopSuction(player);self.occupant=player\n local tool=character:FindFirstChildOfClass('Tool')\n self.using[player]={root=root,human=human,anchored=root.Anchored,rotate=human.AutoRotate,walk=human.WalkSpeed,held=tool,ends=os.clock()+Config.Restroom.UseSeconds}\n human:UnequipTools();root.Anchored=true;human.AutoRotate=false;human.WalkSpeed=0;root.CFrame=self.booth.Inside.CFrame\n self.booth:SetAttribute('Occupied',true);self.booth:SetAttribute('UseStartedAt',workspace:GetServerTimeNow());self.prompt.Enabled=false\n self.booth.PrivacyDoor.CanCollide=true;self.booth.PrivacyDoor.CanQuery=true\n self.owner.remotes.FX:FireClient(player,'RestroomStart',{duration=Config.Restroom.UseSeconds,camera=self.booth.Camera.CFrame})\n self:send(player);return true,'A little shore break.'\nend\nfunction Restroom:start()\n self.booth=workspace.Buildings:FindFirstChild('BeachRestroom');assert(self.booth,'BeachRestroom is missing')\n local p=Instance.new('ProximityPrompt');p.Name='UseRestroom';p.ActionText='Use restroom';p.ObjectText='Beach restroom';p.Style=Enum.ProximityPromptStyle.Custom;p.RequiresLineOfSight=false;p.MaxActivationDistance=9;p.HoldDuration=.15;p.KeyboardKeyCode=Enum.KeyCode.E;p.GamepadKeyCode=Enum.KeyCode.ButtonX;p.Parent=self.booth.Entry;self.prompt=p\n p.Triggered:Connect(function(player) local ok,message=self:use(player);if not ok then self.owner:notice(player,message,'info') end end)\n self.booth.Entry.Touched:Connect(function(part)\n  local player=Players:GetPlayerFromCharacter(part.Parent);if not player or self.occupant then return end\n  local data=self.owner.profiles:get(player);if data and data.NeedsWater>.000001 then self:use(player) end\n end)\nend\nfunction Restroom:step(dt:number)\n for player,use in self.using do\n  if not player.Parent or player.Character~=use.root.Parent or use.human.Health<=0 then self:finish(player,false)\n  elseif os.clock()>=use.ends then self:finish(player,true) end\n end\n self.clock+=dt;if self.clock<.5 then return end;self.clock=0\n for player in self.dirty do self:send(player) end;table.clear(self.dirty)\nend\nreturn Restroom\n"},{"name":"Wrecks","class":"ModuleScript","source":"--!strict\nlocal Players=game:GetService('Players')\nlocal Config=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Config)\nlocal Economy=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Economy)\nlocal Wrecks={};Wrecks.__index=Wrecks\nfunction Wrecks.new(ocean,loot,notice,fx)\n local self=setmetatable({ocean=ocean,loot=loot,notice=notice,fx=fx,chests={},random=Random.new()},Wrecks)\n local points=workspace.UnderwaterTerrain:FindFirstChild('PointsOfInterest')\n if not points then return self end\n for _,chest in points:GetDescendants() do if chest:IsA('Model') and chest:GetAttribute('ExpeditionChest') then\n  local root=chest:FindFirstChild('ChestRoot');local lid=chest:FindFirstChild('Lid')\n  if not root or not lid or not lid:IsA('BasePart') then continue end\n  local prompt=Instance.new('ProximityPrompt');prompt.Name='OpenChest';prompt.ActionText='Open treasure chest';prompt.ObjectText=chest:GetAttribute('DisplayName') or 'Captain\\'s Cache';prompt.HoldDuration=.65;prompt.MaxActivationDistance=8;prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.GamepadKeyCode=Enum.KeyCode.ButtonX;prompt.RequiresLineOfSight=false;prompt.Style=Enum.ProximityPromptStyle.Custom;prompt.Parent=root\n  chest:SetAttribute('LidClosedCFrame',lid.CFrame)\n  local record={model=chest,root=root,lid=lid,closed=lid.CFrame,hinge=chest:GetAttribute('LidHinge'),prompt=prompt,opened=false}\n  self.chests[chest.Name]=record\n  prompt.Triggered:Connect(function(player) self:open(player,chest.Name) end)\n end end\n return self\nend\nfunction Wrecks:open(player,id:string)\n local chest=self.chests[id];local char=player.Character;local root=char and char:FindFirstChild('HumanoidRootPart');local human=char and char:FindFirstChildOfClass('Humanoid')\n if not chest or chest.opened then return false,'This chest is already open.' end\n if not root or not human or human.Health<=0 or (root.Position-chest.root.Position).Magnitude>9 then return false,'Move closer to the chest.' end\n if self.ocean.refilling or self.ocean.applied>chest.root.Position.Y+.5 then self.notice(player,'Lower the sea to uncover this chest.','info');return false,'Chest is underwater.' end\n local drops=chest.model:GetAttribute('DropCount') or 4\n local sites=chest.model:FindFirstChild('DropSites')\n if not sites or #sites:GetChildren()<drops then return false,'Treasure landing spots are unavailable.' end\n if self.loot.count+drops>Config.Ocean.maxActiveLoot+8 then return false,'Collect nearby treasure first.' end\n -- Claim the chest before animation or spawning. A second caller cannot open it again.\n chest.opened=true;chest.prompt.Enabled=false;chest.model:SetAttribute('Opened',true)\n local openedAt=workspace:GetServerTimeNow();chest.model:SetAttribute('OpenedAt',openedAt)\n local hinge=chest.hinge;local target=hinge*CFrame.Angles(math.rad(-106),0,0)*hinge:Inverse()*chest.closed\n -- The client animates every frame; replicate only the resting pose for late joiners.\n task.delay(1.7,function() if chest.model.Parent and chest.opened and chest.model:GetAttribute('OpenedAt')==openedAt then chest.lid.CFrame=target end end)\n local valueFloor=chest.model:GetAttribute('MinimumValue') or 600;local depth=chest.model:GetAttribute('LootDepth') or 42;local count=0\n for i=1,drops do\n  local site=sites:FindFirstChild('Drop_'..i)\n  if site and site:IsA('BasePart') then\n   local lootId=Economy.rollLoot(self.random,depth,valueFloor)\n   if lootId and self.loot:spawnReward(site.Position,lootId,site:GetAttribute('SurfaceNormal') or Vector3.yAxis,chest.root.Position+Vector3.new(0,2,0)) then count+=1 end\n  end\n end\n self.fx('ChestOpened',{id=id,openedAt=openedAt,position=chest.root.Position,player=player.UserId,count=count})\n self.notice(player,'Chest opened! Collect the treasure around it.','success')\n return true,'Chest opened!',count\nend\nfunction Wrecks:restart()\n for _,chest in self.chests do chest.opened=false;chest.model:SetAttribute('Opened',false);chest.model:SetAttribute('OpenedAt',nil);chest.prompt.Enabled=true;chest.lid.CFrame=chest.closed end\nend\nreturn Wrecks\n"}]]====]);for _,entry in sources do local targetParent=if entry.class=='LocalScript' then game:GetService('StarterPlayer').StarterPlayerScripts else parent;local name=if entry.class=='LocalScript' then 'SeaGameClient' else entry.name;local existing=targetParent:FindFirstChild(name);if existing and existing.ClassName~=entry.class then existing:Destroy();existing=nil end;local object=existing or Instance.new(entry.class);object.Name=name;object.Source=entry.source;object.Parent=targetParent end;print('GAMEPLAY_CODE_INSTALLED',group,#sources)