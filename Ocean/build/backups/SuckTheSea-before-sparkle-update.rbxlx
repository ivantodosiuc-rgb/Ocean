					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Loot</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000013d2</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX542B0DFAEFD845B6B39E11F46E33861B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local Config=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Config)
local Volume=require(game.ReplicatedStorage.SeaGame.Shared.OceanVolume)
local Progress=require(script.Parent.OceanProgress)
local Ocean={};Ocean.__index=Ocean
function Ocean.new()
 local self=setmetatable({level=Config.Ocean.initial,applied=Config.Ocean.initial,tiles={},queue={},grids={},clock=0,index=1,cycleLevel=0,cycle=1,refilling=false,onApplied=nil,progress=Progress.new(),ready=false},Ocean)
 local half=Config.Ocean.halfSize;local span=half
 for x=0,1 do for z=0,1 do table.insert(self.tiles,{x=-half+(x+.5)*span,z=-half+(z+.5)*span,width=span,level=Config.Ocean.initial}) end end
 workspace.Ocean:SetAttribute('WaterLevel',self.applied);workspace.Ocean:SetAttribute('MinimumWaterLevel',Config.Ocean.minimum);workspace.Ocean:SetAttribute('Expedition',self.cycle)
 return self
end
function Ocean:writeTile(tile,target:number)
 local bottom=math.floor(math.min(target,tile.level)/4)*4;local top=math.ceil(math.max(target,tile.level)/4)*4
 if top<=bottom then tile.level=target;return end
 local count=tile.width/4;local height=(top-bottom)/4;local cached=self.grids[height]
 if not cached then
  local layers=table.create(height);for y=1,height do layers[y]=table.create(count,0) end
  -- Every horizontal row has the same water level. Shared immutable-during-write rows
  -- avoid allocating hundreds of thousands of Lua values on each update.
  cached={layers=layers,grid=table.create(count,layers)};self.grids[height]=cached
 end
 for y=1,height do local value=math.clamp((target-(bottom+(y-1)*4))/4,0,1);for z=1,count do cached.layers[y][z]=value end end
 local half=tile.width/2
 local region=Region3.new(Vector3.new(tile.x-half,bottom,tile.z-half),Vector3.new(tile.x+half,top,tile.z+half))
 workspace.Terrain:WriteVoxelChannels(region,4,{LiquidOccupancy=cached.grid})
 tile.level=target
end
function Ocean:step(dt:number,power:number)
 dt=math.min(dt,.25);self.clock+=dt
 local consumed=0
 if self.ready then consumed=self.progress:consume(Volume.flow(power,Config.Ocean.BaseRemovalRate,Config.Ocean.MaxRemovalRate)*dt) end
 self.progress:step(dt)
 if self.progress.ready then self.level=Volume.level(self.progress.remaining,self.progress.total,Config.Ocean.initial,Config.Ocean.minimum) end
 local difference=math.abs(self.level-self.applied)
 local endpoint=(self.level==0 or self.level==Config.Ocean.minimum) and difference>.00001
 if #self.queue==0 and self.clock>=Config.Ocean.updatePeriod and (difference>=Config.Ocean.updateDistance or endpoint) then
  self.clock=0;self.queue=table.clone(self.tiles);self.index=1;self.cycleLevel=self.level
 end
 if #self.queue>0 then
  debug.profilebegin('SeaGame water tiles')
  for _=1,1 do
   local tile=self.queue[self.index];if not tile then break end
   self:writeTile(tile,self.cycleLevel);self.index+=1
  end
  debug.profileend()
  if self.index>#self.queue then
   table.clear(self.queue);self.applied=self.cycleLevel;workspace.Ocean:SetAttribute('WaterLevel',self.applied)
   local remaining=Volume.atLevel(self.applied,self.progress.total,Config.Ocean.initial,Config.Ocean.minimum)
   workspace.Ocean:SetAttribute('RemainingWaterVolume',remaining)
   workspace.Ocean:SetAttribute('TotalOceanVolume',self.progress.total)
   if self.onApplied then self.onApplied(self.applied) end
  end
 end
 if self.progress.ready and #self.queue==0 and math.abs(self.applied-self.level)<=Config.Ocean.updateDistance then self.ready=true end
 return consumed
end
function Ocean:canDrain():boolean return self.ready and self.progress:canDrain() end
function Ocean:isComplete():boolean return self.ready and self.progress.remaining==0 and self.applied<=Config.Ocean.minimum+.000001 end
function Ocean:snapshot()
 local total=self.progress.total
 local remaining=Volume.atLevel(self.applied,total,Config.Ocean.initial,Config.Ocean.minimum)
 return {level=self.applied,target=self.level,minimum=Config.Ocean.minimum,complete=self:isComplete(),refilling=false,cycle=1,ready=self.ready,saveStatus=self.progress.status,TotalOceanVolume=total,RemainingWaterVolume=remaining,OceanRemainingPercent=Volume.percent(remaining,total)}
end
return Ocean
]]></ProtectedString>
					<string name="ScriptGuid">{C6EE28A0-BBD7-429E-A051-526E5E4D3273}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Ocean</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000013d4</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4C7ED34312064E0FACC8EB17CA298135">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local DataStoreService=game:GetService('DataStoreService')
local HttpService=game:GetService('HttpService')
local RunService=game:GetService('RunService')
local Shared=game:GetService('ReplicatedStorage').SeaGame.Shared
local Config=require(Shared.Config);local Economy=require(Shared.Economy)
local Profiles={};Profiles.__index=Profiles
function Profiles.new(onStatus,storeOverride)
 local self=setmetatable({records={},onStatus=onStatus,session=game.JobId..HttpService:GenerateGUID(false),store=nil,closing=false},Profiles)
 if storeOverride then self.store=storeOverride
 elseif game.GameId~=0 then self.store=DataStoreService:GetDataStore(Config.DataStoreName..(if RunService:IsStudio() then '_Studio' else '')) end
 return self
end
function Profiles:get(player) local r=self.records[player];return r and r.data end
function Profiles:status(player) local r=self.records[player];return r and r.status or 'Loading' end
function Profiles:load(player)
 if self.records[player] then return self.records[player].data end
 local data=Economy.new();local persistent=self.store~=nil
 if persistent then
  local loaded=nil;local lastError='Session is still active on another server.'
  for attempt=1,4 do
   local ok,result=pcall(function()
    return self.store:UpdateAsync('u_'..player.UserId,function(old)
     old=if type(old)=='table' then old else {};local lock=old.Session
     if type(lock)=='table' and lock.Token~=self.session and type(lock.Expires)=='number' and lock.Expires>os.time() then return nil end
     return {Data=Economy.normalize(old.Data or old),Session={Token=self.session,Expires=os.time()+180}}
    end)
   end)
   if ok and result then loaded=result;break end
   if not ok then lastError=tostring(result) end
   if attempt<4 then task.wait(2^(attempt-1)) end
  end
  if loaded then data=Economy.normalize(loaded.Data)
  elseif RunService:IsStudio() then persistent=false;warn('[SeaGame] Studio save unavailable: '..lastError)
  else warn('[SeaGame] Profile load failed for '..player.UserId..': '..lastError);player:Kick('Your progress could not be loaded safely. Please rejoin in a moment.');return nil end
 end
 if not player.Parent then
  if persistent then pcall(function() self.store:UpdateAsync('u_'..player.UserId,function(old) if old and old.Session and old.Session.Token==self.session then old.Session=nil;return old end;return nil end) end) end
  return nil
 end
 self.records[player]={data=data,persistent=persistent,status=if persistent then 'Saved' else 'Session',saving=false,nextSave=os.clock()+45+(player.UserId%13),savedRevision=data.Revision}
 return data
end
function Profiles:save(player,release:boolean?)
 local r=self.records[player];if not r then return true end
 if not r.persistent then return true end
 if r.saving then return false end
 r.saving=true;local snapshot=Economy.copy(r.data);local success=false;local errorMessage='Session ownership changed.'
 for attempt=1,3 do
  local ok,result=pcall(function()
   return self.store:UpdateAsync('u_'..player.UserId,function(old)
    if type(old)~='table' or type(old.Session)~='table' or old.Session.Token~=self.session then return nil end
    return {Data=snapshot,Session=if release then nil else {Token=self.session,Expires=os.time()+180}}
   end)
  end)
  if ok and result then success=true;break end
  if not ok then errorMessage=tostring(result) end
  if attempt<3 then task.wait(attempt) end
 end
 r.saving=false;r.status=if success then 'Saved' else 'Retrying';r.nextSave=os.clock()+(if success then 45 else 12)
 if success then r.savedRevision=snapshot.Revision else warn('[SeaGame] Save retry required for '..player.UserId..': '..errorMessage) end
 if self.onStatus and player.Parent then self.onStatus(player,r.status) end
 return success
end
function Profiles:release(player)
 local r=self.records[player];if not r then return end
 local deadline=os.clock()+12;while r.saving and os.clock()<deadline do task.wait(.1) end
 self:save(player,true);self.records[player]=nil
end
function Profiles:tick()
 if self.closing then return end
 for player,r in self.records do
  if r.persistent and not r.saving and os.clock()>=r.nextSave then r.nextSave=os.clock()+45;task.spawn(function() self:save(player,false) end);break end
 end
end
function Profiles:close()
 self.closing=true;local remaining=0
 for player in self.records do remaining+=1;task.spawn(function() self:release(player);remaining-=1 end) end
 local deadline=os.clock()+25;while remaining>0 and os.clock()<deadline do task.wait(.1) end
end
return Profiles
]]></ProtectedString>
					<string name="ScriptGuid">{A49C2104-5709-4D2F-85A1-0D71577887E1}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Profiles</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000013d6</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7EAF7E7883B94AB28BFEEEC6F0A355CD">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players=game:GetService('Players')
local Config=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Config)
local Economy=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Economy)
local Wrecks={};Wrecks.__index=Wrecks
function Wrecks.new(ocean,loot,notice,fx)
 local self=setmetatable({ocean=ocean,loot=loot,notice=notice,fx=fx,chests={},random=Random.new()},Wrecks)
 local points=workspace.UnderwaterTerrain:FindFirstChild('PointsOfInterest')
 if not points then return self end
 for _,chest in points:GetDescendants() do if chest:IsA('Model') and chest:GetAttribute('ExpeditionChest') then
  local root=chest:FindFirstChild('ChestRoot');local lid=chest:FindFirstChild('Lid')
  if not root or not lid or not lid:IsA('BasePart') then continue end
  local prompt=Instance.new('ProximityPrompt');prompt.Name='OpenChest';prompt.ActionText='Open treasure chest';prompt.ObjectText=chest:GetAttribute('DisplayName') or 'Captain\'s Cache';prompt.HoldDuration=.65;prompt.MaxActivationDistance=8;prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.GamepadKeyCode=Enum.KeyCode.ButtonX;prompt.RequiresLineOfSight=false;prompt.Style=Enum.ProximityPromptStyle.Custom;prompt.Parent=root
  chest:SetAttribute('LidClosedCFrame',lid.CFrame)
  local record={model=chest,root=root,lid=lid,closed=lid.CFrame,hinge=chest:GetAttribute('LidHinge'),prompt=prompt,opened=false}
  self.chests[chest.Name]=record
  prompt.Triggered:Connect(function(player) self:open(player,chest.Name) end)
 end end
 return self
end
function Wrecks:open(player,id:string)
 local chest=self.chests[id];local char=player.Character;local root=char and char:FindFirstChild('HumanoidRootPart');local human=char and char:FindFirstChildOfClass('Humanoid')
 if not chest or chest.opened then return false,'This chest is already open.' end
 if not root or not human or human.Health<=0 or (root.Position-chest.root.Position).Magnitude>9 then return false,'Move closer to the chest.' end
 if self.ocean.refilling or self.ocean.applied>chest.root.Position.Y+.5 then self.notice(player,'Lower the sea to uncover this chest.','info');return false,'Chest is underwater.' end
 local drops=chest.model:GetAttribute('DropCount') or 4
 local sites=chest.model:FindFirstChild('DropSites')
 if not sites or #sites:GetChildren()<drops then return false,'Treasure landing spots are unavailable.' end
 if self.loot.count+drops>Config.Ocean.maxActiveLoot+8 then return false,'Collect nearby treasure first.' end
 -- Claim the chest before animation or spawning. A second caller cannot open it again.
 chest.opened=true;chest.prompt.Enabled=false;chest.model:SetAttribute('Opened',true)
 local openedAt=workspace:GetServerTimeNow();chest.model:SetAttribute('OpenedAt',openedAt)
 local hinge=chest.hinge;local target=hinge*CFrame.Angles(math.rad(-106),0,0)*hinge:Inverse()*chest.closed
 -- The client animates every frame; replicate only the resting pose for late joiners.
 task.delay(1.7,function() if chest.model.Parent and chest.opened and chest.model:GetAttribute('OpenedAt')==openedAt then chest.lid.CFrame=target end end)
 local valueFloor=chest.model:GetAttribute('MinimumValue') or 600;local depth=chest.model:GetAttribute('LootDepth') or 42;local count=0
 for i=1,drops do
  local site=sites:FindFirstChild('Drop_'..i)
  if site and site:IsA('BasePart') then
   local lootId=Economy.rollLoot(self.random,depth,valueFloor)
   if self.loot:spawnReward(site.Position,lootId,site:GetAttribute('SurfaceNormal') or Vector3.yAxis,chest.root.Position+Vector3.new(0,2,0)) then count+=1 end
  end
 end
 self.fx('ChestOpened',{id=id,openedAt=openedAt,position=chest.root.Position,player=player.UserId,count=count})
 self.notice(player,'Chest opened! Collect the treasure around it.','success')
 return true,'Chest opened!',count
end
function Wrecks:restart()
 for _,chest in self.chests do chest.opened=false;chest.model:SetAttribute('Opened',false);chest.model:SetAttribute('OpenedAt',nil);chest.prompt.Enabled=true;chest.lid.CFrame=chest.closed end
end
return Wrecks
]]></ProtectedString>
