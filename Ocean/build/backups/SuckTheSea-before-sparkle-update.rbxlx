		<Item class="ColorCorrectionEffect" referent="RBXDB143F6B669D4151B457C7C3F0C7FD48">
			<Properties>
				<float name="Brightness">0</float>
				<float name="Contrast">0.0450000018</float>
				<float name="Saturation">0.0700000003</float>
				<Color3 name="TintColor">
					<R>1</R>
