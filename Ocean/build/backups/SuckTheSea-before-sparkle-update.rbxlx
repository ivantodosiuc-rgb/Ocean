				<Item class="ModuleScript" referent="RBXF80AD7FBCE074216BEAFE0FD2D48354E">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
local Config={}
Config.Version=1
Config.DataStoreName='SuckTheSea_Player_v1'
Config.Straws={
 {id='BasicStraw',name='Basic Straw',price=0,power=1.25,speed=1,reach=26,color=Color3.fromRGB(250,139,116),tag='STARTER'},
 {id='ColorfulStraw',name='Colorful Straw',price=150,power=2,speed=1.05,reach=27,color=Color3.fromRGB(49,190,175),tag='PLAYFUL'},
 {id='BambooStraw',name='Bamboo Straw',price=600,power=4,speed=1.1,reach=29,color=Color3.fromRGB(136,201,74),tag='NATURAL'},
 {id='GoldenStraw',name='Golden Straw',price=2000,power=8,speed=1.15,reach=30,color=Color3.fromRGB(255,200,87),tag='GOLDEN'},
 {id='CrystalStraw',name='Crystal Straw',price=7500,power=16,speed=1.2,reach=32,color=Color3.fromRGB(73,189,235),tag='CRYSTAL'},
 {id='OceanVacuum',name='Ocean Vacuum',price=25000,power=35,speed=1.25,reach=34,color=Color3.fromRGB(21,139,137),tag='TURBINE'},
 {id='CoralTwister',name='Coral Twister',price=65000,power=55,speed=1.3,reach=36,color=Color3.fromRGB(247,121,130),tag='CORAL'},
 {id='TidalCoil',name='Tidal Coil',price=160000,power=85,speed=1.4,reach=38,color=Color3.fromRGB(68,178,239),tag='TIDAL'},
 {id='StarSiphon',name='Star Siphon',price=420000,power=130,speed=1.45,reach=40,color=Color3.fromRGB(170,132,229),tag='CELESTIAL'},
 {id='Leviathan',name='Leviathan',price=1000000,power=200,speed=1.5,reach=42,color=Color3.fromRGB(32,116,131),tag='LEGENDARY'},
}
-- Display-only offer. It is deliberately absent from the server's coin catalogue.
Config.PremiumStraw={id='PrismStraw',name='Prism Straw',robux=79,power=35,speed=1.25,reach=34,comparisonTier=6,purchasingEnabled=false}
Config.Restroom={PersonalOceanFraction=.05,UseSeconds=5,Distance=10,StarterMusselRespawn=45,Sound='rbxassetid://9126175899'}
Config.Loot=require(script.Parent.LootCatalog)
Config.StrawById={};for _,item in Config.Straws do Config.StrawById[item.id]=item end
Config.LootById={};for _,item in Config.Loot do Config.LootById[item.id]=item end
Config.Capacities={5,7,10,15,20}
Config.BackpackPrices={100,300,800,2000}
Config.WalkSpeeds={16,18,20,23,26,30}
Config.WalkPrices={100,250,650,1400,3000}
Config.Upgrades={
 {id='Power',name='Suction Power',description='+20% power per level',icon='Power',max=15},
 {id='Speed',name='Suction Speed',description='+10% suction speed per level',icon='Speed',max=15},
 {id='Walk',name='Walk Speed',description='Explore the shore faster',icon='Walk',max=5},
 {id='Backpack',name='Backpack',description='Bring back more treasure',icon='Backpack',max=4},
}
Config.UpgradeById={};for _,u in Config.Upgrades do Config.UpgradeById[u.id]=u end
Config.ShopNames={Straws='Finn',Upgrades='Maya',Sell='Captain Shell'}
Config.ShopDistance=23
Config.PickupDistance=8
Config.SuctionReach=26
Config.Ocean={
 initial=0,minimum=-68,bottom=-84,halfSize=384,
 -- Drainable volume of the 768 x 768 x 68 stud ocean. No rounding of gameplay data.
 TotalOceanVolume=40_108_032,BaseRemovalRate=200,MaxRemovalRate=800_000,
 ProgressStore='SuckTheSea_Ocean_v1',WorldKey='StarterOcean_v1',ShardCount=16,
 CommitInterval=8,PollInterval=2,LeaseSeconds=120,
 updatePeriod=.6,updateDistance=.000001,
 maxActiveLoot=56,lootSpacing=5,lootRadius=240,lootMargin=.12,
}
Config.Audio={Click='rbxasset://sounds/volume_slider.ogg',Collect='rbxasset://sounds/volume_slider.ogg',Water='rbxasset://sounds/action_swim.mp3',Splash='rbxasset://sounds/impact_water.mp3'}
return table.freeze(Config)
]]></ProtectedString>
						<string name="ScriptGuid">{AE46BD08-DE82-42BE-84E8-DAF5BAE073B7}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Config</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000013c7</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1CDB537300874960BC8ADD3A56BCB658">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
local Config=require(script.Parent.Config)
local Economy={}
local function integer(value:any,default:number,maximum:number):number
 if type(value)~='number' or value~=value or value==math.huge or value==-math.huge then return default end
 return math.clamp(math.floor(value),0,maximum)
end
function Economy.new()
 return {Version=Config.Version,Coins=0,Owned={BasicStraw=true},Equipped='BasicStraw',Upgrades={Power=0,Speed=0,Walk=0,Backpack=0},Bag={},Revision=0,NeedsWater=0}
end
function Economy.capacity(data):number return Config.Capacities[data.Upgrades.Backpack+1] end
function Economy.count(data):number local n=0;for id,count in data.Bag do if Config.LootById[id] then n+=count end end;return n end
function Economy.value(data):number local n=0;for id,count in data.Bag do local item=Config.LootById[id];if item then n+=item.value*count end end;return n end
function Economy.normalize(raw:any)
 local data=Economy.new();if type(raw)~='table' then return data end
 data.Coins=integer(raw.Coins,0,1e12);data.Revision=integer(raw.Revision,0,1e12)
 if type(raw.NeedsWater)=='number' and raw.NeedsWater==raw.NeedsWater and math.abs(raw.NeedsWater)<math.huge then data.NeedsWater=math.clamp(raw.NeedsWater,0,Config.Ocean.TotalOceanVolume*Config.Restroom.PersonalOceanFraction) end
 if type(raw.Owned)=='table' then for id,value in raw.Owned do if Config.StrawById[id] and value==true then data.Owned[id]=true end end end
 if type(raw.Equipped)=='string' and data.Owned[raw.Equipped] then data.Equipped=raw.Equipped end
 if type(raw.Upgrades)=='table' then for _,u in Config.Upgrades do data.Upgrades[u.id]=integer(raw.Upgrades[u.id],0,u.max) end end
 local remaining=20
 if type(raw.Bag)=='table' then for _,item in Config.Loot do local count=integer(raw.Bag[item.id],0,remaining);if count>0 then data.Bag[item.id]=count;remaining-=count end end end
 while Economy.count(data)>Economy.capacity(data) and data.Upgrades.Backpack<4 do data.Upgrades.Backpack+=1 end
 return data
end
function Economy.copy(data)
 return {Version=Config.Version,Coins=data.Coins,Owned=table.clone(data.Owned),Equipped=data.Equipped,Upgrades=table.clone(data.Upgrades),Bag=table.clone(data.Bag),Revision=data.Revision,NeedsWater=data.NeedsWater}
end
function Economy.stats(data)
 local straw=Config.StrawById[data.Equipped]
 return {power=straw.power*(1+data.Upgrades.Power*.2),speed=straw.speed*(1+data.Upgrades.Speed*.1),reach=straw.reach,walk=Config.WalkSpeeds[data.Upgrades.Walk+1],capacity=Economy.capacity(data)}
end
function Economy.upgradeCost(data,id:string):number?
 local def=Config.UpgradeById[id];if not def then return nil end
 local level=data.Upgrades[id];if level>=def.max then return nil end
 if id=='Backpack' then return Config.BackpackPrices[level+1] end
 if id=='Walk' then return Config.WalkPrices[level+1] end
 return math.floor((if id=='Power' then 100 else 125)*(if id=='Power' then 1.65 else 1.7)^level)
end
function Economy.buyStraw(data,id:string)
 local item=Config.StrawById[id];if not item then return false,'Unknown straw.' end
 if data.Owned[id] then return false,'You already own this straw.' end
 if data.Coins<item.price then return false,'Not enough Coins.' end
 data.Coins-=item.price;data.Owned[id]=true;data.Equipped=id;data.Revision+=1
 return true,'New straw equipped!',item.price
end
function Economy.equip(data,id:string)
 if not Config.StrawById[id] or not data.Owned[id] then return false,'You do not own this straw.' end
 if data.Equipped==id then return false,'Already equipped.' end
 data.Equipped=id;data.Revision+=1;return true,'Straw equipped!'
end
function Economy.upgrade(data,id:string)
 if not Config.UpgradeById[id] then return false,'Unknown upgrade.' end
 local price=Economy.upgradeCost(data,id);if not price then return false,'Fully upgraded!' end
 if data.Coins<price then return false,'Not enough Coins.' end
 data.Coins-=price;data.Upgrades[id]+=1;data.Revision+=1;return true,'Upgrade complete!',price
end
function Economy.addLoot(data,id:string)
 if not Config.LootById[id] then return false,'Unknown treasure.' end
 if Economy.count(data)>=Economy.capacity(data) then return false,'BACKPACK FULL!' end
 data.Bag[id]=(data.Bag[id] or 0)+1;data.Revision+=1;return true
end
function Economy.sell(data)
 local total=Economy.value(data);if total<=0 then return false,'Your backpack is empty.',0 end
 data.Bag={};data.Coins+=total;data.Revision+=1;return true,'Treasure sold!',total
end
function Economy.rollLoot(random,depth:number?,minimumValue:number?)
 local maxDepth=depth or math.huge;local minimum=minimumValue or 0;local total=0;local last=Config.Loot[1].id
 for _,item in Config.Loot do if (item.minDepth or 0)<=maxDepth and item.value>=minimum then total+=item.weight;last=item.id end end
 if total<=0 then return Config.Loot[1].id end
 local roll=random:NextNumber(0,total);local acc=0
 for _,item in Config.Loot do if (item.minDepth or 0)<=maxDepth and item.value>=minimum then acc+=item.weight;if roll<acc then return item.id end end end
 return last
end
return Economy
]]></ProtectedString>
