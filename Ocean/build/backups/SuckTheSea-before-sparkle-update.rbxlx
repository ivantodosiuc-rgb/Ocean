 self.sea=C.frame(self.root,'OceanProgress',UDim2.fromOffset(320,70),UDim2.new(.5,0,0,10));self.sea.BackgroundTransparency=1;self.sea.AnchorPoint=Vector2.new(.5,0)
 local seaShadow=C.frame(self.sea,'Shadow',UDim2.fromScale(1,1),UDim2.fromOffset(0,3),T.DeepTeal);C.corner(seaShadow,16)
 local seaBody=C.panel(self.sea,'Body',UDim2.fromScale(1,1),nil,T.Paper,16)
 self.wave=C.waveIcon(seaBody,UDim2.fromOffset(12,9));self.waveScale=C.new('UIScale',{Scale=1},self.wave)
 C.label(seaBody,'OCEAN REMAINING',UDim2.new(1,-74,0,17),UDim2.fromOffset(61,8),12,T.Muted,T.Bold)
 self.seaLabel=C.label(seaBody,'--.--%',UDim2.new(1,-74,0,30),UDim2.fromOffset(60,23),27,T.Ink,T.Bold);self.seaLabel.Name='Percent'
 local seaTrack=C.frame(seaBody,'Track',UDim2.new(1,-28,0,7),UDim2.fromOffset(14,56),T.Aqua);C.corner(seaTrack,4)
 self.seaFill=C.frame(seaTrack,'Fill',UDim2.fromScale(1,1),nil,T.Teal);C.corner(self.seaFill,4)
 self.seaNumber=C.new('NumberValue',{Name='DisplayedOceanPercent',Value=100},self.gui)
 self.seaNumber.Changed:Connect(function(value)
  local text=string.format('%.2f%%',math.clamp(value,0,100));if self.seaLabel.Text~=text then self.seaLabel.Text=text end
  self.seaFill.Size=UDim2.fromScale(math.clamp(value/100,0,1),1)
 end)
 self.slot=C.panel(self.root,'EquippedStraw',UDim2.fromOffset(254,66),UDim2.new(.5,-127,1,-82),T.Cream,17)
 self.toolArt=C.viewport(self.slot,'Tools','BasicStraw',UDim2.fromOffset(58,61),UDim2.fromOffset(1,2))
 self.slotCaption=C.label(self.slot,'EQUIPPED',UDim2.fromOffset(180,16),UDim2.fromOffset(62,10),11,T.Muted,T.Bold)
 self.toolLabel=C.label(self.slot,'Basic Straw',UDim2.fromOffset(183,28),UDim2.fromOffset(62,25),20,T.Ink,T.Font)
 local slotButton=C.new('TextButton',{Name='Equip',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text='',AutoButtonColor=false},self.slot)
 slotButton.Activated:Connect(function() callbacks.stop();callbacks.action('ToggleHeld') end)
 self.hint=C.panel(self.root,'ActionHint',UDim2.fromOffset(360,34),UDim2.new(.5,-180,1,-130),T.Ink,12)
 self.hintLabel=C.label(self.hint,'Find the shore. Hold right mouse to sip.',UDim2.new(1,-16,1,0),UDim2.fromOffset(8,0),14,T.Cream,T.Body);self.hintLabel.TextXAlignment=Enum.TextXAlignment.Center
 self.touchHolder,self.touchButton,self.touchScale=C.button(self.root,'HoldToSip','HOLD\nTO SIP',UDim2.fromOffset(92,92),UDim2.new(1,-118,1,-227),T.Teal,nil)
 self.touchButton.TextSize=19;self.touchHolder.Visible=UserInputService.TouchEnabled;C.new('UIAspectRatioConstraint',{AspectRatio=1},self.touchHolder)
 self.toast=C.panel(self.root,'Toast',UDim2.fromOffset(370,58),UDim2.new(.5,-185,0,88),T.Cream,16);self.toast.Visible=false
 self.toastLabel=C.label(self.toast,'',UDim2.new(1,-28,1,-12),UDim2.fromOffset(14,6),17,T.Ink,T.Bold);self.toastLabel.TextWrapped=true;self.toastLabel.TextXAlignment=Enum.TextXAlignment.Center
 self.toastScale=C.new('UIScale',{Scale=1},self.toast)
 self.dim=C.new('TextButton',{Name='Dim',Size=UDim2.fromScale(1,1),BackgroundColor3=T.Ink,BackgroundTransparency=1,BorderSizePixel=0,Text='',AutoButtonColor=false,Visible=false,ZIndex=5},self.root);self.dim.Activated:Connect(function() self:close() end)
 self.window=C.new('CanvasGroup',{Name='ShopWindow',Size=UDim2.fromOffset(780,600),AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),BackgroundColor3=T.Cream,BorderSizePixel=0,Visible=false,ZIndex=6,GroupTransparency=0},self.root);C.corner(self.window,22);C.stroke(self.window,T.Ink,3)
 self.windowScale=C.new('UIScale',{Scale=1},self.window)
 self.accent=C.frame(self.window,'Header',UDim2.new(1,0,0,91),nil,T.Aqua);C.corner(self.accent,22)
 C.frame(self.accent,'SquareBottom',UDim2.new(1,0,0,22),UDim2.new(0,0,1,-22),T.Aqua)
 self.headerTitle=C.label(self.window,'STRAWS',UDim2.new(1,-160,0,34),UDim2.fromOffset(87,14),30,T.Ink,T.Font)
 self.headerSubtitle=C.label(self.window,'Finn\'s collection',UDim2.new(1,-160,0,25),UDim2.fromOffset(88,49),15,T.Muted,T.Body)
 self.headerArt=C.viewport(self.window,'Tools','ColorfulStraw',UDim2.fromOffset(70,78),UDim2.fromOffset(9,4))
 local _,close=C.button(self.window,'Close','',UDim2.fromOffset(44,42),UDim2.new(1,-59,0,20),T.Paper,function() self:close() end)
 for _,a in {45,-45} do local slash=C.frame(close,'Cross',UDim2.fromOffset(18,3),UDim2.fromScale(.5,.5),T.Ink);slash.AnchorPoint=Vector2.new(.5,.5);slash.Rotation=a;C.corner(slash,2) end
 self.scroll=C.new('ScrollingFrame',{Name='Items',Size=UDim2.new(1,-30,1,-114),Position=UDim2.fromOffset(15,101),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=5,ScrollBarImageColor3=T.DeepTeal,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollingDirection=Enum.ScrollingDirection.Y,ElasticBehavior=Enum.ElasticBehavior.WhenScrollable},self.window)
 C.new('UIPadding',{PaddingLeft=UDim.new(0,3),PaddingRight=UDim.new(0,9),PaddingTop=UDim.new(0,3),PaddingBottom=UDim.new(0,8)},self.scroll)
 self.grid=C.new('UIGridLayout',{CellPadding=UDim2.fromOffset(12,12),CellSize=UDim2.fromOffset(230,240),SortOrder=Enum.SortOrder.LayoutOrder},self.scroll)
 self.footer=C.frame(self.window,'SellFooter',UDim2.new(1,-36,0,79),UDim2.new(0,18,1,-92),T.Cream);self.footer.Visible=false
 self.sellTotal=C.label(self.footer,'TOTAL  0',UDim2.new(.45,0,0,34),UDim2.new(),23,T.Ink,T.Font)
 self.sellHint=C.label(self.footer,'Every little find adds up.',UDim2.new(.5,0,0,24),UDim2.fromOffset(0,36),13,T.Muted,T.Body)
 self.sellHolder,self.sellButton=C.button(self.footer,'SellAll','SELL ALL',UDim2.new(.48,0,0,51),UDim2.new(.52,0,0,9),T.Gold,function() callbacks.action('SellAll') end)
 self.comfort=ComfortUI.new(self)
 UserInputService:GetPropertyChangedSignal('TouchEnabled'):Connect(function() self.touchHolder.Visible=UserInputService.TouchEnabled;self:resize() end)
 self.root:GetPropertyChangedSignal('AbsoluteSize'):Connect(function() self:resize() end)
 self:resize();return self
end
function UI:resize()
 local v=self.root.AbsoluteSize;if v.X<1 then return end
 local compact=v.X<650;self.compact=compact
 local seaWidth=if compact then math.min(320,v.X-24) elseif v.X<850 then 280 else 320
 local chipWidth=if compact then math.floor((v.X-36)/2) else math.min(202,math.floor((v.X-seaWidth-60)/2))
 self.coins.Size=UDim2.fromOffset(chipWidth,62);self.coins.Position=UDim2.fromOffset(12,if compact then 92 else 10)
 self.bag.Size=UDim2.fromOffset(chipWidth,62);self.bag.Position=UDim2.new(1,-12-chipWidth,0,if compact then 92 else 10)
 self.coinLabel.TextSize=if chipWidth<180 then 22 else 26
 self.bagLabel.Size=UDim2.new(1,-66,0,24);self.bagLabel.TextSize=if chipWidth<180 then 20 else 22
 self.sea.Size=UDim2.fromOffset(seaWidth,70);self.sea.Position=UDim2.new(.5,0,0,10)
 self.toast.Size=UDim2.fromOffset(math.min(v.X-30,390),58);self.toast.AnchorPoint=Vector2.new(.5,0);self.toast.Position=UDim2.new(.5,0,0,if compact then 266 else 148);self.toast.ZIndex=12
 self.hint.Size=UDim2.fromOffset(math.min(v.X-32,360),34);self.hint.AnchorPoint=Vector2.new(.5,0);self.hint.Position=UDim2.new(.5,0,1,if compact then -125 else -130)
 local w=math.min(800,v.X-28);local h=math.min(if self.shop=='Straws' or self.shop=='Premium' or w<530 then 615 else 520,v.Y-28)
 self.window.Size=UDim2.fromOffset(w,h)
 local columns=if self.shop=='Upgrades' then (if w<530 then 1 else 2) elseif self.shop=='Sell' then (if w<570 then 1 else 2) else math.clamp(math.floor((w-30)/214),1,3)
 local short=v.Y<450
 local usable=w-42;self.grid.CellSize=UDim2.fromOffset(math.floor((usable-12*(columns-1))/columns),if self.shop=='Sell' then 89 elseif self.shop=='Upgrades' then 185 elseif short then 170 else 238)
 for _,card in self.cards do if card:GetAttribute('StrawCard') then
  local art=card.Art;art.Size=if short then UDim2.fromOffset(58,100) else UDim2.new(1,-28,0,93);art.Position=if short then UDim2.fromOffset(7,10) else UDim2.fromOffset(14,29)
  card.Pill.Visible=not short
  for _,name in {'Title','Power','Price'} do local label=card[name];label.TextXAlignment=if short then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center;label.Size=UDim2.new(1,if short then -86 else -20,0,24) end
  card.Title.Position=if short then UDim2.fromOffset(75,12) else UDim2.fromOffset(10,117);card.Title.TextSize=if short then 17 else 19
  card.Power.Position=if short then UDim2.fromOffset(75,42) else UDim2.fromOffset(10,141);card.Power.TextSize=if short then 12 else 13
  card.Price.Position=if short then UDim2.fromOffset(75,72) else UDim2.fromOffset(10,161);card.Price.TextSize=if short then 16 else 17
  card.Purchase.Position=UDim2.fromOffset(11,if short then 116 else 187);card.Purchase.Size=UDim2.new(1,-22,0,44)
 end end
 self.headerTitle.TextSize=if w<420 then 23 else 30
 if self.shop=='Premium' then self.headerTitle.Text=if w<530 then 'PRISM STRAW' else 'A SPLASH OF COLOUR' end
 self.headerSubtitle.TextSize=if w<420 then 13 else 15
 self.sellTotal.TextSize=if w<420 then 19 else 23
 self.sellHint.Visible=w>=420
 local portrait=v.X<530;self.slot.Size=UDim2.fromOffset(if portrait then 190 else 254,if portrait then 60 else 66);self.slot.Position=UDim2.new(.5,if portrait then -95 else -127,1,if portrait then -78 else -82)
 self.toolArt.Size=UDim2.fromOffset(if portrait then 44 else 58,if portrait then 56 else 61)
 self.toolLabel.Position=UDim2.fromOffset(if portrait then 50 else 62,25);self.toolLabel.Size=UDim2.new(1,if portrait then -56 else -71,0,28);self.toolLabel.TextSize=if portrait then 17 else 20
 self.slotCaption.Position=UDim2.fromOffset(if portrait then 50 else 62,10)
 if w<530 and self.shop and self.shop~='Premium' then self.headerTitle.Text=if self.shop=='Straws' then 'STRAWS' elseif self.shop=='Upgrades' then 'UPGRADES' else 'TREASURES';self.headerSubtitle.Text=Config.ShopNames[self.shop]..'\'s shop' end
 if UserInputService.TouchEnabled then self.touchHolder.Position=UDim2.new(1,-112,1,if v.Y<450 then -206 else -230) end
 if self.comfort then self.comfort:resize(v) end
end
function UI:toastMessage(message,kind)
 self.toastId+=1;local id=self.toastId;self.toast.Visible=true;self.toast.BackgroundColor3=if kind=='warning' then T.PaleGold elseif kind=='success' then T.Aqua else T.Cream
 self.toastLabel.Text=message;self.toastScale.Scale=.88;C.tween(self.toastScale,.3,{Scale=1},Enum.EasingStyle.Back)
 task.delay(3,function() if self.toastId==id then C.tween(self.toastScale,.15,{Scale=.92});task.wait(.15);if self.toastId==id then self.toast.Visible=false end end end)
end
function UI:update(state)
 if self.state and state.revision<self.state.revision then return end
 local previous=self.state;self.state=state;C.tween(self.coinValue,.5,{Value=state.coins})
 self.bagLabel.Text=string.format('%d / %d',state.count,state.capacity);C.tween(self.bagFill,.3,{Size=UDim2.fromScale(state.count/state.capacity,1),BackgroundColor3=if state.count>=state.capacity then T.Coral else T.Teal})
 if previous and previous.count<state.count then self.bagScale.Scale=1.09;C.tween(self.bagScale,.3,{Scale=1},Enum.EasingStyle.Back) end
 self.toolLabel.Text=Config.StrawById[state.equipped].name
 if not previous or previous.equipped~=state.equipped then self.toolArt:Destroy();self.toolArt=C.viewport(self.slot,'Tools',state.equipped,UDim2.fromOffset(58,61),UDim2.fromOffset(1,2));self:resize() end
 if self.shop then self:refreshShop() end
end
function UI:updateWorld(world)
 self.world=world
 if world.ready==false then self.seaLabel.Text='--.--%';return end
 local percent=world.OceanRemainingPercent
 if type(percent)~='number' or percent~=percent then return end
 self.sea:SetAttribute('ServerRemainingPercent',percent)
 if self.seaTarget==nil then self.seaNumber.Value=percent;self.seaLabel.Text=string.format('%.2f%%',percent)
 elseif math.abs(self.seaTarget-percent)>.000000001 then
  if self.seaTween then self.seaTween:Cancel() end
  self.seaTween=C.tween(self.seaNumber,.65,{Value=percent},Enum.EasingStyle.Quad)
 end
 self.seaTarget=percent
end
function UI:setHeld(held)
 if self.held==held then return end;self.held=held
 local key=if UserInputService.PreferredInput==Enum.PreferredInput.Touch then 'TAP' elseif UserInputService.PreferredInput==Enum.PreferredInput.Gamepad then 'Y' else '1'
 self.slotCaption.Text=key..(if held then '  /  PUT AWAY' else '  /  TAKE OUT')
 self.slot.BackgroundColor3=if held then T.Cream else T.Sand
end
function UI:hintState(near,sucking)
 if self.comfort and (self.comfort.using or self.comfort.percent>=100) then self.hintLabel.Text=if self.comfort.using then 'A little shore break...' else 'Restroom full! Visit the wooden WC cabin.';self.touchButton.Text='VISIT\nTHE WC';return end
 self.hintLabel.Text=if self.world.ready==false or self.world.saveStatus=='Retrying' then 'The ocean is syncing. One moment...' elseif self.world.complete then 'Ocean uncovered! Explore every last treasure.' elseif sucking then 'Sipping the sea... uncovering treasure!' elseif self.state and self.state.count>=self.state.capacity then 'Backpack full! Visit Captain Shell.' elseif near then (if UserInputService.TouchEnabled then 'Hold SIP to uncover the shore.' elseif UserInputService.GamepadEnabled then 'Hold RT to sip the sea.' else 'Hold RIGHT MOUSE to sip the sea.') else 'Find the shore. Uncover what lies below.'
 if self.waveActive~=sucking then self.waveActive=sucking;C.tween(self.waveScale,.2,{Scale=if sucking then 1.035 else 1}) end
 self.touchButton.BackgroundColor3=if sucking then T.Gold elseif near then T.Teal else T.Sand
 self.touchButton.Text=if sucking then 'SIPPING...' else 'HOLD\nTO SIP'
end
function UI:open(shop)
 if (not Config.ShopNames[shop] and shop~='Premium') or not self.state or self.comfort.using then return end
 self.callbacks.stop();self.closing+=1;self.shop=shop;self.dim.Visible=true;self.window.Visible=true;self.window.GroupTransparency=1;self.windowScale.Scale=.94;self.window.Position=UDim2.new(.5,0,.5,22)
 self:refreshShop();self:resize();C.tween(self.dim,.2,{BackgroundTransparency=.68});C.tween(self.window,.24,{Position=UDim2.fromScale(.5,.5),GroupTransparency=0});C.tween(self.windowScale,.28,{Scale=1},Enum.EasingStyle.Back)
 if UserInputService.GamepadEnabled then GuiService.SelectedObject=self.window.Close.Button end
end
function UI:close()
 if not self.shop then return end;self.shop=nil;self.closing+=1;local id=self.closing
 C.tween(self.dim,.16,{BackgroundTransparency=1});C.tween(self.window,.16,{GroupTransparency=1,Position=UDim2.new(.5,0,.5,14)});C.tween(self.windowScale,.16,{Scale=.96});GuiService.SelectedObject=nil
 task.delay(.17,function() if id==self.closing then self.window.Visible=false;self.dim.Visible=false end end)
end
function UI:clearCards()
 for _,card in self.cards do card:Destroy() end;self.cards={}
end
function UI:card(name,index)
 local card=C.panel(self.scroll,name,UDim2.new(),nil,T.Paper,15);card.LayoutOrder=index;table.insert(self.cards,card);return card
end
function UI:refreshShop()
 if not self.shop or not self.state then return end
 local scrollPosition=self.scroll.CanvasPosition;self:clearCards();local s=self.state;local shop=self.shop
 if shop=='Premium' then
  self.headerTitle.Text='A SPLASH OF COLOUR';self.headerSubtitle.Text='Prism collection · Special straw';self.accent.BackgroundColor3=Color3.fromRGB(230,214,250);self.accent.SquareBottom.BackgroundColor3=self.accent.BackgroundColor3
  self.headerArt:Destroy();self.headerArt=C.viewport(self.window,'Tools','PrismStraw',UDim2.fromOffset(70,78),UDim2.fromOffset(9,4));self.footer.Visible=false;self.scroll.Size=UDim2.new(1,-30,1,-114)
  self.comfort:renderShop();self:resize();return
 end
 self.headerTitle.Text=if shop=='Straws' then 'THE STRAW SHACK' elseif shop=='Upgrades' then 'A LITTLE MORE POWER' else 'TREASURE TRADER'
 self.headerSubtitle.Text=if shop=='Straws' then 'Finn  /  Small straw. Big adventures.' elseif shop=='Upgrades' then 'Maya  /  Make your next trip count.' else 'Captain Shell  /  Turn finds into fortune.'
 local color=if shop=='Straws' then T.Aqua elseif shop=='Upgrades' then Color3.fromRGB(255,206,183) else T.PaleGold
 self.accent.BackgroundColor3=color;self.accent.SquareBottom.BackgroundColor3=color
 self.headerArt:Destroy();self.headerArt=C.viewport(self.window,if shop=='Straws' then 'Tools' elseif shop=='Upgrades' then 'Icons' else 'Loot',if shop=='Straws' then 'ColorfulStraw' elseif shop=='Upgrades' then 'Power' else 'TreasureChest',UDim2.fromOffset(70,78),UDim2.fromOffset(9,4))
 self.footer.Visible=shop=='Sell';self.scroll.Size=UDim2.new(1,-30,1,if shop=='Sell' then -205 else -114)
 if shop=='Straws' then
  for i,item in Config.Straws do
   local card=self:card(item.id,i);card:SetAttribute('StrawCard',true);C.pill(card,item.tag,item.color:Lerp(T.Paper,.45),UDim2.fromOffset(88,21),UDim2.fromOffset(10,9))
   C.viewport(card,'Tools',item.id,UDim2.new(1,-28,0,93),UDim2.fromOffset(14,29)).Name='Art'
   local title=C.label(card,item.name,UDim2.new(1,-20,0,26),UDim2.fromOffset(10,117),19,T.Ink,T.Font);title.Name='Title';title.TextXAlignment=Enum.TextXAlignment.Center
   local power=C.label(card,string.format('%gx · %gx speed · %d studs',item.power,item.speed,item.reach),UDim2.new(1,-20,0,20),UDim2.fromOffset(10,143),12,T.Muted,T.Body);power.Name='Power';power.TextXAlignment=Enum.TextXAlignment.Center
   local owned=s.owned[item.id];local equipped=s.equipped==item.id
   local price=C.label(card,if owned then 'OWNED' else C.number(item.price)..' Coins',UDim2.new(1,-20,0,24),UDim2.fromOffset(10,163),17,T.Ink,T.Bold);price.Name='Price';price.TextXAlignment=Enum.TextXAlignment.Center
   local _,button=C.button(card,'Purchase',if equipped then 'EQUIPPED' elseif owned then 'EQUIP' else 'BUY',UDim2.new(1,-22,0,37),UDim2.fromOffset(11,191),if equipped then T.Aqua elseif owned then T.Teal else T.Gold,function() if not equipped then self.callbacks.action(if owned then 'EquipStraw' else 'BuyStraw',item.id) end end)
   button.Active=not equipped;button.Selectable=not equipped;button.TextSize=17
  end
 elseif shop=='Upgrades' then
  local profile={Upgrades=s.upgrades}
  for i,item in Config.Upgrades do
   local card=self:card(item.id,i);local level=s.upgrades[item.id];local price=Economy.upgradeCost(profile,item.id)
   C.viewport(card,'Icons',item.icon,UDim2.fromOffset(64,64),UDim2.fromOffset(5,9))
   C.label(card,item.name,UDim2.new(1,-88,0,27),UDim2.fromOffset(76,13),20,T.Ink,T.Font)
   C.label(card,'LEVEL '..level..' / '..item.max,UDim2.new(1,-88,0,22),UDim2.fromOffset(77,42),12,T.Muted,T.Bold)
   local current,nextValue
   if item.id=='Backpack' then current=s.capacity;nextValue=Config.Capacities[math.min(level+2,#Config.Capacities)]
   elseif item.id=='Walk' then current=s.stats.walk;nextValue=Config.WalkSpeeds[math.min(level+2,#Config.WalkSpeeds)]
   elseif item.id=='Power' then current=string.format('%.1fx',1+level*.2);nextValue=string.format('%.1fx',1+math.min(level+1,item.max)*.2)
   else current=string.format('%.1fx',1+level*.1);nextValue=string.format('%.1fx',1+math.min(level+1,item.max)*.1) end
   C.label(card,tostring(current)..'  →  '..tostring(nextValue),UDim2.new(1,-26,0,26),UDim2.fromOffset(13,79),22,T.DeepTeal,T.Font)
   C.label(card,item.description,UDim2.new(1,-26,0,23),UDim2.fromOffset(13,106),13,T.Muted,T.Body)
   local _,button=C.button(card,'Upgrade',if price then 'UPGRADE  ·  '..C.number(price) else 'MAX LEVEL',UDim2.new(1,-26,0,38),UDim2.fromOffset(13,135),if price then T.Coral else T.Aqua,function() if price then self.callbacks.action('Upgrade',item.id) end end);button.TextSize=16;button.Active=price~=nil;button.Selectable=price~=nil
  end
 else
  for i,item in Config.Loot do
   local count=s.bag[item.id] or 0
   if count==0 then continue end
   local card=self:card(item.id,i)
   C.viewport(card,'Loot',item.id,UDim2.fromOffset(66,70),UDim2.fromOffset(3,7))
   C.label(card,item.name,UDim2.new(1,-92,0,25),UDim2.fromOffset(76,11),17,T.Ink,T.Font)
   C.label(card,string.format('%d found  ·  %d each',count,item.value),UDim2.new(1,-92,0,22),UDim2.fromOffset(76,35),12,T.Muted,T.Body)
   C.label(card,C.number(count*item.value)..' Coins',UDim2.new(1,-92,0,24),UDim2.fromOffset(76,55),17,T.DeepTeal,T.Bold)
   if count==0 then card.BackgroundColor3=Color3.fromRGB(247,241,222) end
  end
  if s.count==0 then
   local card=self:card('EmptyBackpack',1)
   C.viewport(card,'Icons','Backpack',UDim2.fromOffset(66,70),UDim2.fromOffset(3,7))
   C.label(card,'Your next discovery awaits',UDim2.new(1,-90,0,27),UDim2.fromOffset(76,12),16,T.Ink,T.Font)
   local hint=C.label(card,'Uncover the seabed to find treasure.',UDim2.new(1,-90,0,38),UDim2.fromOffset(76,39),13,T.Muted,T.Body);hint.TextWrapped=true
  end
  self.sellTotal.Text='TOTAL  '..C.number(s.value)
  self.sellButton.Text='SELL ALL'
 end
 self:resize();self.scroll.CanvasPosition=scrollPosition
end
function UI:sale(amount)
 self:toastMessage('Treasure sold!  +'..C.number(amount)..' Coins','success')
 local target=self.coins.AbsolutePosition+Vector2.new(28,30)-self.root.AbsolutePosition
 local origin=self.root.AbsoluteSize*Vector2.new(.65,.75)
 for i=1,9 do task.delay(i*.045,function()
  local icon=C.viewport(self.root,'Icons','Coin',UDim2.fromOffset(37,37),UDim2.fromOffset(origin.X,origin.Y));icon.ZIndex=30
  local outward=origin+Vector2.new(math.cos(i*2.4)*60,math.sin(i*2.4)*45-35)
  C.tween(icon,.16,{Position=UDim2.fromOffset(outward.X,outward.Y)},Enum.EasingStyle.Back);task.wait(.17)
  C.tween(icon,.5,{Position=UDim2.fromOffset(target.X-18,target.Y-18),Size=UDim2.fromOffset(24,24)},Enum.EasingStyle.Quart,Enum.EasingDirection.In);task.wait(.5);icon:Destroy()
  self.coinScale.Scale=1.055;C.tween(self.coinScale,.16,{Scale=1})
 end) end
end
function UI:prompt(prompt,inputType)
 if self.shop then return nil end
 local gui=C.new('BillboardGui',{Name='SeaPrompt',Adornee=prompt.Parent,Size=UDim2.fromOffset(214,62),StudsOffsetWorldSpace=Vector3.new(0,2.1,0),AlwaysOnTop=true,MaxDistance=35,Active=true},Players.LocalPlayer.PlayerGui)
 local p=C.panel(gui,'Prompt',UDim2.new(1,-6,1,-6),UDim2.fromOffset(3,3),T.Cream,15)
 local key=if inputType==Enum.ProximityPromptInputType.Touch then 'TAP' elseif inputType==Enum.ProximityPromptInputType.Gamepad then 'X' else 'E'
 local button=C.new('TextButton',{Name='Interact',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text='',AutoButtonColor=false},p)
 local k=C.panel(button,'Key',UDim2.fromOffset(42,40),UDim2.fromOffset(8,8),T.Teal,10);local label=C.label(k,key,UDim2.fromScale(1,1),nil,17,T.Ink,T.Font);label.TextXAlignment=Enum.TextXAlignment.Center
 C.label(button,prompt.ObjectText,UDim2.new(1,-63,0,24),UDim2.fromOffset(59,6),17,T.Ink,T.Font)
 C.label(button,prompt.ActionText,UDim2.new(1,-63,0,20),UDim2.fromOffset(59,30),12,T.Muted,T.Body)
 button.Activated:Connect(function() if prompt.Parent then prompt:InputHoldBegin();task.delay(prompt.HoldDuration+.05,function() if prompt.Parent then prompt:InputHoldEnd() end end) end end)
 local scale=C.new('UIScale',{Scale=.8},p);C.tween(scale,.25,{Scale=1},Enum.EasingStyle.Back)
 return gui
end
return UI
]]></ProtectedString>
						<string name="ScriptGuid">{B7F428CF-4DDA-4A6E-A2C1-D7D68EDB5DAB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">UI</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000013e3</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXA699FA4065354DD6ADD84021696E400A">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
local RunService=game:GetService('RunService')
local Players=game:GetService('Players')
local TweenService=game:GetService('TweenService')
local Debris=game:GetService('Debris')
local Config=require(game:GetService('ReplicatedStorage').SeaGame.Shared.Config)
local C=require(script.Parent.Components)
local ChestPresentation={};ChestPresentation.__index=ChestPresentation
local DURATION=1.65
function ChestPresentation.new(folder,sound)
 local self=setmetatable({folder=folder,sound=sound,records={},connections={}},ChestPresentation)
 local points=workspace.UnderwaterTerrain:FindFirstChild('PointsOfInterest')
 if points then for _,model in points:GetDescendants() do if model:IsA('Model') and model:GetAttribute('ExpeditionChest') then
  local lid=model:FindFirstChild('Lid');local base=model:FindFirstChild('Base');local root=model:FindFirstChild('ChestRoot')
  if not lid or not base or not root then continue end
  local record={model=model,lid=lid,base=base,root=root,hinge=model:GetAttribute('LidHinge'),closed=model:GetAttribute('LidClosedCFrame') or lid.CFrame,baseCF=base.CFrame,rare=(model:GetAttribute('MinimumValue') or 0)>=1000}
  self.records[model.Name]=record
  local function start()
   local at=model:GetAttribute('OpenedAt');if type(at)~='number' or at<=0 or record.at==at then return end
   record.at=at;record.active=true;record.burst=false
  end
  table.insert(self.connections,model:GetAttributeChangedSignal('OpenedAt'):Connect(start));start()
 end end end
 table.insert(self.connections,RunService.RenderStepped:Connect(function() self:step() end))
 return self
end
function ChestPresentation:burst(record)
 local pos=record.root.Position+Vector3.new(0,1.2,0)
 local pivot=Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')
 if not pivot or (pivot.Position-pos).Magnitude>140 then return end
 local color=if record.rare then Color3.fromRGB(116,235,223) else Color3.fromRGB(255,204,103)
 local anchor=C.new('Part',{Name='ChestRewardLight',Size=Vector3.one*.1,Position=pos,Transparency=1,Anchored=true,CanCollide=false,CanQuery=false,CanTouch=false,CastShadow=false},self.folder)
 local light=C.new('PointLight',{Color=color,Brightness=0,Range=if record.rare then 12 else 8,Shadows=false},anchor)
 C.tween(light,.16,{Brightness=if record.rare then 2.2 else 1.4})
 task.delay(.28,function() if light.Parent then C.tween(light,1,{Brightness=0}) end end)
 local spark=C.new('ParticleEmitter',{Name='RewardStarburst',Texture='rbxasset://textures/particles/sparkles_main.dds',Color=ColorSequence.new(color,Color3.fromRGB(255,244,218)),Rate=0,Lifetime=NumberRange.new(.75,1.4),Speed=NumberRange.new(2.5,5.5),SpreadAngle=Vector2.new(75,75),Acceleration=Vector3.new(0,-3,0),Drag=2,LightEmission=.8,Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.15,.23),NumberSequenceKeypoint.new(.6,.13),NumberSequenceKeypoint.new(1,0)}),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.05),NumberSequenceKeypoint.new(.5,.2),NumberSequenceKeypoint.new(1,1)})},anchor)
 spark:Emit(if record.rare then 30 else 18)
 for i=1,(if record.rare then 5 else 3) do
  local a=i*math.tau/5
  local bottom=C.new('Attachment',{Position=Vector3.new(math.cos(a)*.35,0,math.sin(a)*.35)},anchor)
  local top=C.new('Attachment',{Position=Vector3.new(math.cos(a)*1.6,4.2+math.sin(i)*.5,math.sin(a)*1.6)},anchor)
  local beam=C.new('Beam',{Name='RewardRay',Attachment0=bottom,Attachment1=top,FaceCamera=true,Width0=.42,Width1=.04,Segments=6,LightEmission=.8,Color=ColorSequence.new(color),Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.65),NumberSequenceKeypoint.new(1,1)})},anchor)
  C.tween(beam,1.05,{Width0=0,Width1=0})
 end
 for i,pitch in {1.05,1.32,1.65,2.05} do task.delay((i-1)*.105,function() if anchor.Parent then self.sound(Config.Audio.Collect,pitch,if record.rare then .2 else .15,anchor) end end) end
 Debris:AddItem(anchor,2.3)
end
function ChestPresentation:step()
 local now=workspace:GetServerTimeNow()
 for _,record in self.records do if record.active then
  local age=math.max(0,now-record.at);local angle=0
  if age<.2 then
   local pulse=math.sin(age/.2*math.pi);local shake=math.sin(age*85)*pulse
   record.base.CFrame=record.baseCF*CFrame.new(shake*.045,0,0)*CFrame.Angles(0,0,shake*.012)
   angle=math.rad(-3)*pulse
  else
   record.base.CFrame=record.baseCF
   local t=math.clamp((age-.2)/1.1,0,1)
   -- One continuous damped spring, with an exact resting pose.
   local spring=if t>=1 then 1 else 1-math.exp(-7*t)*(math.cos(8.8*t)+.79545*math.sin(8.8*t))
   angle=math.rad(-106)*spring
  end
  record.lid.CFrame=record.hinge*CFrame.Angles(angle,0,0)*record.hinge:Inverse()*record.closed
  if age>=.52 and not record.burst then record.burst=true;if age<1.2 then self:burst(record) end end
  if age>=DURATION then record.base.CFrame=record.baseCF;record.active=false end
 end end
end
function ChestPresentation:destroy()
 for _,connection in self.connections do connection:Disconnect() end
 for _,record in self.records do if record.base.Parent then record.base.CFrame=record.baseCF end end
end
return ChestPresentation
]]></ProtectedString>
						<string name="ScriptGuid">{FA05C785-B6C1-43E4-9E13-76B5756FA64E}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ChestPresentation</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000057aa</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX088D4067AE7D41359D3B5CF8D184F9A1">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Cosmetic only: follows the confirmed server WaterLevel, never writes ocean progress.
local RunService=game:GetService('RunService')
local TweenService=game:GetService('TweenService')
local Players=game:GetService('Players')
local Contours=require(script.Parent.ShoreContours)
local WorldPolish={};WorldPolish.__index=WorldPolish
local function smooth(t) t=math.clamp(t,0,1);return t*t*(3-2*t) end
function WorldPolish.new()
 local self=setmetatable({connections={},wetProps={},lastLevel=math.huge,pending=nil,busy=false,disposed=false},WorldPolish)
 self.ocean=workspace:WaitForChild('Ocean');self.ribbon=self.ocean:FindFirstChild('WetShore',true)
 self.params=RaycastParams.new();self.params.FilterType=Enum.RaycastFilterType.Include
 self.params.FilterDescendantsInstances={workspace.StarterIsland.GoldenShore,workspace.UnderwaterTerrain.Seafloor}
 self.params.IgnoreWater=true;self.params.RespectCanCollide=true
 self.bones={}
 if self.ribbon then
  for _,bone in self.ribbon:GetDescendants() do if bone:IsA('Bone') and bone.Name~='Root' then
   local edge,index=bone.Name:match('^(%a+)_(%d+)$')
   if edge then
    local p=bone.WorldPosition;table.insert(self.bones,{bone=bone,edge=edge,index=tonumber(index),angle=math.atan2(p.Z,p.X),rest=bone.WorldCFrame})
   end
  end end
  table.sort(self.bones,function(a,b) if a.index==b.index then return a.edge<b.edge end;return a.index<b.index end)
 end
 for _,root in {workspace.Decorations,workspace.UnderwaterTerrain} do
  for _,p in root:GetDescendants() do if p:IsA('MeshPart') and p:GetAttribute('Wettable') then
   local appearance=p:FindFirstChildOfClass('SurfaceAppearance')
   table.insert(self.wetProps,{part=p,appearance=appearance,color=if appearance then appearance.Color else p.Color,y=p:GetAttribute('ShoreBaseY') or p.Position.Y,reflectance=p.Reflectance})
  end end
 end
 local function changed()
  local level=self.ocean:GetAttribute('WaterLevel') or 0
  if math.abs(level-self.lastLevel)<.025 then return end
  self.pending=level
  if not self.busy then task.spawn(function() self:drainQueue() end) end
 end
 table.insert(self.connections,self.ocean:GetAttributeChangedSignal('WaterLevel'):Connect(changed));changed()
 return self
end
function WorldPolish:height(radius,angle)
 local x,z=math.cos(angle)*radius,math.sin(angle)*radius
 local hit=workspace:Raycast(Vector3.new(x,12,z),Vector3.new(0,-105,0),self.params)
 return if hit then hit.Position.Y else -84
end
function WorldPolish:contour(entry,level)
 -- Collision decomposition can sit above the visible seabed. These radii were
 -- baked against Blender's rendered triangles, so wet sand follows the art.
 local sample=math.clamp(-level/Contours.step,0,Contours.levels-1)
 local row=math.floor(sample)+1;local nextRow=math.min(row+1,Contours.levels)
 local column=entry.index*2+(if entry.edge=='Inner' then 1 else 2)
 local a=Contours.radius(row,column);local b=Contours.radius(nextRow,column)
 local radius=a+(b-a)*(sample-math.floor(sample))
 local height=level+(if entry.edge=='Inner' then 1.1 else .10)+.075
 return Vector3.new(math.cos(entry.angle)*radius,height,math.sin(entry.angle)*radius)
end
function WorldPolish:drainQueue()
 if self.busy then return end;self.busy=true
 while self.pending and not self.disposed do
  local level=self.pending;self.pending=nil;local immediate=self.lastLevel==math.huge
  local started=os.clock()
  for i,entry in self.bones do
   if self.disposed then break end
   local target=self:contour(entry,level)
   local transform=CFrame.new(entry.rest:VectorToObjectSpace(target-entry.rest.Position))
   if immediate then entry.bone.Transform=transform else TweenService:Create(entry.bone,TweenInfo.new(.65,Enum.EasingStyle.Sine),{Transform=transform}):Play() end
   if i%16==0 then RunService.Heartbeat:Wait() end
  end
  for i,entry in self.wetProps do
   if entry.part.Parent then
    local wet=1-smooth((entry.y-level)/1.7)
    local c=entry.color;local tint=c:Lerp(Color3.new(c.R*.78,c.G*.86,c.B*.88),wet*.65)
    local target=entry.appearance or entry.part
    if immediate then target.Color=tint else TweenService:Create(target,TweenInfo.new(1.2),{Color=tint}):Play() end
    entry.part.Reflectance=entry.reflectance+wet*.035
   end
   if i%32==0 then RunService.Heartbeat:Wait() end
  end
  self.lastLevel=level
  if self.ribbon then self.ribbon:SetAttribute('VisualWaterLevel',level);self.ribbon:SetAttribute('ContourUpdateSeconds',os.clock()-started);self.ribbon:SetAttribute('ShoreBoneCount',#self.bones) end
 end
 self.busy=false
end
function WorldPolish:destroy()
 self.disposed=true;for _,c in self.connections do c:Disconnect() end
end
return WorldPolish
]]></ProtectedString>
						<string name="ScriptGuid">{56A7C46A-76A6-4C97-A526-4B07A2E589A9}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">WorldPolish</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">3d3c26ac6398c3a40b0c6676000057ac</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX915A8205CDB04239862C46F4438742E1">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Blender triangle contours: quantized to .01 stud, sampled every .25 stud of water.
-- Packed below Roblox's 200,000-character Source limit. Decoded once per client.
local encoded=[==[]==]
local alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local values={};for i=1,#alphabet do values[string.byte(alphabet,i)]=i-1 end
local data=buffer.create(131040);local offset=0
for i=1,#encoded,4 do
 local a,b,c,d=string.byte(encoded,i,i+3)
 local n=values[a]*262144+values[b]*4096+values[c]*64+values[d]
 buffer.writeu8(data,offset,math.floor(n/65536));buffer.writeu8(data,offset+1,math.floor(n/256)%256);buffer.writeu8(data,offset+2,n%256);offset+=3
end
local contours={step=.25,count=120,levels=273}
function contours.radius(row,column) return buffer.readu16(data,((row-1)*240+column-1)*2)/100 end
return contours
]]></ProtectedString>
						<string name="ScriptGuid">{344D9D0D-0FE5-443C-82BD-23C68148AE80}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">ShoreContours</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6c8c85f6c6abeb080b0ccb2b00000ea9</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX867BAB52782E4670B4EC2B1DFBCCDC94">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!nonstrict
local RunService=game:GetService('RunService');local GuiService=game:GetService('GuiService')
local Config=require(game.ReplicatedStorage.SeaGame.Shared.Config)
local C=require(script.Parent.Components);local T=require(script.Parent.Theme)
local ComfortUI={};ComfortUI.__index=ComfortUI
function ComfortUI.new(ui)
 local self=setmetatable({ui=ui,percent=0,using=false,phase=0},ComfortUI)
 self.bar=C.panel(ui.root,'RestroomMeter',UDim2.fromOffset(240,46),UDim2.new(.5,-120,0,92),T.Cream,13)
 local badge=C.frame(self.bar,'WC',UDim2.fromOffset(32,32),UDim2.fromOffset(7,7),T.Gold);C.corner(badge,10)
 local label=C.label(badge,'WC',UDim2.fromScale(1,1),nil,13,T.Ink,T.Bold);label.TextXAlignment=Enum.TextXAlignment.Center
 self.label=C.label(self.bar,'RESTROOM',UDim2.new(1,-105,0,19),UDim2.fromOffset(47,5),10,T.Muted,T.Bold)
 self.value=C.label(self.bar,'0%',UDim2.fromOffset(48,20),UDim2.new(1,-57,0,3),14,T.Ink,T.Bold);self.value.TextXAlignment=Enum.TextXAlignment.Right
 local track=C.frame(self.bar,'Track',UDim2.new(1,-58,0,8),UDim2.fromOffset(47,29),T.Sand);C.corner(track,4)
 self.fill=C.frame(track,'Fill',UDim2.fromScale(0,1),nil,T.Gold);C.corner(self.fill,4)
 self.number=C.new('NumberValue',{Value=0},self.bar);self.number.Changed:Connect(function(value) self.value.Text=string.format('%.0f%%',value);self.fill.Size=UDim2.fromScale(value/100,1) end)
 local hint=C.new('TextButton',{Name='Help',Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text='',AutoButtonColor=false},self.bar)
 hint.Activated:Connect(function() ui:toastMessage('Fills from your own 5% of the ocean. Visit WC to empty it.','info') end)
 self.offer,self.button,self.scale=C.button(ui.root,'PrismOffer','',UDim2.fromOffset(80,90),UDim2.new(1,-94,0,92),Color3.fromRGB(240,220,255),function() if not self.using then ui:open('Premium') end end)
 self.art=C.viewport(self.button,'Tools','PrismStraw',UDim2.new(1,0,1,-20),UDim2.fromOffset(0,-2));self.art.Rotation=-15
 local price=C.label(self.button,'79 R$',UDim2.new(1,0,0,22),UDim2.new(0,0,1,-24),13,T.Ink,T.Bold);price.TextXAlignment=Enum.TextXAlignment.Center
 self.rim=self.button:FindFirstChildOfClass('UIStroke');self.rim.Thickness=2.5
 self.button.MouseEnter:Connect(function() C.tween(self.art,.25,{Rotation=0},Enum.EasingStyle.Back) end)
 self.button.MouseLeave:Connect(function() C.tween(self.art,.25,{Rotation=-15}) end)
 self.button.SelectionGained:Connect(function() C.tween(self.scale,.2,{Scale=1.06});C.tween(self.art,.25,{Rotation=0}) end)
 self.button.SelectionLost:Connect(function() C.tween(self.scale,.2,{Scale=1});C.tween(self.art,.25,{Rotation=-15}) end)
 local clock=0
 self.connection=RunService.Heartbeat:Connect(function(dt)
  clock+=dt;if clock<.06 then return end;self.phase+=clock;clock=0
  if not ui.gui.Parent then self.connection:Disconnect();return end
  local reduced=false;pcall(function() reduced=GuiService.ReducedMotionEnabled end)
  local hue=if reduced then .76 else (self.phase/9)%1
  self.button.BackgroundColor3=Color3.fromHSV(hue,.22,1);self.rim.Color=Color3.fromHSV((hue+.1)%1,.62,.82)
  if self.premiumArt and self.premiumArt.Parent and ui.shop=='Premium' then
   local world=self.premiumArt:FindFirstChildOfClass('WorldModel');local model=world and world:FindFirstChildOfClass('Model')
   if model then model:PivotTo(CFrame.Angles(0,if reduced then 0 else math.sin(self.phase*.75)*.14,0)) end
  end
 end)
 return self
end
function ComfortUI:update(payload)
 self.percent=math.clamp(payload.percent or 0,0,100);self.using=payload.using==true
 self.bar:SetAttribute('ServerPercent',self.percent);self.bar:SetAttribute('UsingRestroom',self.using)
 if self.tween then self.tween:Cancel() end
 self.tween=C.tween(self.number,if self.using then Config.Restroom.UseSeconds elseif self.percent==0 then .8 else .45,{Value=if self.using then 0 else self.percent},if self.using then Enum.EasingStyle.Sine else Enum.EasingStyle.Quart)
 self.label.Text=if self.using then 'TAKING A BREAK' elseif self.percent>=100 then 'VISIT THE WC' else 'RESTROOM'
 self.bar.BackgroundColor3=if self.percent>=100 then T.PaleGold else T.Cream
end
function ComfortUI:resize(v)
 local compact=v.X<650;local width=if compact then math.min(260,v.X-126) else 240
 self.bar.Size=UDim2.fromOffset(width,46);self.bar.Position=if compact then UDim2.fromOffset(12,166) else UDim2.new(.5,-120,0,92)
 local landscape=v.Y<450 and not compact
 self.offer.Size=UDim2.fromOffset(if landscape then 64 else 80,if landscape then 74 else 90)
 self.offer.Position=UDim2.new(1,if landscape then -184 else -94,0,if compact then 166 else 92)
 if self.ui.shop=='Premium' then
  local w=self.ui.window.Size.X.Offset;local h=self.ui.window.Size.Y.Offset
  self.ui.grid.CellSize=UDim2.fromOffset(w-48,h-130)
  if self.premiumArt then
   local tight=w<530;self.premiumArt.Size=UDim2.new(if tight then .35 else .42,0,1,-105)
   self.premiumArt.Position=UDim2.fromOffset(2,3)
   self.info.Position=UDim2.new(if tight then .37 else .45,0,0,14);self.info.Size=UDim2.new(if tight then .61 else .52,-6,1,-115)
   self.premiumTitle.TextSize=if tight then 20 else 27
   local short=h<450;self.details.Visible=not short
   self.note.Visible=not short
   self.ui.headerSubtitle.Text=if short then 'Tier 6 performance · 79 Robux' else 'Prism collection · Special straw'
   self.buyHolder.Position=if short then UDim2.new(.33,0,1,-68) else UDim2.new(0,16,1,-73)
   self.buyHolder.Size=if short then UDim2.new(.65,-6,0,44) else UDim2.new(1,-32,0,45)
   if short then self.info.Position=UDim2.new(.33,0,0,8);self.info.Size=UDim2.new(.65,-6,0,100);self.premiumArt.Size=UDim2.new(.3,0,1,-12);self.premiumTitle.TextSize=20 end
   for i,line in self.statFrames do
    line.Position=if short then UDim2.new((i-1)%2*.5,0,0,34+math.floor((i-1)/2)*27) else UDim2.fromOffset(0,83+(i-1)*34)
    line.Size=if short then UDim2.new(.5,-6,0,24) else UDim2.new(1,0,0,29)
   end
  end
 end
end
function ComfortUI:renderShop()
 local ui=self.ui;local offer=Config.PremiumStraw
 local card=ui:card('PrismShowcase',1)
 self.premiumArt=C.viewport(card,'Tools',offer.id,UDim2.new(.42,0,1,-105),UDim2.fromOffset(2,3))
 self.info=C.frame(card,'Specifications',UDim2.new(.52,-6,1,-115),UDim2.new(.45,0,0,14));self.info.BackgroundTransparency=1
 self.premiumTitle=C.label(self.info,'PRISM STRAW',UDim2.new(1,0,0,34),nil,27,T.Ink,T.Font)
 self.details=C.label(self.info,'A little rainbow.\nA whole lot of ocean.',UDim2.new(1,0,0,42),UDim2.fromOffset(0,37),14,T.Muted,T.Body);self.details.TextWrapped=true
 local stats={{'SUCTION',string.format('%gx',offer.power)},{'SPEED',string.format('%gx',offer.speed)},{'REACH',offer.reach..' studs'},{'FLOW',C.number(offer.power*offer.speed*Config.Ocean.BaseRemovalRate)..' / sec'}}
 self.statFrames={}
 for i,row in stats do
  local pos=UDim2.fromOffset(0,83+(i-1)*34)
  local line=C.frame(self.info,'Stat_'..i,UDim2.new(1,0,0,29),pos,if i%2==1 then T.Aqua else T.Cream);C.corner(line,7)
  table.insert(self.statFrames,line)
  C.label(line,row[1],UDim2.new(.48,-5,1,0),UDim2.fromOffset(6,0),10,T.Muted,T.Bold)
  local val=C.label(line,row[2],UDim2.new(.55,-12,1,0),UDim2.new(.45,0,0,0),13,T.Ink,T.Bold);val.TextXAlignment=Enum.TextXAlignment.Right
 end
 local note=C.label(card,'Same performance as tier 6 · Ocean Vacuum',UDim2.new(1,-24,0,24),UDim2.new(0,12,1,-105),12,T.Muted,T.Body);note.TextXAlignment=Enum.TextXAlignment.Center;note.TextWrapped=true;self.note=note
 local holder,buy=C.button(card,'BuyPrism','BUY  ·  79 ROBUX',UDim2.new(1,-32,0,45),UDim2.new(0,16,1,-73),T.Gold,function() ui:toastMessage('Prism is a preview. Robux purchases are not enabled yet.','info') end);buy.TextSize=17;self.buyHolder=holder
 local preview=C.label(card,'PREVIEW · AVAILABLE SOON',UDim2.new(1,-24,0,18),UDim2.new(0,12,1,-20),10,T.Muted,T.Bold);preview.TextXAlignment=Enum.TextXAlignment.Center
end
return ComfortUI
]]></ProtectedString>
