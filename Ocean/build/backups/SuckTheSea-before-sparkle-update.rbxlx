				<Item class="ModuleScript" referent="RBX94BE09607F4A4CBE9FDC2C762C57DEA9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Original Blender collectibles, grouped by the depth at which they are discovered.
return {
 {id="StarterMussel",name="Little Mussel",weight=0,value=1,minDepth=0,rarity="COMMON",color=Color3.fromRGB(119,111,163)},
 {id="CommonShell",name="Common Shell",weight=28,value=10,minDepth=0,rarity="COMMON",color=Color3.fromRGB(255,176,173)},
 {id="Starfish",name="Starfish",weight=19,value=20,minDepth=0,rarity="COMMON",color=Color3.fromRGB(255,176,173)},
 {id="PearlShell",name="Pearl Shell",weight=8,value=50,minDepth=3,rarity="COMMON",color=Color3.fromRGB(255,176,173)},
 {id="OldBottle",name="Old Bottle",weight=5,value=100,minDepth=6,rarity="UNCOMMON",color=Color3.fromRGB(124,231,220)},
 {id="TreasureChest",name="Treasure Chest",weight=3,value=250,minDepth=18,rarity="UNCOMMON",color=Color3.fromRGB(124,231,220)},
 {id="AncientRelic",name="Ancient Relic",weight=1,value=600,minDepth=35,rarity="RARE",color=Color3.fromRGB(255,200,87)},
 {id="SunriseScallop",name="Sunrise Scallop",weight=18,value=18,minDepth=0,rarity="COMMON",color=Color3.fromRGB(255,176,173)},
 {id="SpiralShell",name="Spiral Shell",weight=14,value=32,minDepth=2,rarity="COMMON",color=Color3.fromRGB(255,176,173)},
 {id="CowrieShell",name="Tiger Cowrie",weight=12,value=38,minDepth=3,rarity="COMMON",color=Color3.fromRGB(255,176,173)},
