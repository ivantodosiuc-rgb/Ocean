return table.freeze({
 Ink=Color3.fromRGB(24,62,72),Muted=Color3.fromRGB(91,119,121),Cream=Color3.fromRGB(255,248,228),
 Paper=Color3.fromRGB(255,253,244),Sand=Color3.fromRGB(239,226,194),Teal=Color3.fromRGB(38,190,171),
 DeepTeal=Color3.fromRGB(18,135,130),Aqua=Color3.fromRGB(178,236,224),Coral=Color3.fromRGB(250,133,110),
 Gold=Color3.fromRGB(255,202,83),PaleGold=Color3.fromRGB(255,234,163),White=Color3.fromRGB(255,255,255),
 Font=Enum.Font.FredokaOne,Body=Enum.Font.GothamMedium,Bold=Enum.Font.GothamBold,
})
